{"manifest":{"schema":1,"id":"com.idj.ext.km2","name":"新快猫","version":"1.0.0","author":{"name":"py 蜘蛛改写"},"description":"新快猫（快猫 App 接口站）。3 个分类（热门/发现/精选，与原内置蜘蛛导航一致），接口为 AES 加密加 MD5 签名协议，播放为 AES-128 加密 HLS。由内置 jar 蜘蛛 ZakaKm2Amns 改写。","type":"video","adult":true,"language":["zh"],"minAppVersion":"1.5","entry":"main.js","permissions":{"http":["app.newkm-azuercdn.com","xkm.m3.arvfiss.top","xkmcoverimgs.nc93xaz.xyz","ad.xmmnsd.com","xkmts.djycmc.com","osnlpls.nkmwrw.xyz"],"media":["xkm.m3.arvfiss.top","xkmts.djycmc.com","xkmcoverimgs.nc93xaz.xyz","ad.xmmnsd.com","osnlpls.nkmwrw.xyz"],"cloudflare":false,"storage":false,"login":false},"capabilities":["home","category","search","detail","play"],"settings":[],"update":{"url":"https://raw.githubusercontent.com/hoyittvggfh45/moytv/plugins/km2/km2.idjplugin"},"integrity":"sha256-VNXSzEel/PS4tm0Reyj9eSQKaZNzfq6tGh1pUTaYx9E="},"files":{"main.js":"// XinKuaimao (km2) - idj1 plugin, rewritten from the builtin jar spider\n// ZakaKm2Amns. App API at app.newkm-azuercdn.com:8099 (the jar resolves the\n// domain to IPs via HTTPDNS and posts to IP literals; the plugin uses the\n// domain form directly, which serves the same API and passes host checks).\n// Requests: POST form whose data field is AES-128-CBC hex of a JSON object\n// carrying an MD5 signature; responses are plain JSON or the same AES hex.\n\nconst BASE = \"http://app.newkm-azuercdn.com:8099\";\nconst UA = \"okhttp/4.9.0\";\nconst TIMEOUT = 55000;\nconst AES_KEY = \"x;j/6olSp})&{ZJD\";\nconst AES_IV = \"znbV%$JN5olCpt<c\";\nconst SALT = 'ohI}-bFpD*z8)W7~REusVa]U`YKQ=[C1&XZ.\"n5:dl<{?@J6NkO+f%c^\"$tevxB>j2M_9;G#y3Tw|gL/HS,Pqr0!Ami(49Y_.~Tan#z{5ZLO,_E(7!vJ^HC5_{Xq5$z*';\n\nconst CATS = [\n    {id: \"3\", name: \"热门\"},\n    {id: \"2\", name: \"发现\"},\n    {id: \"1\", name: \"精选\"},\n];\n\nfunction str(value) {\n    if (value == null) return \"\";\n    return String(value).trim();\n}\n\nfunction intValue(value, fallback) {\n    const n = parseInt(value, 10);\n    return isFinite(n) ? n : fallback;\n}\n\nfunction javaEncode(s) {\n    let out = \"\";\n    for (const ch of String(s)) {\n        if (/[A-Za-z0-9.\\-*_]/.test(ch)) out += ch;\n        else if (ch === \" \") out += \"+\";\n        else {\n            const bytes = [];\n            const code = ch.codePointAt(0);\n            if (code < 0x80) bytes.push(code);\n            else if (code < 0x800) bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));\n            else if (code < 0x10000) bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));\n            else bytes.push(0xf0 | (code >> 18), 0x80 | ((code >> 12) & 0x3f), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));\n            for (const b of bytes) out += \"%\" + b.toString(16).toUpperCase().padStart(2, \"0\");\n        }\n    }\n    return out;\n}\n\nfunction buildForm(pairs) {\n    const signParts = pairs.map((p) => p.key + \"=\" + javaEncode(p.raw));\n    const sig = host.crypto.md5(signParts.join(\"&\") + SALT, {in: \"utf8\", out: \"hex\"}).toUpperCase();\n    const inner = \"{\" + pairs.map((p) => JSON.stringify(p.key) + \":\" + p.rendered).join(\",\") +\n        (pairs.length ? \",\" : \"\") + '\"signature\":' + JSON.stringify(sig) + \"}\";\n    const encHex = host.crypto.aes({\n        op: \"encrypt\", mode: \"cbc\", key: AES_KEY, keyEncoding: \"utf8\",\n        iv: AES_IV, data: inner, in: \"utf8\", out: \"hex\",\n    }).toUpperCase();\n    return \"api_token=&data=\" + encodeURIComponent(encHex) +\n        \"&device=android&device_type=MI8&device_version=8.0.0&version_code=2\";\n}\n\nfunction decryptResponse(text) {\n    const t = String(text || \"\").trim();\n    if (!t) throw host.error(\"E_PARSE\", \"接口返回为空\");\n    if (t.charAt(0) === \"{\") return JSON.parse(t);\n    const plain = host.crypto.aes({\n        op: \"decrypt\", mode: \"cbc\", key: AES_KEY, keyEncoding: \"utf8\",\n        iv: AES_IV, data: t, in: \"hex\", out: \"utf8\",\n    });\n    return JSON.parse(plain);\n}\n\nasync function callApi(path, pairs) {\n    const body = buildForm(pairs);\n    let lastError = null;\n    for (let attempt = 0; attempt < 2; attempt++) {\n        try {\n            const resp = await host.http.post(BASE + path, body, {\n                headers: {\"User-Agent\": UA, \"Content-Type\": \"application/x-www-form-urlencoded\"},\n                timeout: TIMEOUT,\n            });\n            if (resp.status !== 200) throw new Error(\"HTTP \" + resp.status);\n            const data = decryptResponse(resp.body);\n            if (!data || data.code !== 200) {\n                throw host.error(\"E_PARSE\", \"接口返回 code \" + (data && data.code) + \" \" + str(data && data.msg));\n            }\n            return data;\n        } catch (error) {\n            if (error && error.code === \"E_PARSE\") throw error;\n            lastError = error;\n        }\n    }\n    throw host.error(\"E_NETWORK\", \"接口请求失败：\" + (lastError ? lastError.message : \"未知错误\"));\n}\n\nfunction intPair(key, value) {\n    return {key: key, raw: String(value), rendered: String(value)};\n}\n\nfunction strPair(key, value) {\n    return {key: key, raw: String(value), rendered: JSON.stringify(String(value))};\n}\n\nfunction keepItem(v) {\n    if (!v || typeof v !== \"object\") return false;\n    if (typeof v.type === \"number\" && v.type !== 1) return false;\n    if (typeof v.gold === \"number\" && v.gold > 0) return false;\n    const vip = str(v.is_vip);\n    if (vip !== \"\" && vip !== \"0\") return false;\n    return true;\n}\n\nfunction toItem(v) {\n    const id = str(v.id);\n    const title = str(v.title);\n    if (!id || !title) return null;\n    const item = {id: id, title: title, remarks: str(v.nickname), tags: []};\n    const cover = str(v.cover);\n    if (cover) item.cover = cover;\n    const praise = v.praise_num;\n    if (typeof praise === \"number\" && praise > 0) item.duration = \"点赞 \" + Math.floor(praise);\n    return item;\n}\n\nasync function listFor(type, page) {\n    const data = await callApi(\"/api/video/index\", [intPair(\"page\", page), intPair(\"type\", type)]);\n    const d = (data && data.data) || {};\n    const raw = Array.isArray(d.video_list) ? d.video_list : (Array.isArray(d.list) ? d.list : []);\n    const items = [];\n    for (const v of raw) {\n        if (!keepItem(v)) continue;\n        const item = toItem(v);\n        if (item) items.push(item);\n    }\n    return {items: items, rawCount: raw.length};\n}\n\nasync function videoInfo(videoId) {\n    const data = await callApi(\"/api/video/info\", [strPair(\"video_id\", videoId)]);\n    const d = (data && data.data) || {};\n    const info = d.video_info;\n    if (!info || typeof info !== \"object\") throw host.error(\"E_PARSE\", \"详情为空\");\n    if (typeof info.gold === \"number\" && info.gold > 0) throw host.error(\"E_PARSE\", \"该视频为付费内容，免费部分不可播\");\n    return info;\n}\n\nasync function home() {\n    const result = await listFor(3, 1);\n    return {categories: CATS.slice(), items: result.items, hasMore: result.rawCount >= 10};\n}\n\nasync function category(arg) {\n    const page = Math.max(1, intValue(arg && arg.page, 1));\n    let type = intValue(arg && arg.id, 3);\n    if (type < 1 || type > 3) type = 3;\n    const result = await listFor(type, page);\n    return {items: result.items, hasMore: result.rawCount >= 10};\n}\n\nasync function search(arg) {\n    const keyword = str(arg && arg.keyword).toLowerCase();\n    if (!keyword) return {items: [], hasMore: false};\n    const out = [];\n    const seen = {};\n    for (const type of [3, 2, 1]) {\n        for (let page = 1; page <= 5 && out.length < 20; page++) {\n            let result;\n            try {\n                result = await listFor(type, page);\n            } catch (error) {\n                break;\n            }\n            for (const item of result.items) {\n                if (out.length >= 20) break;\n                if (seen[item.id]) continue;\n                const hay = (item.title + \" \" + item.remarks).toLowerCase();\n                if (hay.indexOf(keyword) >= 0) {\n                    seen[item.id] = true;\n                    out.push(item);\n                }\n            }\n            if (result.rawCount < 10) break;\n        }\n        if (out.length >= 20) break;\n    }\n    return {items: out, hasMore: false};\n}\n\nasync function detail(arg) {\n    const raw = str(arg && arg.id);\n    const videoId = raw.indexOf(\"$\") >= 0 ? raw.slice(raw.indexOf(\"$\") + 1) : raw;\n    if (!videoId) throw host.error(\"E_PARSE\", \"无效的视频 ID\");\n    const info = await videoInfo(videoId);\n    const parts = [];\n    if (str(info.description)) parts.push(str(info.description));\n    if (str(info.nickname)) parts.push(\"作者：\" + str(info.nickname));\n    if (typeof info.play_num === \"number\" && info.play_num > 0) parts.push(\"播放：\" + Math.floor(info.play_num));\n    if (typeof info.praise_num === \"number\" && info.praise_num > 0) parts.push(\"点赞：\" + Math.floor(info.praise_num));\n    if (str(info.tag)) parts.push(\"标签：\" + str(info.tag));\n    const detailObj = {\n        id: raw,\n        title: str(info.title) || (\"视频\" + videoId),\n        desc: parts.join(\"\\n\"),\n        tags: str(info.tag) ? [str(info.tag)] : [],\n        lines: [{name: \"新快猫\", episodes: [{id: videoId, name: \"正片\"}]}],\n    };\n    if (str(info.cover)) detailObj.cover = str(info.cover);\n    return detailObj;\n}\n\nasync function resolveMaster(url) {\n    try {\n        const resp = await host.http.get(url, {headers: {\"User-Agent\": UA}, timeout: 20000});\n        if (resp.status !== 200 || !resp.body) return url;\n        const text = String(resp.body);\n        if (text.indexOf(\"#EXT-X-STREAM-INF\") < 0) return url;\n        const lines = text.split(/\\r?\\n/).map((s) => s.trim());\n        for (let i = 0; i < lines.length; i++) {\n            if (lines[i].indexOf(\"#EXT-X-STREAM-INF\") === 0) {\n                for (let j = i + 1; j < lines.length; j++) {\n                    if (lines[j] && lines[j].charAt(0) !== \"#\") {\n                        return host.url.resolve(resp.url || url, lines[j]);\n                    }\n                }\n            }\n        }\n        return url;\n    } catch (error) {\n        return url;\n    }\n}\n\nasync function play(arg) {\n    const raw = str((arg && arg.episodeId) || (arg && arg.id));\n    const videoId = raw.indexOf(\"$\") >= 0 ? raw.slice(raw.indexOf(\"$\") + 1) : raw;\n    if (!videoId) throw host.error(\"E_PARSE\", \"无效的播放 ID\");\n    const info = await videoInfo(videoId);\n    let url = str(info.m3u8_url);\n    const isHls = /\\.m3u8($|\\?)/i.test(url);\n    if (!url) url = str(info.normal_url);\n    if (!url) throw host.error(\"E_PARSE\", \"详情里没有播放地址\");\n    if (isHls) url = await resolveMaster(url);\n    return {\n        streams: [{\n            url: url,\n            format: /\\.m3u8($|\\?)/i.test(url) ? \"hls\" : \"video\",\n            headers: {\"User-Agent\": UA, \"Referer\": BASE + \"/\"},\n            name: \"新快猫\",\n        }],\n        expiresAt: Date.now() + 3600 * 1000,\n    };\n}\n\nexport default {home: home, category: category, search: search, detail: detail, play: play};\n"}}