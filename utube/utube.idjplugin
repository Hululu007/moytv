{"manifest":{"schema":1,"id":"com.idj.ext.utube","name":"Utube","version":"1.0.0","author":{"name":"py 蜘蛛改写"},"description":"Utube（bak.vkxrpigoi.cc PWA 接口站）。分类与原蜘蛛 classes 1:1 共 10 类（推荐/发现/YouTube精选/伦理道德/品牌传媒/官方原创/黑料吃瓜/直播/短视频/热门）。接口为 AES-128-CBC 加密表单加 MD5/SHA256 签名（同内置 jar 蜘蛛 ZakaUtubeAmns），付费条目按原蜘蛛规则过滤、标题旗标词过滤照搬，play 内主清单预解析到子清单。由内置 jar 蜘蛛 ZakaUtubeAmns 改写。","type":"video","adult":true,"language":["zh"],"minAppVersion":"1.5","entry":"main.js","permissions":{"http":["bak.vkxrpigoi.cc","p2.ihkzdjg.xyz"],"media":["*.qnlycc.cn","lxsimg.ystv.top","*.tjyyjk.cn"],"cloudflare":false,"storage":false,"login":false},"capabilities":["home","category","search","detail","play"],"settings":[],"update":{"url":"https://raw.githubusercontent.com/hoyittvggfh45/moytv/plugins/utube/utube.idjplugin"},"integrity":"sha256-CcrKFAn1a+aRVYmvvzpaYDYiBApmKhClC62tA8jlBDQ="},"files":{"main.js":"// Utube - idj1 plugin, rewritten from the built-in jar spider\n// com.github.catvod.spider.ZakaUtubeAmns (registry key ZakaUtube,\n// display name 🔞Utube, ext empty). The site is a PWA app API at\n// https://bak.vkxrpigoi.cc: every call is a POST form whose data field\n// is the base64 of AES-128-CBC/PKCS7 of a JSON envelope (random oauth_id\n// from the spider's pool, bundleId com.pwa.wyll), signed with\n// md5(sha256(\"client=pwa&data=<b64>&timestamp=<sec>\" + SECRET));\n// responses carry the same AES envelope in their data field. All\n// protocol details, the category table (10 entries, the spider's own\n// classes), the paid-item rule (is_pay==1, or coins>0 with isfree==2:\n// dropped from lists unless a page would be empty, and never playable),\n// the per-title flag-word filter and the play-url fallback chain\n// (m3u8 -> mv.m3u8 -> mv_m3u8 -> video_sources -> source_720/480/240 ->\n// preview_url -> preview_sources, with hf-<x>. rewritten to hf-long.)\n// are copied 1:1 from the spider. Covers hosted on drleao.cn are routed\n// through the spider's image worker, as in the original.\n\nconst BASE = \"https://bak.vkxrpigoi.cc\";\nconst IMG_WORKER = \"https://lxsimg.ystv.top\";\nconst ORIGIN = \"https://p2.ihkzdjg.xyz\";\nconst SECRET = \"cb7c22174dc30d664784e6d322fd664d\";\nconst UA = \"Mozilla/5.0 (Linux; Android 13; SM-A205GN) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Mobile Safari/537.36\";\nconst TIMEOUT = 60000;\nconst ATTEMPTS = 3;\nconst AES_KEY = \"b26243c9efcd5514\";\nconst AES_IV = \"66fe2be26e8b65b9\";\nconst FLAG_WORDS = [\"loli\", \"lolita\", \"幼女\", \"幼齿\", \"初中生\", \"小学生\", \"未成年\", \"未满\", \"萝莉\", \"童颜\", \"幼态\", \"处女\", \"小萝莉\"];\nconst OAUTH_POOL = [\"86e4fe877f2341155fdd5de6388c38b1\", \"06ad03456940117f22575181682e0936\", \"e5d0e0510d1f8a6f409870f7ab2b1fa7\", \"5e114a9be00839cdcd9d082bb31ae5f7\", \"4801676163e6a4d3739d956dfcc11119\", \"8952cc0d6e239dac4f04879420f12f39\", \"22ed40c3ea737788b7b505704021c0a1\", \"14831ee00e290183e724664375d92d50\", \"9dc7f5360a5d59aef3b961522c51a5b5\", \"21d80c585c5caaf4ff29cd2cc1ef2c3b\", \"9405a0e887560552a91b9599bfeb44f7\", \"53fbc5be0ee27d28d0901ea97a7c2055\"];\n\nconst CATS = [\n    [\"rec\", \"推荐\"],\n    [\"discover2\", \"发现\"],\n    [\"construct:1\", \"YouTube精选\"],\n    [\"construct:73\", \"伦理道德\"],\n    [\"construct:2\", \"品牌传媒\"],\n    [\"construct:238\", \"官方原创\"],\n    [\"melon\", \"黑料吃瓜\"],\n    [\"live\", \"直播\"],\n    [\"vlog\", \"短视频\"],\n    [\"popular\", \"热门\"],\n];\nconst CAT_IDS = {};\nfor (const pair of CATS) CAT_IDS[pair[0]] = true;\n\nconst cache = {};\n\nfunction str(v) { return v == null ? \"\" : String(v); }\nfunction intVal(v, fb) { const n = parseInt(v, 10); return isFinite(n) ? n : fb; }\n\nfunction isFlagged(s) {\n    if (!s) return false;\n    const lower = String(s).toLowerCase();\n    for (const w of FLAG_WORDS) {\n        if (lower.indexOf(w.toLowerCase()) >= 0) return true;\n    }\n    return false;\n}\n\nfunction isPaid(o) {\n    if (!o) return false;\n    if (intVal(o.is_pay, 0) === 1) return true;\n    return (parseInt(o.coins, 10) || 0) > 0 && intVal(o.isfree, 0) === 2;\n}\n\nfunction img(u) {\n    const s = str(u);\n    if (!s) return \"\";\n    if (s.indexOf(\"drleao.cn\") < 0) return s;\n    return IMG_WORKER + \"/img?u=\" + encodeURIComponent(s);\n}\n\nfunction coverOf(o) {\n    return img(str(o.cover_horizontal) || str(o.cover_vertical) || str(o.cover));\n}\n\nfunction titleOf(o) {\n    return str(o.title) || str(o.username) || str(o.name);\n}\n\nasync function callApi(path, params) {\n    const envelope = {\n        oauth_id: OAUTH_POOL[Math.floor(Math.random() * OAUTH_POOL.length)],\n        bundleId: \"com.pwa.wyll\",\n        version: \"1.6.0\",\n        oauth_type: \"web\",\n        language: \"zh\",\n        via: \"pwa\",\n        _hash: String(Date.now()),\n    };\n    for (const k of Object.keys(params || {})) envelope[k] = params[k];\n    const b64 = host.crypto.aes({\n        op: \"encrypt\", mode: \"cbc\", key: AES_KEY, keyEncoding: \"utf8\",\n        iv: AES_IV, ivEncoding: \"utf8\", data: JSON.stringify(envelope),\n        in: \"utf8\", out: \"base64\",\n    });\n    const ts = String(Math.floor(Date.now() / 1000));\n    const sha = host.crypto.sha256(\"client=pwa&data=\" + b64 + \"&timestamp=\" + ts + SECRET, {in: \"utf8\", out: \"hex\"});\n    const sign = host.crypto.md5(sha, {in: \"utf8\", out: \"hex\"});\n    const body = \"client=pwa&timestamp=\" + ts + \"&data=\" + encodeURIComponent(b64) + \"&sign=\" + sign;\n    const headers = {\n        \"User-Agent\": UA,\n        \"Content-Type\": \"application/x-www-form-urlencoded\",\n        \"Origin\": ORIGIN,\n        \"Referer\": ORIGIN + \"/\",\n    };\n    let lastErr = null;\n    for (let i = 0; i < ATTEMPTS; i++) {\n        try {\n            const resp = await host.http.post(BASE + path, body, {headers: headers, timeout: TIMEOUT});\n            if (!resp || resp.status !== 200) throw new Error(\"utube http \" + (resp && resp.status));\n            const outer = JSON.parse(String(resp.body || \"\"));\n            const dataStr = str(outer.data);\n            if (!dataStr) return outer;\n            const raw = host.crypto.aes({\n                op: \"decrypt\", mode: \"cbc\", key: AES_KEY, keyEncoding: \"utf8\",\n                iv: AES_IV, ivEncoding: \"utf8\", data: dataStr, in: \"base64\",\n                out: \"latin1\", padding: \"none\",\n            });\n            let plain = String(raw);\n            if (plain.length) {\n                const pad = plain.charCodeAt(plain.length - 1);\n                if (pad > 0 && pad <= 16) plain = plain.slice(0, plain.length - pad);\n            }\n            plain = host.codec.convert(plain, \"latin1\", \"utf8\");\n            if (plain.charAt(0) !== \"{\" && plain.charAt(0) !== \"[\") return outer;\n            try {\n                return JSON.parse(plain);\n            } catch (e) {\n                return {data: JSON.parse(plain)};\n            }\n        } catch (e) {\n            lastErr = e;\n        }\n    }\n    throw lastErr || new Error(\"utube request failed\");\n}\n\nfunction dataObj(resp) {\n    const d = resp && resp.data;\n    return d && typeof d === \"object\" && !Array.isArray(d) ? d : null;\n}\n\nfunction card(o, kind, allowPaid) {\n    if (!o) return null;\n    const id = str(o.id);\n    const title = titleOf(o);\n    if (!id || !title || isFlagged(title)) return null;\n    const paid = kind === \"video\" && isPaid(o);\n    if (paid && !allowPaid) return null;\n    let remarks = \"\";\n    const dur = intVal(o.duration, 0);\n    if (paid) remarks = \"付费\";\n    else if (dur > 0 && dur < 100000) remarks = Math.floor(dur / 60) + \":\" + (\"0\" + (dur % 60)).slice(-2);\n    cache[kind + \":\" + id] = o;\n    return {id: kind + \":\" + id, title: title, cover: coverOf(o), remarks: remarks, tags: []};\n}\n\nfunction flatten(arr, kind) {\n    const list = Array.isArray(arr) ? arr : [];\n    let out = [];\n    for (const o of list) {\n        const c = card(o, kind, false);\n        if (c) out.push(c);\n    }\n    if (!out.length) {\n        for (const o of list) {\n            const c = card(o, kind, true);\n            if (c) out.push(c);\n        }\n    }\n    return out;\n}\n\nasync function listFor(tid, page) {\n    if (tid === \"rec\") {\n        const data = dataObj(await callApi(\"/api.php/api/index/index\", {id: \"1\", page: String(page), limit: \"16\"}));\n        const out = [];\n        if (data) {\n            const groups = Array.isArray(data.list) ? data.list : [];\n            for (const g of groups) {\n                if (!g) continue;\n                out.push.apply(out, flatten(g.items, \"video\"));\n                out.push.apply(out, flatten(g.materials, \"melon\"));\n            }\n            if (!out.length) out.push.apply(out, flatten(data.list, \"video\"));\n        }\n        return out;\n    }\n    if (tid === \"discover2\") {\n        const data = dataObj(await callApi(\"/api.php/api/mv/discover2\", {sort: \"see\", page: String(page), limit: \"16\"}));\n        return data ? flatten(data.list, \"video\") : [];\n    }\n    if (tid.indexOf(\"construct:\") === 0) {\n        const data = dataObj(await callApi(\"/api.php/api/mv/list_construct\", {sort: \"see\", id: tid.slice(10), page: String(page), limit: \"16\"}));\n        return data ? flatten(data.list, \"video\") : [];\n    }\n    if (tid === \"melon\") {\n        const data = dataObj(await callApi(\"/api.php/api/material/list_sort\", {sort: \"new\", id: \"1\", page: String(page), limit: \"16\"}));\n        return data ? flatten(data.materials, \"melon\") : [];\n    }\n    if (tid === \"live\") {\n        const data = dataObj(await callApi(\"/api.php/api/live/index\", {id: \"1\", page: String(page), limit: \"16\"}));\n        return data ? flatten(data.lives, \"live\") : [];\n    }\n    if (tid === \"vlog\") {\n        const resp = await callApi(\"/api.php/api/vlog/list_sort\", {sort: \"rec\", page: String(page)});\n        const d = resp && resp.data;\n        const arr = Array.isArray(d) ? d : (d && Array.isArray(d.list) ? d.list : []);\n        return flatten(arr, \"vlog\");\n    }\n    if (tid === \"popular\") {\n        const resp = await callApi(\"/api.php/api/mv/discover\", {sort: \"popular\", page: String(page), limit: \"16\"});\n        const d = resp && resp.data;\n        const arr = Array.isArray(d) ? d : (d && Array.isArray(d.list) ? d.list : []);\n        return flatten(arr, \"video\");\n    }\n    return [];\n}\n\nasync function home() {\n    const categories = CATS.map((pair) => ({id: pair[0], name: pair[1]}));\n    let items = [];\n    try {\n        items = await listFor(\"rec\", 1);\n    } catch (e) {\n        items = [];\n    }\n    return {categories: categories, items: items, hasMore: items.length > 0};\n}\n\nasync function category(arg) {\n    const page = Math.max(1, intVal(arg && arg.page, 1));\n    const tid = str(arg && arg.id).trim();\n    if (!CAT_IDS[tid]) throw new Error(\"utube unknown category \" + tid);\n    const items = await listFor(tid, page);\n    return {items: items, hasMore: items.length > 0};\n}\n\nasync function search(arg) {\n    const keyword = str(arg && arg.keyword).trim();\n    if (!keyword) return {items: [], hasMore: false};\n    const page = Math.max(1, intVal(arg && arg.page, 1));\n    const resp = await callApi(\"/api.php/api/mv/search\", {word: keyword, type: \"1\", page: String(page), limit: \"16\"});\n    const d = resp && resp.data;\n    const arr = Array.isArray(d) ? d : (d && Array.isArray(d.list) ? d.list : []);\n    const items = flatten(arr, \"video\");\n    return {items: items, hasMore: items.length > 0};\n}\n\nfunction playUrlOf(o) {\n    if (!o) return \"\";\n    let u = str(o.m3u8);\n    if (!u && o.mv) u = str(o.mv.m3u8);\n    if (!u) u = str(o.mv_m3u8);\n    if (!u && o.video_sources) u = str(o.video_sources.url_264) || str(o.video_sources.url_265);\n    if (!u) u = str(o.source_720);\n    if (!u) u = str(o.source_480);\n    if (!u) u = str(o.source_240);\n    if (!u) u = str(o.preview_url);\n    if (!u && o.preview_sources) u = str(o.preview_sources.url_264) || str(o.preview_sources.url_265);\n    return u.replace(/hf-[^.]+\\./, \"hf-long.\");\n}\n\nfunction splitId(raw) {\n    const s = str(raw).trim();\n    const i = s.indexOf(\":\");\n    if (i > 0) return {kind: s.slice(0, i), id: s.slice(i + 1)};\n    return {kind: \"video\", id: s};\n}\n\nasync function detail(arg) {\n    const parts = splitId(arg && arg.id);\n    const kind = parts.kind;\n    const id = parts.id;\n    if (!id) throw new Error(\"invalid id\");\n    if (kind === \"live\") {\n        const data = dataObj(await callApi(\"/api.php/api/live/detail\", {id: id}));\n        const live = data ? data.live : null;\n        const title = live ? str(live.username) : \"\";\n        if (isFlagged(title)) throw new Error(\"utube flagged title\");\n        return {\n            id: \"live:\" + id,\n            title: title || (\"直播\" + id),\n            cover: live ? coverOf(live) : \"\",\n            desc: \"\",\n            tags: [],\n            lines: [{name: \"Utube\", episodes: [{id: \"live:\" + id, name: \"正片\"}]}],\n        };\n    }\n    if (kind === \"melon\") {\n        const data = dataObj(await callApi(\"/api.php/api/material/detail\", {id: id}));\n        const det = data ? data.detail : null;\n        const title = det ? str(det.title) : \"\";\n        if (isFlagged(title)) throw new Error(\"utube flagged title\");\n        let desc = det ? str(det.txt) : \"\";\n        if (!desc && det) desc = str(det.content);\n        return {\n            id: \"melon:\" + id,\n            title: title || (\"黑料\" + id),\n            cover: det ? coverOf(det) : \"\",\n            desc: desc,\n            tags: [],\n            lines: [],\n        };\n    }\n    const data = dataObj(await callApi(\"/api.php/api/mv/getDetail\", {id: id}));\n    let det = data;\n    if (data && data.detail) det = data.detail;\n    if (!det) det = {};\n    let title = str(det.title);\n    let cover = coverOf(det);\n    let desc = str(det.desc) || str(det.tags);\n    const paid = kind === \"video\" && isPaid(det);\n    const url = paid ? \"\" : playUrlOf(det);\n    if (!title || !cover) {\n        const cached = cache[kind + \":\" + id];\n        if (cached) {\n            if (!title) title = titleOf(cached);\n            if (!cover) cover = coverOf(cached);\n        }\n    }\n    if (!title) title = \"视频\" + id;\n    if (isFlagged(title)) throw new Error(\"utube flagged title\");\n    const episodes = url ? [{id: url, name: \"正片\"}] : [];\n    return {\n        id: kind + \":\" + id,\n        title: title,\n        cover: cover,\n        desc: desc,\n        tags: [],\n        lines: episodes.length ? [{name: \"Utube\", episodes: episodes}] : [],\n    };\n}\n\nasync function resolveMaster(url, headers) {\n    try {\n        const resp = await host.http.get(url, {headers: headers, timeout: 30000});\n        const text = resp && resp.body ? String(resp.body) : \"\";\n        if (!text || text.indexOf(\"#EXT-X-STREAM-INF\") < 0) return url;\n        const lines = text.split(/\\r?\\n/).map((s) => s.trim()).filter((s) => s.length > 0);\n        for (let i = 0; i < lines.length; i++) {\n            if (lines[i].indexOf(\"#EXT-X-STREAM-INF\") === 0) {\n                for (let j = i + 1; j < lines.length; j++) {\n                    if (lines[j].charAt(0) !== \"#\") {\n                        try {\n                            return new URL(lines[j], url).href;\n                        } catch (e) {\n                            return url;\n                        }\n                    }\n                }\n            }\n        }\n    } catch (e) {\n        // fall through with the original url\n    }\n    return url;\n}\n\nasync function play(arg) {\n    let raw = str((arg && arg.episodeId) || (arg && arg.id) || \"\");\n    if (raw.indexOf(\"$\") >= 0) raw = raw.split(\"$\").pop() || \"\";\n    const headers = {\"User-Agent\": UA, \"Referer\": ORIGIN + \"/\"};\n    let url = \"\";\n    if (/^https?:\\/\\//i.test(raw)) {\n        url = raw;\n    } else if (raw.indexOf(\"live:\") === 0) {\n        const data = dataObj(await callApi(\"/api.php/api/live/detail\", {id: raw.slice(5)}));\n        const live = data ? data.live : null;\n        const hls = live && Array.isArray(live.hls) ? live.hls : [];\n        if (hls.length && hls[0]) url = str(hls[0].url);\n    } else {\n        const parts = splitId(raw);\n        const data = dataObj(await callApi(\"/api.php/api/mv/getDetail\", {id: parts.id}));\n        let det = data;\n        if (data && data.detail) det = data.detail;\n        if (det && !isPaid(det) && !isFlagged(titleOf(det))) url = playUrlOf(det);\n    }\n    if (!url) throw new Error(\"utube no playable url\");\n    let finalUrl = url;\n    if (/\\.m3u8($|\\?)/i.test(url)) finalUrl = await resolveMaster(url, headers);\n    return {\n        streams: [{\n            url: finalUrl,\n            format: /\\.m3u8($|\\?)/i.test(finalUrl) ? \"hls\" : \"mp4\",\n            headers: headers,\n            name: \"Utube\",\n        }],\n        expiresAt: Date.now() + 3600 * 1000,\n    };\n}\n\nexport default {home, category, search, detail, play};\n"}}