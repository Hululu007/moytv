{"manifest":{"schema":1,"id":"com.idj.ext.hstv","name":"🔞HSTV","version":"1.0.0","author":{"name":"py 蜘蛛改写"},"description":"黄色TV（hstv.fun）。点播站：35 个分类（12 个首页板块 + 23 个标签，与原蜘蛛 1:1），接口信封 POST /js（多镜像轮换、限流跳过），响应明文或 OpenSSL AES 加密均可解，m3u8 直链播放。由内置 jar 蜘蛛 Hstv 改写。","type":"video","adult":true,"language":["zh"],"minAppVersion":"1.5","entry":"main.js","permissions":{"http":["v2.cdn199.com","v2.kekecdn.net","v2.luchu.org","v2.madou.ws","v2.papapa.biz","v2.tianmtv.com","v2.xiaoshuo.info","v2.xiaoshuo.la"],"media":["*.losers.app"],"cloudflare":false,"storage":true,"login":false},"capabilities":["home","category","search","detail","play"],"settings":[],"update":{"url":"https://raw.githubusercontent.com/hoyittvggfh45/moytv/plugins/hstv/hstv.idjplugin"},"integrity":"sha256-vW8XgKMGOAL+2Auui7+TuFD9yIy+YLq3tVsjmWYwDfo="},"files":{"main.js":"// HSTV — idj1 plugin (rewritten 1:1 from the builtin jar spider com.github.catvod.spider.Hstv)\n// Protocol (from the spider source): POST https://<api-host>/js with a JSON\n// envelope {deviceInfo, app:\"hstv.fun\", isStandalone:false, theLink:\"novaluenull\",\n// uuid, url:\"<api path>\", version:\"260901\"}. The reply is either plain JSON or\n// {\"r\": \"<base64>\"} where r is OpenSSL Salted__ AES-256-CBC (EVP_BytesToKey MD5,\n// password \"xxx\"). API hosts rotate; a host answering 403 / \"blocked\" is treated\n// as rate-limited and skipped for a while, exactly like the spider does.\n// Lists: /sevenVideos?page=N&type=<catId>; detail: /sevenVideos/<id> (m3u8s[]);\n// search: /searchSevenVideos?page=N&keywords=<enc>.\n\nconst APP = \"hstv.fun\";\nconst VERSION = \"260901\";\nconst UA = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36\";\nconst API_HOSTS = [\n  \"v2.cdn199.com\", \"v2.kekecdn.net\", \"v2.luchu.org\", \"v2.madou.ws\",\n  \"v2.papapa.biz\", \"v2.tianmtv.com\", \"v2.xiaoshuo.info\", \"v2.xiaoshuo.la\",\n];\n\n// Spider SECTIONS (12) then TAGS (23): 35 categories, ids and names verbatim.\nconst SECTIONS = [\n  [\"home_hot_8\", \"热门推荐\"], [\"home_vip_8\", \"VIP精选\"], [\"home_japan_8\", \"日系\"],\n  [\"home_west_8\", \"欧美\"], [\"home_lesbian_8\", \"百合\"], [\"home_torture_8\", \"调教\"],\n  [\"home_high_8\", \"高清\"], [\"home_pissvids_8\", \"潮吹\"], [\"home_swag_8\", \"SWAG\"],\n  [\"home_banana_8\", \"香蕉\"], [\"home_kink_8\", \"猎奇\"], [\"home_xart_8\", \"艺术\"],\n];\nconst TAGS = [\n  [\"c0\", \"最热\"], [\"c1\", \"麻豆视频\"], [\"c2\", \"91制片厂\"], [\"c3\", \"玩偶姐姐\"],\n  [\"c4\", \"小鸟酱专题\"], [\"c5\", \"糖心Vlog\"], [\"c6\", \"天美传媒\"], [\"c7\", \"蜜桃传媒\"],\n  [\"c8\", \"皇家华人\"], [\"c9\", \"星空传媒\"], [\"ca\", \"精东影业\"], [\"cb\", \"乐播传媒\"],\n  [\"cc\", \"成人头条\"], [\"cd\", \"乌鸦传媒\"], [\"ce\", \"兔子先生\"], [\"cf\", \"PsychoPorn\"],\n  [\"cg\", \"葫芦影业\"], [\"ci\", \"杏吧原创\"], [\"cj\", \"mimi传媒\"], [\"ck\", \"大象传媒\"],\n  [\"cl\", \"开心鬼传媒\"], [\"cm\", \"鲸鱼传媒\"], [\"swag\", \"台湾SWAG全集\"],\n];\nconst CATS = SECTIONS.concat(TAGS);\n\nconst deadUntil = {}; // host -> epoch ms (rate-limited hosts, spider parity)\n\nfunction str(v) { return v == null ? \"\" : String(v); }\nfunction intValue(v, fb) { const n = parseInt(v, 10); return isFinite(n) ? n : fb; }\n\nfunction getUuid() {\n  try {\n    const saved = host.storage.get(\"uuid\");\n    if (saved) return saved;\n  } catch (e) { /* storage unavailable: fall through */ }\n  const d = new Date(Date.now() + 8 * 3600 * 1000);\n  function p(n, w) { let s = String(n); while (s.length < (w || 2)) s = \"0\" + s; return s; }\n  const u = \"U\" + d.getUTCFullYear() + p(d.getUTCMonth() + 1) + p(d.getUTCDate()) +\n    p(d.getUTCHours()) + p(d.getUTCMinutes()) + p(d.getUTCSeconds()) +\n    p(Math.floor(Math.random() * 9000) + 1000, 4);\n  try { host.storage.set(\"uuid\", u); } catch (e) { /* ignore */ }\n  return u;\n}\n\n// OpenSSL EVP_BytesToKey (MD5) + AES-256-CBC decrypt of the {\"r\": ...} payload.\nfunction decryptR(r) {\n  const raw = host.codec.convert(r, \"base64\", \"latin1\");\n  if (raw.length < 32 || raw.charCodeAt(0) !== 83) {\n    throw host.error(\"E_PARSE\", \"响应无法解密\");\n  }\n  const salt = raw.substring(8, 16);\n  const cipherB64 = host.codec.convert(raw.substring(16), \"latin1\", \"base64\");\n  let prevHex = \"\";\n  let materialHex = \"\";\n  while (materialHex.length < 96) {\n    const prev = prevHex ? host.codec.convert(prevHex, \"hex\", \"latin1\") : \"\";\n    prevHex = host.crypto.md5(prev + \"xxx\" + salt, { in: \"latin1\", out: \"hex\" });\n    materialHex += prevHex;\n  }\n  return host.crypto.aes({\n    op: \"decrypt\", data: cipherB64, in: \"base64\", out: \"utf8\",\n    key: materialHex.substring(0, 64), keyEncoding: \"hex\",\n    iv: materialHex.substring(64, 96), mode: \"cbc\",\n  });\n}\n\nasync function api(path) {\n  const envelope = {\n    deviceInfo: {\n      model: \"Windows NT 10.0\", platform: \"web\", operatingSystem: \"windows\",\n      osVersion: \"Windows NT 10.0; Win64; x64\", manufacturer: \"Google Inc.\",\n      isVirtual: false, webViewVersion: \"124.0.0.0\",\n    },\n    app: APP, isStandalone: false, theLink: \"novaluenull\",\n    uuid: getUuid(), url: path, version: VERSION,\n  };\n  const body = JSON.stringify(envelope);\n  let lastErr = null;\n  let blocked = false;\n  for (let round = 0; round < 2; round++) {\n    for (const h of API_HOSTS) {\n      if ((deadUntil[h] || 0) > Date.now()) continue;\n      let resp;\n      try {\n        resp = await host.http.post(\"https://\" + h + \"/js\", body, {\n          headers: {\n            \"Content-Type\": \"application/json\",\n            \"Accept\": \"application/json, text/plain, */*\",\n            \"Origin\": \"https://\" + APP,\n            \"Referer\": \"https://\" + APP + \"/\",\n            \"User-Agent\": UA,\n          },\n          timeout: 25000,\n        });\n      } catch (e) {\n        lastErr = e;\n        continue;\n      }\n      const text = str(resp.body);\n      if (resp.status !== 200) {\n        if (resp.status === 403 || text.indexOf(\"blocked\") >= 0) {\n          blocked = true;\n          deadUntil[h] = Date.now() + 60000;\n          continue;\n        }\n        lastErr = host.error(\"E_NETWORK\", \"HTTP \" + resp.status);\n        continue;\n      }\n      delete deadUntil[h];\n      let obj;\n      try { obj = JSON.parse(text); } catch (e) {\n        throw host.error(\"E_PARSE\", \"接口返回不是 JSON\");\n      }\n      if (obj && typeof obj.r === \"string\") {\n        try { return JSON.parse(decryptR(obj.r)); } catch (e) {\n          if (e && e.code) throw e;\n          throw host.error(\"E_PARSE\", \"响应解密失败\");\n        }\n      }\n      return obj;\n    }\n  }\n  if (blocked) throw host.error(\"E_NETWORK\", \"站点限流中，请稍后再试\");\n  if (lastErr) throw lastErr;\n  throw host.error(\"E_NETWORK\", \"请求失败\");\n}\n\nfunction firstThumb(v) {\n  const t = v && v.thumbnails;\n  if (Array.isArray(t)) {\n    for (const x of t) { if (str(x)) return str(x); }\n  }\n  return \"\";\n}\n\nfunction toItem(v) {\n  const id = str(v.id) || str(v.vId);\n  if (!id) return null;\n  let remarks = str(v.durationStr);\n  if (v.vip === true) remarks = remarks ? remarks + \" · VIP\" : \"VIP\";\n  const item = { id: id, title: str(v.title), remarks: remarks };\n  const cover = firstThumb(v);\n  if (cover) item.cover = cover;\n  return item;\n}\n\nfunction toItems(list) {\n  const out = [];\n  if (Array.isArray(list)) {\n    for (const v of list) {\n      if (v && typeof v === \"object\") {\n        const it = toItem(v);\n        if (it) out.push(it);\n      }\n    }\n  }\n  return out;\n}\n\nasync function listPage(path) {\n  const data = await api(path);\n  return toItems(data);\n}\n\nexport default {\n  async init() { return {}; },\n\n  async home() {\n    const items = await listPage(\"/sevenVideos?page=1&type=home_hot_8\");\n    return {\n      categories: CATS.map(function (c) { return { id: c[0], name: c[1] }; }),\n      items: items,\n      hasMore: items.length >= 24,\n    };\n  },\n\n  async category(args) {\n    const id = str(args && args.id) || \"c0\";\n    const page = intValue(args && args.page, 1);\n    const items = await listPage(\"/sevenVideos?page=\" + page + \"&type=\" + encodeURIComponent(id));\n    return { items: items, hasMore: items.length >= 24 };\n  },\n\n  async search(args) {\n    const kw = str(args && args.keyword);\n    const page = intValue(args && args.page, 1);\n    const items = await listPage(\"/searchSevenVideos?page=\" + page + \"&keywords=\" + encodeURIComponent(kw));\n    return { items: items, hasMore: items.length >= 24 };\n  },\n\n  async detail(args) {\n    const id = str(args && args.id);\n    if (!id) throw host.error(\"E_PARSE\", \"缺少作品 id\");\n    const data = await api(\"/sevenVideos/\" + encodeURIComponent(id));\n    if (!data || typeof data !== \"object\" || Array.isArray(data)) {\n      throw host.error(\"E_PARSE\", \"详情返回异常\");\n    }\n    const lines = [];\n    const m3u8s = Array.isArray(data.m3u8s) ? data.m3u8s : [];\n    for (let i = 0; i < m3u8s.length; i++) {\n      const u = str(m3u8s[i]);\n      if (!u || u === \"null\") continue;\n      lines.push({\n        name: \"线路\" + (lines.length + 1),\n        episodes: [{ id: u, name: \"播放\" }],\n      });\n    }\n    if (!lines.length) throw host.error(\"E_PARSE\", \"详情没有播放线路\");\n    let desc = str(data.keywords_gem);\n    const user = str(data.user);\n    if (user) desc = (desc ? desc + \"\\n\" : \"\") + \"发布者：\" + user;\n    const tagsText = str(data.tags);\n    if (tagsText) desc = desc + \"\\n\" + tagsText;\n    const out = {\n      id: str(data.id) || id,\n      title: str(data.title),\n      desc: desc,\n      lines: lines,\n    };\n    const cover = firstThumb(data);\n    if (cover) out.cover = cover;\n    const kw = str(data.keywords_gem);\n    if (kw) out.tags = kw.split(/[,，]/).map(function (s) { return s.trim(); }).filter(function (s) { return !!s; });\n    return out;\n  },\n\n  async play(args) {\n    const url = str(args && (args.episodeId || args.id));\n    if (!url) throw host.error(\"E_PARSE\", \"缺少播放地址\");\n    if (!/^https:\\/\\//i.test(url)) {\n      throw host.error(\"E_PARSE\", \"播放地址不是 https\");\n    }\n    return {\n      streams: [{\n        url: url,\n        format: \"hls\",\n        name: \"HLS\",\n        headers: {\n          \"User-Agent\": UA,\n          \"Referer\": \"https://\" + APP + \"/\",\n          \"Origin\": \"https://\" + APP,\n        },\n      }],\n    };\n  },\n};\n"}}