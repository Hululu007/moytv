{"manifest":{"schema":1,"id":"com.idj.ext.hjapp","name":"海角社区┃App版","version":"1.0.0","author":{"name":"py 蜘蛛改写"},"description":"海角社区┃App版 (App/PWA 加密网关接口站)。协议由内置 jar 蜘蛛 ZakaHjAppAmns + ZakaSec 解码 1:1 还原: 网关 POST {api}/enc/{md5}, x-ph 头携带 AES-192-CBC 加密路由, body/响应同套密钥, 访客自动开号拿 JWT。分类 = 蜘蛛写死 5 个 (免费视频帖/视频帖/最新帖子/热门帖子/仅预览·视频频道) + 接口动态版块 (实测 3 个: 海角社区/有偿服务/图文福利); 列表/搜索走 /post/list, 帖子详情取 videoList 直链, 视频频道走 /video/recommendation + /video/detail/v2 的 previewVideoLink。付费帖只下发预览流, 不绕墙。纯图文帖无视频地址, 只在简介列图集。封面图床字节被站方固定异或扰码, 与原蜘蛛一样直出原址 (宿主无图片解扰能力)。由内置 jar 蜘蛛 ZakaHjAppAmns 改写。","type":"video","adult":true,"language":["zh"],"minAppVersion":"1.5","entry":"main.js","permissions":{"http":["bapi.pyvllsdyh3.com","api.ww5api.com","d1o1h2djubc0nl.cloudfront.net","img-res-19921.4cixm.com","*.newppic7.com","*.ktpkmg9.com","*.ktfile.com","*.ktppng3.com","*.newpvmd3.com"],"media":["*.newppic7.com","*.ktpkmg9.com","*.ktfile.com","*.ktppng3.com","*.newpvmd3.com","d1o1h2djubc0nl.cloudfront.net"],"cloudflare":false,"storage":true,"login":false},"capabilities":["home","category","search","detail","play"],"settings":[],"update":{"url":"https://raw.githubusercontent.com/hoyittvggfh45/moytv/plugins/hjapp/hjapp.idjplugin"},"integrity":"sha256-SD/Zx2Z8muPvQ47B44q95GVkECPtKmmStkyOkKZtACg="},"files":{"main.js":"// 海角社区 (App/PWA) — 由内置 jar 蜘蛛 ZakaHjAppAmns 1:1 改写。\n// 协议 (ZakaSec 解码还原): 加密网关 POST {api}{md5(时间戳+随机)},\n// 路由写在 x-ph 头 (AES-192-CBC, key=K_PH, iv=x-tp 时间戳微秒串, base64url),\n// body/响应 data 同套 AES-192-CBC (key=K_BODY, iv=V_BODY) base64。\n// 访客自动开号: /user/visitors/register -> /user/login/v2 拿 JWT (6 小时)。\n// 接口: 分类 /post-category/all, 列表/搜索 /post/list, 帖详情 /post/detail,\n// 视频频道 /video/recommendation, 视频详情 /video/detail/v2 (只下发 previewVideoLink)。\n// 付费帖 (chargeAmount>0) 接口只下发预览流, 不绕墙, 如实标注。\nconst API_POOL = [\"https://bapi.pyvllsdyh3.com\", \"https://api.ww5api.com\"];\nconst ORIGIN = \"https://d1o1h2djubc0nl.cloudfront.net\";\nconst LANDING = \"https://img-res-19921.4cixm.com/\";\nconst UA = \"Mozilla/5.0 (Linux; Android 12) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Mobile Safari/537.36\";\nconst K_PH = \"WhtRldf4KJHUY22hlJRUSo==\";\nconst K_BODY = \"BioItun4JIOFL78hlQECIb==\";\nconst V_BODY = \"dfg2s8g9klc3jab1\";\nconst P_ENC = \"/enc/\";\nconst P_REG = \"/user/visitors/register\";\nconst P_LOGIN = \"/user/login/v2\";\nconst P_CATS = \"/post-category/all\";\nconst P_LIST = \"/post/list\";\nconst P_DETAIL = \"/post/detail\";\nconst P_VREC = \"/video/recommendation\";\nconst P_VDET = \"/video/detail/v2\";\nconst PAGE = 20;\nconst TOKEN_TTL = 21600000;\n\nfunction xtp() {\nreturn String(Date.now() * 1000 + Math.floor(Math.random() * 1000));\n}\nfunction uuid() {\nconst h = host.crypto.randomHex(16);\nreturn h.slice(0, 8) + \"-\" + h.slice(8, 12) + \"-\" + h.slice(12, 16) + \"-\" + h.slice(16, 20) + \"-\" + h.slice(20, 32);\n}\nfunction toUrl(s) {\nreturn String(s).replace(/\\+/g, \"-\").replace(/\\//g, \"_\").replace(/=/g, \"\");\n}\nfunction encB64(key, iv, plain) {\nreturn host.crypto.aes({op: \"encrypt\", data: plain, key: key, iv: iv, out: \"base64\"});\n}\nfunction decB64(key, iv, b64) {\nreturn host.crypto.aes({op: \"decrypt\", data: b64, key: key, iv: iv, out: \"utf8\"});\n}\nfunction clean(u) {\nlet s = u == null? \"\": String(u);\ns = s.replace(/\\\\u0026/g, \"&\").replace(/\\\\u003d/g, \"=\").replace(/\\\\u003f/g, \"?\")\n.replace(/\\\\\\//g, \"/\").replace(/&amp;/g, \"&\").replace(/&quot;/g, \"\\\"\")\n.replace(/&#39;/g, \"'\").replace(/&lt;/g, \"<\").replace(/&gt;/g, \">\").replace(/&nbsp;/g, \" \");\ns = s.trim();\nreturn s.indexOf(\"//\") === 0? \"https:\" + s: s;\n}\nfunction picOf(a, b) {\nconst s = clean(a) || clean(b);\nreturn s.indexOf(\"//\") === 0? \"https:\" + s: s;\n}\nfunction getStore(k) {\ntry { return host.storage.get(k);} catch (e) { return null;}\n}\nfunction setStore(k, v) {\ntry { host.storage.set(k, v);} catch (e) {}\n}\nfunction curApi() {\nreturn getStore(\"api\") || API_POOL[0];\n}\nfunction fail(e, what) {\nif (e && e.code) throw e;\nthrow host.error(\"E_NETWORK\", what + \": \" + (e && e.message? e.message: e));\n}\n\nasync function rawCall(path, params, auth) {\nconst tp = xtp();\nconst xph = toUrl(encB64(K_PH, tp, path + \"/\" + uuid()));\nconst bodyObj = {deviceType: 2, oauthType: \"pwa\", oauthId: getStore(\"oauthId\") || \"\"};\nif (params) for (const k of Object.keys(params)) bodyObj[k] = params[k];\nconst body = encB64(K_BODY, V_BODY, JSON.stringify(bodyObj));\nconst headers = {\n\"Content-Type\": \"application/json\",\n\"x-tp\": tp,\n\"x-ph\": xph,\n\"Accept\": \"application/json, text/plain, */*\",\n\"Origin\": ORIGIN,\n\"Referer\": ORIGIN + \"/\",\n\"User-Agent\": UA,\n};\nif (auth) {\nconst t = getStore(\"token\") || \"\";\nif (t) headers[\"Authorization\"] = \"Bearer \" + t;\n}\nconst bases = [curApi()].concat(API_POOL.filter(function (a) { return a!== curApi();}));\nlet lastErr = null;\nfor (const base of bases) {\nconst url = base + P_ENC + host.crypto.md5(String(Date.now()) + Math.floor(Math.random() * 1000));\nlet resp;\ntry {\nresp = await host.http.post(url, body, {headers: headers, timeout: 30000});\n} catch (e) {\nlastErr = e;\ncontinue;\n}\nif (!resp ||!resp.body) { lastErr = new Error(\"空响应 HTTP \" + (resp && resp.status)); continue;}\nlet obj = null;\ntry { obj = JSON.parse(resp.body);} catch (e) { obj = null;}\nif (!obj) { lastErr = new Error(\"响应不是 JSON HTTP \" + resp.status); continue;}\nsetStore(\"api\", base);\nif (typeof obj.data === \"string\" && obj.data) {\ntry {\nconst dec = decB64(K_BODY, V_BODY, obj.data);\nif (dec) obj.data = JSON.parse(dec);\n} catch (e) { /* data 解不开保持原样, 上层按缺数据处理 */}\n}\nreturn obj;\n}\nthrow lastErr || new Error(\"接口无响应\");\n}\n\nasync function ensureSession() {\nconst token = getStore(\"token\") || \"\";\nconst at = parseInt(getStore(\"tokenAt\") || \"0\", 10) || 0;\nif (token.length > 20 && Date.now() - at < TOKEN_TTL) return;\nlet oauthId = getStore(\"oauthId\") || \"\";\nif (!oauthId) {\noauthId = \"p3\" + host.crypto.randomHex(8) + \"_\" + Date.now();\nsetStore(\"oauthId\", oauthId);\n}\ntry {\nawait rawCall(P_REG, {newDeviceNo: \"\", platform: \"android\", channelCode: \"\", landingPageUrl: LANDING, inviteCode: \"\"}, false);\nconst login = await rawCall(P_LOGIN, {}, false);\nconst d = login && login.data && typeof login.data === \"object\"? login.data: null;\nconst t = d && d.token? String(d.token): \"\";\nif (t.length <= 20) throw host.error(\"E_NETWORK\", \"访客登录未拿到 token\");\nsetStore(\"token\", t);\nsetStore(\"tokenAt\", String(Date.now()));\n} catch (e) {\nfail(e, \"访客开号失败\");\n}\n}\n\nasync function apiCall(path, params) {\nawait ensureSession();\nlet obj;\ntry {\nobj = await rawCall(path, params, true);\n} catch (e) {\nfail(e, \"接口请求失败 \" + path);\n}\nif (obj && obj.code === 401) {\nsetStore(\"token\", \"\");\nsetStore(\"tokenAt\", \"0\");\nawait ensureSession();\ntry {\nobj = await rawCall(path, params, true);\n} catch (e) {\nfail(e, \"接口请求失败 \" + path);\n}\n}\nreturn obj;\n}\nfunction dataArr(obj) {\nreturn obj && Array.isArray(obj.data)? obj.data: null;\n}\nfunction dataObj(obj) {\nreturn obj && obj.data && typeof obj.data === \"object\" &&!Array.isArray(obj.data)? obj.data: null;\n}\n\nfunction postCard(it, freeOnly) {\nconst id = it && it.id? Number(it.id): 0;\nif (!id) return null;\nconst charge = Number(it.chargeAmount || 0);\nconst vids = Array.isArray(it.videoList)? it.videoList: [];\nconst pics = Array.isArray(it.pictureList)? it.pictureList: [];\nif (freeOnly &&!(charge <= 0 && vids.length > 0)) return null;\nlet title = String(it.title || \"\").trim() || (\"海角社区 #\" + id);\ntitle = title.replace(/\\n/g, \" \").trim();\nlet remarks = \"\";\nif (vids.length > 0) remarks = vids.length + \" 路视频\";\nelse if (pics.length > 0) remarks = pics.length + \" 图\";\nif (charge > 0) remarks += (remarks? \" · \": \"\") + \"需 \" + charge + \" 币\";\nelse if (vids.length > 0) remarks += \" · 免费\";\nconst item = {id: \"post:\" + id, title: title, remarks: remarks};\nconst cover = pics.length > 0? clean(pics[0]): \"\";\nif (cover) item.cover = cover;\nreturn item;\n}\nfunction videoCard(it) {\nconst id = it && it.id? Number(it.id): 0;\nif (!id) return null;\nconst charge = Number(it.chargeAmount || 0);\nconst isFree = Number(it.isFree || 0);\nlet title = String(it.title || \"\").trim() || (\"海角视频 #\" + id);\ntitle = title.replace(/\\n/g, \" \").trim();\nconst dur = String(it.durationStr || \"\");\nconst remarks = (dur? dur + \" · \": \"\") + ((charge <= 0 || isFree === 1)? \"预览免费\": \"需 \" + charge + \" 币\");\nconst item = {id: \"video:\" + id, title: title, remarks: remarks};\nconst cover = picOf(it.cover, it.coverRelativePath);\nif (cover) item.cover = cover;\nreturn item;\n}\nfunction collect(arr, fn, freeOnly) {\nconst out = [];\nif (!arr) return out;\nfor (const it of arr) {\nconst c = fn(it, freeOnly);\nif (c) out.push(c);\n}\nreturn out;\n}\n\nasync function listOf(kind, page) {\nif (kind === \"rec\") {\nconst obj = await apiCall(P_VREC, {page: page, pageSize: PAGE});\nconst arr = dataArr(obj);\nif (!arr) throw host.error(\"E_NETWORK\", \"视频频道接口无数据\");\nreturn collect(arr, videoCard, false);\n}\nif (kind === \"free\") {\nconst out = [];\nconst start = (page - 1) * 3 + 1;\nfor (let i = 0; i < 3 && out.length < PAGE; i++) {\nconst obj = await apiCall(P_LIST, {page: start + i, pageSize: 30, isLatest: true});\nconst arr = dataArr(obj);\nif (!arr) throw host.error(\"E_NETWORK\", \"帖子列表接口无数据\");\nconst got = collect(arr, postCard, true);\nfor (const c of got) out.push(c);\n}\nreturn out.slice(0, PAGE);\n}\nconst params = {page: page, pageSize: PAGE};\nif (kind === \"new\") params.isLatest = true;\nelse if (kind === \"hot\") params.isHottest = true;\nelse if (kind.indexOf(\"cat:\") === 0) {\nconst cid = parseInt(kind.slice(4), 10) || 0;\nif (cid > 0) params.postCategoryId = cid;\nparams.isLatest = true;\n} else {\nparams.isVideo = true;\nparams.isLatest = true;\n}\nconst obj = await apiCall(P_LIST, params);\nconst arr = dataArr(obj);\nif (!arr) throw host.error(\"E_NETWORK\", \"帖子列表接口无数据\");\nreturn collect(arr, postCard, false);\n}\n\nconst FIXED_CATS = [\n{id: \"free\", name: \"免费视频帖\"},\n{id: \"video\", name: \"视频帖\"},\n{id: \"new\", name: \"最新帖子\"},\n{id: \"hot\", name: \"热门帖子\"},\n{id: \"rec\", name: \"仅预览·视频频道\"},\n];\n\nasync function home() {\nconst cats = FIXED_CATS.slice();\ntry {\nconst obj = await apiCall(P_CATS, {});\nconst arr = dataArr(obj);\nif (arr) {\nfor (const c of arr) {\nconst name = c && c.name? String(c.name): \"\";\nconst cid = c && c.id? Number(c.id): 0;\nif (name && cid > 0) cats.push({id: \"cat:\" + cid, name: name});\n}\n}\n} catch (e) {\nif (e && e.code === \"E_NETWORK\" && cats.length === 0) throw e;\n// 分类接口失败时与原蜘蛛一致: 只出写死分类, 列表仍走下面 (失败会抛)\n}\nconst items = await listOf(\"video\", 1);\nreturn {categories: cats, items: items, hasMore: items.length >= 19};\n}\n\nasync function category(args) {\nlet id = args && args.id? String(args.id).trim(): \"\";\nif (id.indexOf(\"folder@\") === 0) id = id.slice(7);\nif (!id) id = \"rec\";\nconst page = Math.max(1, parseInt(args && args.page, 10) || 1);\nconst items = await listOf(id, page);\nreturn {items: items, hasMore: items.length >= 19};\n}\n\nasync function search(args) {\nconst kw = args && args.keyword? String(args.keyword).trim(): \"\";\nif (!kw) return {items: [], hasMore: false};\nconst page = Math.max(1, parseInt(args && args.page, 10) || 1);\nconst obj = await apiCall(P_LIST, {page: page, pageSize: PAGE, title: kw});\nconst arr = dataArr(obj);\nif (!arr) throw host.error(\"E_NETWORK\", \"搜索接口无数据\");\nconst items = collect(arr, postCard, false);\nreturn {items: items, hasMore: items.length >= 19};\n}\n\nfunction payNote(charge) {\nreturn charge > 0? \"「付费墙」该内容是站内收费内容 (\" + charge + \" 币): 接口只下发预览流, 完整片源要站内购买, 本插件不过这道墙。\": \"「付费墙」无 · 站方未对这条收币\";\n}\n\nasync function detailVideo(numId) {\nconst obj = await apiCall(P_VDET, {id: numId});\nconst d = dataObj(obj);\nif (!d) throw host.error(\"E_PARSE\", \"视频详情接口无数据 #\" + numId);\nconst charge = Number(d.chargeAmount || 0);\nconst isFree = Number(d.isFree || 0);\nconst link = clean(d.previewVideoLink);\nconst title = String(d.title || \"\").trim() || (\"海角视频 #\" + numId);\nconst episodes = [];\nif (link) {\nepisodes.push({id: \"video:\" + numId, name: (charge <= 0 || isFree === 1)? \"完整\": \"预览\"});\n}\nconst out = {\nid: \"video:\" + numId,\ntitle: title,\ndesc: payNote(charge) + \"\\n「取到」\" + episodes.length + \" 路可播地址 (视频详情接口只下发 previewVideoLink 一路)\",\nlines: [{name: \"海角社区\", episodes: episodes}],\n};\nconst cover = picOf(d.cover, d.coverRelativePath);\nif (cover) out.cover = cover;\nif (String(d.durationStr || \"\")) out.tags = [String(d.durationStr)];\nreturn out;\n}\n\nasync function detailPost(numId) {\nconst obj = await apiCall(P_DETAIL, {id: numId});\nconst d = dataObj(obj);\nif (!d) throw host.error(\"E_PARSE\", \"帖子详情接口无数据 #\" + numId);\nconst charge = Number(d.chargeAmount || 0);\nconst title = String(d.title || \"\").trim() || (\"海角社区 #\" + numId);\nconst images = [];\nconst pushImg = function (u) {\nconst s = clean(u);\nif (s && images.indexOf(s) < 0) images.push(s);\n};\nif (Array.isArray(d.pictureList)) for (const u of d.pictureList) pushImg(u);\nlet text = String(d.content || \"\").trim();\nif (Array.isArray(d.postContents)) {\nfor (const pc of d.postContents) {\nif (!pc) continue;\nconst c = String(pc.content || \"\").trim();\nif (c) text += (text? \"\\n\\n\": \"\") + c;\nif (Array.isArray(pc.imagesList)) for (const u of pc.imagesList) pushImg(u);\n}\n}\nconst vids = Array.isArray(d.videoList)? d.videoList: [];\nconst full = [];\nconst prev = [];\nvids.forEach(function (v, i) {\nif (!v) return;\nconst vu = clean(v.videoUrl);\nconst pv = clean(v.previewPath);\nif (vu) full.push({idx: i, kind: \"v\", name: \"视频 \" + (i + 1)});\nelse if (pv) prev.push({idx: i, kind: \"p\", name: \"预览 \" + (i + 1)});\n});\nconst use = full.length > 0? full: prev;\nconst episodes = use.map(function (e) {\nreturn {id: \"post:\" + numId + \":\" + e.idx + \":\" + e.kind, name: e.name};\n});\nlet desc = payNote(charge) + \"\\n「取到」\" + episodes.length + \" 路可播地址\";\nif (text) desc += \"\\n「简介」\" + (text.length > 600? text.slice(0, 600): text);\nif (episodes.length === 0 && images.length > 0) {\ndesc += \"\\n「图集」共 \" + images.length + \" 张 (纯图文帖, 无视频地址)\\n\" + images.slice(0, 8).join(\"\\n\");\n}\nconst out = {id: \"post:\" + numId, title: title, desc: desc, lines: [{name: \"海角社区\", episodes: episodes}]};\nif (images.length > 0) out.cover = images[0];\nreturn out;\n}\n\nasync function detail(args) {\nconst raw = args && args.id? String(args.id).trim(): \"\";\nconst id = raw.indexOf(\"folder@\") === 0? raw.slice(7): raw;\nif (id.indexOf(\"video:\") === 0) return detailVideo(parseInt(id.slice(6), 10) || 0);\nif (id.indexOf(\"post:\") === 0) return detailPost(parseInt(id.slice(5), 10) || 0);\nif (/^\\d+$/.test(id)) return detailPost(parseInt(id, 10));\nthrow host.error(\"E_PARSE\", \"详情 id 无效: \" + raw);\n}\n\nfunction checkPlayable(url) {\nif (!/^https:\\/\\//i.test(url)) throw host.error(\"E_PARSE\", \"流地址不是 https: \" + url.slice(0, 80));\nconst m = /^https:\\/\\/([^/?#]+)/i.exec(url);\nconst hostPart = m? m[1]: \"\";\nif (!hostPart || hostPart.indexOf(\"@\") >= 0) throw host.error(\"E_PARSE\", \"流地址形态不合规: \" + url.slice(0, 80));\nconst hp = hostPart.split(\":\");\nif (hp.length > 1 && hp[1]!== \"443\") throw host.error(\"E_PARSE\", \"流地址端口不合规: \" + url.slice(0, 80));\nif (/^\\d+\\.\\d+\\.\\d+\\.\\d+$/.test(hp[0]) || hp[0].indexOf(\"[\") === 0) {\nthrow host.error(\"E_PARSE\", \"流地址是 IP 直链, 宿主不收: \" + url.slice(0, 80));\n}\nreturn url;\n}\n\nasync function play(args) {\nconst raw = args && (args.id || args.episodeId)? String(args.id || args.episodeId).trim(): \"\";\nconst id = raw.indexOf(\"folder@\") === 0? raw.slice(7): raw;\nlet url = \"\";\nif (id.indexOf(\"video:\") === 0) {\nconst numId = parseInt(id.slice(6), 10) || 0;\nconst obj = await apiCall(P_VDET, {id: numId});\nconst d = dataObj(obj);\nif (!d) throw host.error(\"E_PARSE\", \"视频详情接口无数据 #\" + numId);\nurl = clean(d.previewVideoLink);\nif (!url) throw host.error(\"E_PARSE\", \"视频详情未下发播放地址 #\" + numId);\n} else if (id.indexOf(\"post:\") === 0) {\nconst parts = id.split(\":\");\nconst numId = parseInt(parts[1], 10) || 0;\nconst idx = parseInt(parts[2], 10) || 0;\nconst kind = parts[3] || \"v\";\nconst obj = await apiCall(P_DETAIL, {id: numId});\nconst d = dataObj(obj);\nif (!d) throw host.error(\"E_PARSE\", \"帖子详情接口无数据 #\" + numId);\nconst vids = Array.isArray(d.videoList)? d.videoList: [];\nconst v = vids[idx];\nif (!v) throw host.error(\"E_PARSE\", \"帖子视频序号已失效 #\" + numId + \" idx \" + idx);\nurl = kind === \"p\"? clean(v.previewPath): clean(v.videoUrl);\nif (!url) throw host.error(\"E_PARSE\", \"帖子该路未下发播放地址 #\" + numId + \" idx \" + idx);\n} else if (/^https?:\\/\\//i.test(id)) {\nurl = clean(id);\n} else {\nthrow host.error(\"E_PARSE\", \"分集 id 无效: \" + raw);\n}\nif (url.indexOf(\"//\") === 0) url = \"https:\" + url;\ncheckPlayable(url);\nconst isHls = url.indexOf(\".m3u8\") >= 0;\nreturn {\nstreams: [{\nurl: url,\nformat: isHls? \"hls\": \"mp4\",\nheaders: {\"User-Agent\": UA, \"Referer\": ORIGIN + \"/\", \"Origin\": ORIGIN},\n}],\n};\n}\n\nexport default {home: home, category: category, search: search, detail: detail, play: play};\n"}}