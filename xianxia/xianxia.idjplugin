{"manifest":{"schema":1,"id":"com.idj.ext.xianxia","name":"仙侠AI短剧","version":"1.0.0","author":{"name":"py 蜘蛛改写"},"description":"仙侠AI短剧（home.xxaidj.cc）。18 个分类（与原 py 完全一致），MacCMS 网页解析卡片与详情，player_aaaa 直链 m3u8 播放。由内置 py 蜘蛛改写。","type":"video","adult":true,"language":["zh"],"minAppVersion":"1.5","entry":"main.js","permissions":{"http":["home.xxaidj.cc"],"media":["iuewgnbvk.com","aoskazyz.com","aoskkaxxz.com","home.xxaidj.cc"],"cloudflare":false,"storage":false,"login":false},"capabilities":["home","category","search","detail","play"],"settings":[],"update":{"url":"https://raw.githubusercontent.com/hoyittvggfh45/moytv/plugins/xianxia/xianxia.idjplugin"},"integrity":"sha256-ymoDlV/FdQP8c573irL4JiJ69jme/mABu6z4sey3g9s="},"files":{"main.js":"// Xianxia AI short drama -- idj1 plugin (ported 1:1 from the builtin py spider xianxia)\n// Site: MacCMS HTML at https://home.xxaidj.cc/rukou\n// home parses category links from the homepage (fallback to the hardcoded\n// CATS table, exactly like the py), cards come from vod-portrait-item blocks,\n// detail follows the play page and extracts player_aaaa url, and play passes\n// the direct m3u8 through after pre-resolving a master playlist to its first\n// variant sub-playlist.\n\nconst BASE = \"https://home.xxaidj.cc/rukou\";\nconst ORIGIN = \"https://home.xxaidj.cc\";\nconst UA = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36\";\nconst TIMEOUT = 58000;\n\nconst CATS = [\n    [\"119\", \"不卡资源\"],\n    [\"244\", \"51资源\"],\n    [\"386\", \"黄瓜资源\"],\n    [\"358\", \"茄子资源\"],\n    [\"286\", \"兔兔资源\"],\n    [\"370\", \"森林资源\"],\n    [\"329\", \"库库资源\"],\n    [\"120\", \"国产视频\"],\n    [\"121\", \"中文字幕\"],\n    [\"122\", \"国产传媒\"],\n    [\"123\", \"日本有码\"],\n    [\"124\", \"日本无码\"],\n    [\"125\", \"欧美无码\"],\n    [\"126\", \"强干乱伦\"],\n    [\"127\", \"制服诱惑\"],\n    [\"128\", \"国产主播\"],\n    [\"129\", \"激情动漫\"],\n    [\"390\", \"AI短剧\"],\n];\n\n// Category names that must never be written into the category list:\n// adult-game / gambling entries.\nconst DROP_WORDS = [\"游戏\", \"棋牌\", \"博彩\", \"彩票\", \"赌\"];\n\nfunction str(value) {\n    if (value == null) return \"\";\n    return String(value).trim();\n}\n\nfunction normPg(pg) {\n    const n = parseInt(pg, 10);\n    return isFinite(n) && n >= 1 ? n : 1;\n}\n\nfunction unescapeHtml(s) {\n    return String(s || \"\")\n        .replace(/&lt;/g, \"<\")\n        .replace(/&gt;/g, \">\")\n        .replace(/&quot;/g, '\"')\n        .replace(/&#39;|&apos;/g, \"'\")\n        .replace(/&nbsp;/g, \" \")\n        .replace(/&#(\\d+);/g, (m, n) => String.fromCharCode(parseInt(n, 10)))\n        .replace(/&amp;/g, \"&\");\n}\n\nfunction unescapeUrl(s) {\n    return unescapeHtml(String(s || \"\").replace(/\\\\\\//g, \"/\")).trim();\n}\n\nfunction cleanText(t) {\n    const noTags = String(t || \"\").replace(/<[^>]+>/g, \" \");\n    return unescapeHtml(noTags).replace(/\\s+/g, \" \").trim();\n}\n\nfunction headers(referer) {\n    return {\n        \"User-Agent\": UA,\n        \"Accept\": \"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\",\n        \"Referer\": referer || (BASE + \"/\"),\n    };\n}\n\nasync function getText(url, referer) {\n    let lastError = null;\n    for (let attempt = 0; attempt < 3; attempt++) {\n        try {\n            const resp = await host.http.get(url, {headers: headers(referer), timeout: TIMEOUT});\n            if (resp.status === 200 && resp.body && resp.body.trim()) return resp.body;\n            lastError = new Error(\"HTTP \" + resp.status);\n        } catch (error) {\n            lastError = error;\n        }\n    }\n    if (lastError) host.log(\"xianxia getText failed\", url, String(lastError && lastError.message));\n    return \"\";\n}\n\nconst CARD_RE = /<a class=\"vod-portrait-item\" href=\"[^\"]*\\/vod\\/detail\\/id\\/(\\d+)\\.html\"[^>]*>[\\s\\S]*?<img[^>]*data-original=\"([^\"]+)\"[^>]*>[\\s\\S]*?<div class=\"vod-portrait-name\">([\\s\\S]*?)<\\/div>/g;\nconst CAT_RE = /href=\"[^\"]*\\/vod\\/type\\/id\\/(\\d+)\\.html\"[^>]*>([^<]+)<\\/a>/g;\n\nfunction parseCards(html) {\n    const out = [];\n    const seen = new Set();\n    if (!html) return out;\n    CARD_RE.lastIndex = 0;\n    let m;\n    while ((m = CARD_RE.exec(html)) !== null) {\n        const vid = str(m[1]);\n        if (!vid || seen.has(vid)) continue;\n        const title = cleanText(m[3]);\n        if (!title) continue;\n        seen.add(vid);\n        out.push({id: vid, title: title, cover: str(m[2]), remarks: \"\"});\n    }\n    return out;\n}\n\nfunction droppedName(name) {\n    for (const w of DROP_WORDS) {\n        if (name.indexOf(w) >= 0) return true;\n    }\n    return false;\n}\n\nfunction parseCategories(html) {\n    const out = [];\n    const seen = new Set();\n    if (!html) return out;\n    CAT_RE.lastIndex = 0;\n    let m;\n    while ((m = CAT_RE.exec(html)) !== null) {\n        const cid = str(m[1]);\n        const name = unescapeUrl(m[2]);\n        if (!name || seen.has(cid)) continue;\n        if (droppedName(name)) continue;\n        seen.add(cid);\n        out.push({id: cid, name: name});\n    }\n    return out;\n}\n\nfunction fallbackCats() {\n    return CATS.map((pair) => ({id: pair[0], name: pair[1]}));\n}\n\nasync function catalog(tid, pg) {\n    let url;\n    if (pg <= 1) {\n        url = BASE + \"/index.php/vod/type/id/\" + tid + \".html\";\n    } else {\n        url = BASE + \"/index.php/vod/type/id/\" + tid + \"/page/\" + pg + \".html\";\n    }\n    const html = await getText(url, BASE + \"/\");\n    return parseCards(html);\n}\n\n// ---------- idj1 contract ----------\n\nasync function home() {\n    const html = await getText(BASE + \"/\", BASE + \"/\");\n    let cats = parseCategories(html);\n    if (!cats.length) cats = fallbackCats();\n    let items = [];\n    if (cats.length) items = await catalog(cats[0].id, 1);\n    return {categories: cats, items: items, hasMore: true};\n}\n\nasync function category(arg) {\n    const pg = normPg(arg && arg.page);\n    const tid = str(arg && arg.id);\n    const items = await catalog(tid, pg);\n    return {items: items, hasMore: true};\n}\n\nasync function search(arg) {\n    const pg = normPg(arg && arg.page);\n    const keyword = str(arg && arg.keyword);\n    const url = BASE + \"/index.php/vod/search/wd/\" + encodeURIComponent(keyword) + \".html\";\n    const html = await getText(url, BASE + \"/\");\n    return {items: parseCards(html), hasMore: true};\n}\n\nasync function detail(arg) {\n    let nid = str(arg && arg.id).replace(/\\/+$/, \"\");\n    if (nid.indexOf(\"/vod/detail/id/\") >= 0) {\n        nid = nid.slice(nid.lastIndexOf(\"/vod/detail/id/\") + \"/vod/detail/id/\".length);\n    }\n    nid = nid.replace(/^\\/+/, \"\");\n    if (nid.endsWith(\".html\")) nid = nid.slice(0, nid.length - 5);\n    if (!nid) throw host.error(\"E_PARSE\", \"missing id\");\n    const html = await getText(BASE + \"/index.php/vod/detail/id/\" + nid + \".html\", BASE + \"/\");\n    if (!html) throw host.error(\"E_PARSE\", \"detail page empty\");\n    const h1 = /<h1[^>]*>([\\s\\S]*?)<\\/h1>/.exec(html);\n    const title = h1 ? cleanText(h1[1]) : \"\";\n    const coverM = /data-original=\"(https?:\\/\\/[^\"]+)\"/.exec(html);\n    const cover = coverM ? coverM[1] : \"\";\n    const descM = /<meta name=\"description\"[^>]*content=\"([^\"]*)\"/.exec(html);\n    const synopsis = descM ? unescapeUrl(descM[1]) : \"\";\n    const linkM = /href=\"([^\"]*\\/vod\\/play\\/id\\/\\d+\\/sid\\/\\d+\\/nid\\/1\\.html)\"/.exec(html);\n    if (!title || !linkM) throw host.error(\"E_PARSE\", \"detail has no title or play link\");\n    const playHtml = await getText(ORIGIN + linkM[1], BASE + \"/\");\n    const pm = /player_aaaa=[\\s\\S]*?\"url\":\"([^\"]+)\"/.exec(playHtml || \"\");\n    const m3u8 = pm ? unescapeUrl(pm[1]) : \"\";\n    if (!m3u8) throw host.error(\"E_PARSE\", \"detail has no stream url\");\n    const out = {\n        id: nid,\n        title: title,\n        desc: synopsis,\n        tags: [],\n        lines: [{name: \"在线播放\", episodes: [{id: m3u8, name: \"播放\"}]}],\n    };\n    if (cover) out.cover = cover;\n    return out;\n}\n\nasync function resolveMaster(url) {\n    try {\n        const resp = await host.http.get(url, {headers: headers(BASE + \"/\"), timeout: TIMEOUT});\n        if (resp.status !== 200 || !resp.body) return url;\n        const text = resp.body;\n        if (text.indexOf(\"#EXT-X-STREAM-INF\") < 0) return url;\n        const lines = text.split(/\\r?\\n/).map((s) => s.trim());\n        for (let i = 0; i < lines.length; i++) {\n            if (lines[i].indexOf(\"#EXT-X-STREAM-INF\") === 0) {\n                for (let j = i + 1; j < lines.length; j++) {\n                    if (lines[j] && lines[j].indexOf(\"#\") !== 0) {\n                        return host.url.resolve(url, lines[j]);\n                    }\n                }\n            }\n        }\n        return url;\n    } catch (error) {\n        return url;\n    }\n}\n\nasync function play(arg) {\n    let raw = str((arg && arg.episodeId) || (arg && arg.id));\n    if (raw.indexOf(\"$\") >= 0) raw = raw.split(\"$\", 1)[1] || raw.slice(raw.indexOf(\"$\") + 1);\n    raw = raw.trim();\n    if (raw.indexOf(\"http\") !== 0) throw host.error(\"E_PARSE\", \"no stream url\");\n    const isHls = /\\.m3u8($|\\?)/i.test(raw);\n    let url = raw;\n    if (isHls) url = await resolveMaster(raw);\n    return {\n        streams: [{\n            url: url,\n            format: isHls ? \"hls\" : \"video\",\n            headers: {\"User-Agent\": UA, \"Referer\": BASE + \"/\"},\n            name: \"仙侠AI短剧\",\n        }],\n    };\n}\n\nexport default {home: home, category: category, search: search, detail: detail, play: play};\n"}}