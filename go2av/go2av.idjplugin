{"manifest":{"schema":1,"id":"com.idj.ext.go2av","name":"🔞🆕Go2AV┃工口エロ","version":"1.0.0","author":{"name":"py 蜘蛛改写"},"description":"🔞GO2AV┃工口エロ（go2av.com 移动版 /m/，HTML 直解站）。分类与内置 jar 蜘蛛 1:1：🆕 最新/🈶 中文字幕/🎬 有碼AV/🔓 無碼AV 共 4 类；详情页两层 iframe（av99.us 播放器 → xvideos embedframe）取 setVideoHLS 多档 HLS 与高/低清 MP4，play 内验清单、签名过期时回 embed 页现场重签、主清单预解析到最高码率子清单。由内置 jar 蜘蛛 ZakaGo2avAmns 改写。","type":"video","adult":true,"language":["zh"],"minAppVersion":"1.5","entry":"main.js","permissions":{"http":["go2av.com","av99.us","www.av99.us","xvideos.com","www.xvideos.com","*.xvideos-cdn.com"],"media":["go2av.com","av99.us","www.av99.us","xvideos.com","www.xvideos.com","*.xvideos-cdn.com"],"cloudflare":false,"storage":false,"login":false},"capabilities":["home","category","search","detail","play"],"settings":[],"update":{"url":"https://raw.githubusercontent.com/hoyittvggfh45/moytv/plugins/go2av/go2av.idjplugin"},"integrity":"sha256-/EQXbSzZQY+BkZjJMg0kNZh4GZns1Gh4dxkuFeiw3Q0="},"files":{"main.js":"// GO2AV (go2av.com) — idj1 plugin, 1:1 port of the builtin jar spider\n// ZakaGo2avAmns. HTML site: mobile pages under /m/, list items are\n// /a/<cat>/<yyyymmdd>/<id>.html links. Detail pages embed a player iframe\n// (av99.us) which embeds the xvideos embedframe; that page carries\n// setVideoHLS / setVideoUrlHigh / setVideoUrlLow. The original spider\n// rewrote playlists and covers through a loopback proxy only to attach\n// the xvideos Referer; the plugin instead returns the CDN URLs directly\n// with UA/Referer headers (covers verified fetchable without a Referer,\n// playlists/segments verified with the xvideos Referer). Signed CDN URLs\n// expire, so play() re-resolves the HLS address from the embed page when\n// the stored one no longer returns a playlist.\n\nconst HOST = \"https://go2av.com\";\nconst MOV = HOST + \"/m\";\nconst XV_ORIGIN = \"https://www.xvideos.com\";\nconst UA = \"Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1\";\nconst UA_PC = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36\";\nconst TIMEOUT = 60000;\n\n// Original CATS table, verbatim (id, display name, path template).\nconst CATS = [\n[\"new\", \"🆕 最新\", \"/index.php\"],\n[\"ch\", \"🈶 中文字幕\", \"/a/ch/list_5_%d.html\"],\n[\"censored\", \"🎬 有碼AV\", \"/a/censored/list_6_%d.html\"],\n[\"uncensored\", \"🔓 無碼AV\", \"/a/uncensored/list_7_%d.html\"],\n];\n\nconst RE_ITEM = /href=\"([^\"]*?(?:\\/a\\/|\\.\\/a\\/)[a-z]+\\/\\d{8}\\/\\d+\\.html|\\/m\\/view\\.php\\?aid=\\d+)\"/g;\nconst RE_TITLE_H3 = /<h3[^>]*am-list-item-hd[^>]*>\\s*<a[^>]*>([^<]{1,200})<\\/a>/;\nconst RE_IMG = /<img[^>]*src=['\"]([^'\"]+)['\"]/;\nconst RE_DATE = /日期：<\\/b>\\s*(\\d{4}-\\d{2}-\\d{2})/;\nconst RE_ART_TITLE = /<h3[^>]*am-article-title[^>]*>([\\s\\S]{1,400}?)<\\/h3>/;\nconst RE_IFRAME = /<iframe[^>]*src=\"([^\"]+)\"/g;\nconst RE_SET_HLS = /setVideoHLS\\('([^']+)'\\)/;\nconst RE_SET_HIGH = /setVideoUrlHigh\\('([^']+)'\\)/;\nconst RE_SET_LOW = /setVideoUrlLow\\('([^']+)'\\)/;\nconst RE_SET_TITLE = /setVideoTitle\\('([^']*)'\\)/;\nconst RE_SET_THUMB = /setThumbUrl\\('([^']+)'\\)/;\nconst RE_OG_IMG = /<meta[^>]*property=\"og:image\"[^>]*content=\"([^\"]+)\"/;\nconst RE_ANY_M3U8 = /https?:\\/\\/[^\\s\"'<>]+?\\.m3u8[^\\s\"'<>]*/i;\nconst RE_ANY_MP4 = /https?:\\/\\/[^\\s\"'<>]+?\\.mp4[^\\s\"'<>]*/gi;\nconst RE_VIDEO_TAG = /<video[^>]*src=\"([^\"]+)\"/i;\n\nfunction str(v) { return v == null? \"\": String(v);}\nfunction intValue(v, fb) { const n = parseInt(v, 10); return isFinite(n)? n: fb;}\n\nfunction unesc(s) {\nreturn str(s).replace(/&lt;/g, \"<\").replace(/&gt;/g, \">\").replace(/&quot;/g, '\"')\n.replace(/&#39;/g, \"'\").replace(/&#x27;/g, \"'\").replace(/&nbsp;/g, \" \")\n.replace(/&amp;/g, \"&\").replace(/\\\\\\//g, \"/\");\n}\n\nfunction stripTags(s) {\nreturn str(s).replace(/<[^>]+>/g, \" \").replace(/\\s+/g, \" \").trim();\n}\n\nfunction isChallenge(body) {\nconst t = str(body);\nreturn t.indexOf(\"Just a moment\") >= 0 || t.indexOf(\"challenges.cloudflare.com\") >= 0 || t.indexOf(\"cf_chl\") >= 0;\n}\n\nfunction mobHead(referer) {\nreturn {\n\"User-Agent\": UA,\n\"Accept\": \"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\",\n\"Accept-Language\": \"zh-CN,zh;q=0.9,en;q=0.8\",\n\"Referer\": referer || (MOV + \"/\"),\n};\n}\n\nfunction pcHead(referer) {\nreturn {\n\"User-Agent\": UA_PC,\n\"Accept\": \"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\",\n\"Accept-Language\": \"zh-CN,zh;q=0.9,en;q=0.8\",\n\"Referer\": referer || (XV_ORIGIN + \"/\"),\n};\n}\n\nasync function fetchText(url, headers) {\nlet lastErr = null;\nfor (let attempt = 0; attempt < 2; attempt++) {\ntry {\nconst resp = await host.http.get(url, {headers: headers, timeout: TIMEOUT});\nconst body = resp? str(resp.body): \"\";\nif (isChallenge(body)) {\nthrow host.error(\"E_CF_REQUIRED\", \"go2av Cloudflare challenge: host clearance required\");\n}\nif (body) return body;\nlastErr = new Error(\"empty body HTTP \" + (resp? resp.status: \"no response\"));\n} catch (e) {\nif (e && e.code === \"E_CF_REQUIRED\") throw e;\nlastErr = e;\n}\n}\nthrow host.error(\"E_NETWORK\", \"go2av fetch failed: \" + url + \" (\" + (lastErr && lastErr.message) + \")\");\n}\n\n// Spider absUrl, verbatim semantics.\nfunction absUrl(base, href) {\nconst t = str(href).trim();\nif (!t) return \"\";\nif (t.indexOf(\"http\") === 0) return t;\nif (t.indexOf(\"./\") === 0) return MOV + \"/\" + t.slice(2);\nif (t.indexOf(\"/m/\") === 0) return HOST + t;\nif (t.charAt(0) === \"/\") return MOV + t;\nreturn MOV + \"/\" + t;\n}\n\nfunction picOf(block) {\nconst m = RE_IMG.exec(block);\nif (!m) return \"\";\nlet t = unesc(m[1]).trim();\nif (t.indexOf(\"//\") === 0) t = \"https:\" + t;\nif (t.indexOf(\"http\") === 0 && t.indexOf(\"favicon\") < 0 && t.indexOf(\"logo\") < 0) return t;\nreturn \"\";\n}\n\nfunction appendCards(out, html, pageUrl, limit) {\nif (!html || html.length < 200) return;\nRE_ITEM.lastIndex = 0;\nconst seen = {};\nlet m;\nwhile ((m = RE_ITEM.exec(html))!== null && out.length < limit) {\nconst url = absUrl(pageUrl, m[1]);\nif (url.length < 10 || seen[url]) continue;\nseen[url] = true;\nconst block = html.slice(m.index, Math.min(html.length, m.index + m[0].length + 1500));\nconst tm = RE_TITLE_H3.exec(block);\nlet title = tm? unesc(tm[1]).trim(): \"\";\nif (title.length <= 1) title = \"GO2AV 影片\";\nconst dm = RE_DATE.exec(block);\nout.push({\nid: url,\ntitle: title,\ncover: picOf(block),\nremarks: dm? dm[1]: \"GO2AV\",\ntags: [],\n});\n}\n}\n\nfunction catPath(tid) {\nfor (const c of CATS) if (c[0] === tid) return c[2];\nreturn \"/index.php\";\n}\n\nasync function home() {\nconst categories = CATS.map(c => ({id: c[0], name: c[1]}));\nconst url = MOV + \"/index.php\";\nconst html = await fetchText(url, mobHead(MOV + \"/\"));\nconst items = [];\nappendCards(items, html, url, 30);\nreturn {categories: categories, items: items, hasMore: items.length > 0};\n}\n\nasync function category(arg) {\nconst tid = str(arg && arg.id).trim();\nconst page = Math.max(1, intValue(arg && arg.page, 1));\nconst tpl = catPath(tid);\nconst url = MOV + tpl.replace(\"%d\", String(page));\nconst html = await fetchText(url, mobHead(MOV + \"/\"));\nconst items = [];\nappendCards(items, html, url, 60);\nconst hasMore = tpl.indexOf(\"%d\") >= 0? items.length >= 12: false;\nreturn {items: items, hasMore: hasMore};\n}\n\nasync function search(arg) {\nconst keyword = str(arg && arg.keyword).trim();\nif (!keyword) return {items: [], hasMore: false};\nconst page = Math.max(1, intValue(arg && arg.page, 1));\nconst url = MOV + \"/plus/search.php?mobile=1&kwtype=0&q=\" + encodeURIComponent(keyword) + (page > 1? \"&page=\" + page: \"\");\nlet html = await fetchText(url, mobHead(MOV + \"/\"));\nlet items = [];\nappendCards(items, html, url, 40);\nif (!items.length) {\nhtml = await fetchText(url, mobHead(MOV + \"/\"));\nappendCards(items, html, url, 40);\n}\nreturn {items: items, hasMore: items.length >= 12};\n}\n\nfunction firstIframe(html) {\nRE_IFRAME.lastIndex = 0;\nconst m = RE_IFRAME.exec(str(html));\nif (!m) return \"\";\nlet t = m[1].trim();\nif (t.indexOf(\"//\") === 0) t = \"https:\" + t;\nreturn t;\n}\n\n// Spider frame2: from the first player page, take the first iframe that\n// is not the ad page (filtered on \"ad.php\" / \"ads\").\nasync function frame2(frameUrl) {\nif (!frameUrl || frameUrl.length < 10) return \"\";\nconst html = await fetchText(frameUrl, mobHead(MOV + \"/\"));\nif (!html || html.length < 100) return \"\";\nRE_IFRAME.lastIndex = 0;\nlet m;\nwhile ((m = RE_IFRAME.exec(html))!== null) {\nlet t = m[1].trim();\nif (t.indexOf(\"ad.php\") >= 0 || t.indexOf(\"ads\") >= 0) continue;\nif (t.indexOf(\"//\") === 0) t = \"https:\" + t;\nif (t.indexOf(\"http\") === 0) return t;\n}\nreturn \"\";\n}\n\nfunction firstMatch(html, re) {\nconst m = re.exec(str(html));\nreturn m? m[1]: \"\";\n}\n\n// Spider streamsOf: returns [hls, highMp4, lowMp4, thumb, title].\nasync function streamsOf(frameUrl, detailHtml) {\nconst out = [\"\", \"\", \"\", \"\", \"\"];\nif (!frameUrl || frameUrl.length < 10) return out;\nconst html = await fetchText(frameUrl, pcHead(frameUrl));\nif (html && html.length > 500) {\nout[0] = unesc(firstMatch(html, RE_SET_HLS) || firstMatch(html, RE_ANY_M3U8));\nout[1] = unesc(firstMatch(html, RE_SET_HIGH));\nout[2] = unesc(firstMatch(html, RE_SET_LOW));\nout[3] = unesc(firstMatch(html, RE_OG_IMG) || firstMatch(html, RE_SET_THUMB));\nout[4] = unesc(firstMatch(html, RE_SET_TITLE));\nif (!out[1] ||!out[2]) {\nRE_ANY_MP4.lastIndex = 0;\nlet m;\nwhile ((m = RE_ANY_MP4.exec(html))!== null) {\nconst u = unesc(m[0]);\nif (u.indexOf(\"preview\") >= 0) continue;\nif (!out[1]) out[1] = u;\nelse if (!out[2] && u!== out[1]) out[2] = u;\nif (out[1] && out[2]) break;\n}\n}\n}\nif (!out[0] && detailHtml) {\nout[0] = unesc(firstMatch(detailHtml, RE_ANY_M3U8) || firstMatch(detailHtml, RE_VIDEO_TAG));\n}\nreturn out;\n}\n\nasync function detail(arg) {\nlet id = str(arg && arg.id).trim();\nif (id.length < 8) throw host.error(\"E_PARSE\", \"empty detail id\");\nif (id.charAt(0) === \"/\") id = HOST + id;\nconst html = await fetchText(id, mobHead(id));\nconst tm = RE_ART_TITLE.exec(html);\nlet title = tm? unesc(stripTags(tm[1])).trim(): \"\";\nif (!title) title = \"GO2AV 影片\";\nlet frame = firstIframe(html);\nconst inner = await frame2(frame);\nif (inner) frame = inner;\nconst s = await streamsOf(frame, html);\nconst cover = s[3] || picOf(html.slice(0, 6000));\nif (s[4]) title = s[4];\nconst lines = [];\nif (s[0]) {\nlines.push({name: \"GO2AV·HLS\", episodes: [{id: \"hls|\" + s[0] + \"|\" + frame, name: \"正片\"}]});\n}\nconst mp4eps = [];\nif (s[1]) mp4eps.push({id: \"mp4|\" + s[1], name: \"高清MP4\"});\nif (s[2] && s[2]!== s[1]) mp4eps.push({id: \"mp4|\" + s[2], name: \"低清MP4\"});\nif (mp4eps.length) lines.push({name: \"GO2AV·MP4\", episodes: mp4eps});\nif (!lines.length) {\nthrow host.error(\"E_PARSE\", \"go2av detail resolved no stream (frame: \" + (frame || \"none\") + \")\");\n}\nreturn {\nid: id,\ntitle: title,\ncover: cover,\ndesc: \"GO2AV · \" + HOST + \"\\n详情页外嵌播放器（两层 iframe）→ hls.m3u8 多档 + mp4 双档\",\nremarks: lines[0].name.replace(\"GO2AV·\", \"\"),\ntags: [],\nlines: lines,\n};\n}\n\nfunction resolveRel(master, rel) {\nconst r = str(rel).trim();\nif (/^https?:\\/\\//i.test(r)) return r;\nif (r.indexOf(\"//\") === 0) return \"https:\" + r;\nconst noQuery = master.split(\"?\")[0];\nconst dir = noQuery.slice(0, noQuery.lastIndexOf(\"/\") + 1);\nif (r.charAt(0) === \"/\") {\nconst schemeEnd = master.indexOf(\"://\");\nconst hostEnd = master.indexOf(\"/\", schemeEnd + 3);\nreturn (hostEnd < 0? master: master.slice(0, hostEnd)) + r;\n}\nreturn dir + r;\n}\n\nfunction httpsOnly(u) {\nconst t = str(u).trim();\nif (t.indexOf(\"http://\") === 0) return \"https://\" + t.slice(7);\nreturn t;\n}\n\n// Spider freshStream: re-read the embed page for a fresh signed HLS URL.\nasync function freshHls(frameUrl) {\nif (!frameUrl || frameUrl.length < 10) return \"\";\ntry {\nconst html = await fetchText(frameUrl, pcHead(frameUrl));\nif (html && html.length >= 500) {\nreturn unesc(firstMatch(html, RE_SET_HLS) || firstMatch(html, RE_ANY_M3U8));\n}\n} catch (e) { /* fall through */}\nreturn \"\";\n}\n\nasync function play(arg) {\nconst raw = str((arg && arg.episodeId) || (arg && arg.id)).trim();\nconst parts = raw.split(\"|\");\nconst kind = parts[0];\nlet url = httpsOnly(parts[1] || \"\");\nconst frame = parts[2] || \"\";\nif (url.indexOf(\"https://\")!== 0) throw host.error(\"E_PARSE\", \"invalid play id\");\nconst hdrs = {\"User-Agent\": UA_PC, \"Referer\": XV_ORIGIN + \"/\"};\nif (kind === \"mp4\") {\nreturn {streams: [{url: url, format: \"mp4\", headers: hdrs, name: \"GO2AV·MP4\"}], expiresAt: Date.now() + 1200 * 1000};\n}\n// HLS: verify the stored signed URL still serves a playlist; if not,\n// re-sign from the embed page (spider Go2avProxy behaviour).\nlet body = \"\";\ntry {\nconst resp = await host.http.get(url, {headers: hdrs, timeout: TIMEOUT});\nbody = resp? str(resp.body): \"\";\n} catch (e) { body = \"\";}\nif (body.indexOf(\"#EXTM3U\") < 0) {\nconst fresh = await freshHls(frame);\nif (fresh) {\nurl = httpsOnly(fresh);\ntry {\nconst resp = await host.http.get(url, {headers: hdrs, timeout: TIMEOUT});\nbody = resp? str(resp.body): \"\";\n} catch (e) { body = \"\";}\n}\n}\nif (body.indexOf(\"#EXTM3U\") < 0) {\nthrow host.error(\"E_NETWORK\", \"go2av HLS playlist unreachable (expired signature?)\");\n}\n// Master playlist: pre-resolve to the highest-bandwidth variant.\nlet finalUrl = url;\nif (body.indexOf(\"#EXT-X-STREAM-INF\") >= 0) {\nconst rows = body.split(/\\r?\\n/);\nlet best = \"\", bestBw = -1, first = \"\";\nfor (let i = 0; i < rows.length; i++) {\nconst ln = rows[i].trim();\nif (ln.indexOf(\"#EXT-X-STREAM-INF\") === 0) {\nconst bm = /BANDWIDTH=(\\d+)/.exec(ln);\nconst bw = bm? parseInt(bm[1], 10): 0;\nfor (let k = i + 1; k < rows.length; k++) {\nconst cand = rows[k].trim();\nif (cand && cand.charAt(0)!== \"#\") {\nif (!first) first = cand;\nif (bw > bestBw) { bestBw = bw; best = cand;}\nbreak;\n}\n}\n}\n}\nconst pick = best || first;\nif (pick) finalUrl = resolveRel(url, pick);\n}\nreturn {streams: [{url: finalUrl, format: \"hls\", headers: hdrs, name: \"GO2AV·HLS\"}], expiresAt: Date.now() + 1200 * 1000};\n}\n\nexport default {home: home, category: category, search: search, detail: detail, play: play};\n"}}