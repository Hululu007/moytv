{"manifest":{"schema":1,"id":"com.idj.ext.yaguo","name":"芽果","version":"1.0.0","author":{"name":"py 蜘蛛改写"},"description":"芽果短剧（app.whjzjx.cn 接口站，设备号登录换令牌）。分类与原 py 一致（接口 classes 解析、兜底剧场/榜单），详情集数自带 mp4 直链播放。由内置 py 蜘蛛改写。","type":"video","adult":false,"language":["zh"],"minAppVersion":"1.5","entry":"main.js","permissions":{"http":["app.whjzjx.cn","u.shytkjgs.com"],"media":["qcapp.xingya.com.cn","qiniu.rongjuwh.cn"],"cloudflare":false,"storage":true,"login":false},"capabilities":["home","category","search","detail","play"],"settings":[],"update":{"url":"https://raw.githubusercontent.com/hoyittvggfh45/moytv/plugins/yaguo/yaguo.idjplugin"},"integrity":"sha256-/nq1K3u1voPRUQb+mIlNXScRlfmzGlj1IbUH1UNrVdE="},"files":{"main.js":"// yaguo - idj1 plugin (rewritten from built-in py spider yaguo)\n// API app: BASE https://app.whjzjx.cn, login https://u.shytkjgs.com/user/v1/account/login\n// Flow mirrors the py spider 1:1: device login -> token (cached 6h) ->\n// classes / home_page / ranking / detail / search; detail episodes already\n// carry direct media URLs, play returns them as-is (master m3u8 pre-resolved).\n\nconst BASE_URL = \"https://app.whjzjx.cn\";\nconst LOGIN_URL = \"https://u.shytkjgs.com/user/v1/account/login\";\nconst DEVICE = \"24250683a3bdb3f118dff25ba4b1cba1a\";\nconst VERSION_NAME = \"3.8.3.1\";\nconst TOKEN_TTL_MS = 6 * 3600 * 1000;\nconst UA = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36\";\nconst TIMEOUT = 58000;\nconst RETRIES = 3;\n\nconst FALLBACK_CATS = [\n    {id: \"1\", name: \"剧场\"},\n    {id: \"9\", name: \"榜单\"},\n];\n\nlet memToken = \"\";\nlet memTokenExp = 0;\n\nfunction str(value) {\n    if (value == null) return \"\";\n    return String(value);\n}\n\nfunction txt(value) {\n    if (value == null) return \"\";\n    if (typeof value === \"string\") return value.trim();\n    return String(value).trim();\n}\n\nfunction intValue(value) {\n    const n = parseInt(value, 10);\n    return isFinite(n) ? n : 0;\n}\n\nfunction firstText(obj, keys) {\n    if (!obj || typeof obj !== \"object\") return \"\";\n    for (const k of keys) {\n        const v = obj[k];\n        if (typeof v === \"string\" && v.trim()) return v.trim();\n        if (typeof v === \"number\" && isFinite(v)) return String(v);\n    }\n    return \"\";\n}\n\nasync function httpJson(url, opts) {\n    opts = opts || {};\n    const method = opts.method || \"GET\";\n    const headers = {\n        \"User-Agent\": UA,\n        \"Accept\": \"application/json, */*\",\n    };\n    if (opts.headers) {\n        for (const k of Object.keys(opts.headers)) headers[k] = opts.headers[k];\n    }\n    let body = \"\";\n    if (opts.data != null) {\n        body = JSON.stringify(opts.data);\n        headers[\"Content-Type\"] = \"application/json\";\n    }\n    for (let attempt = 0; attempt < RETRIES; attempt++) {\n        try {\n            const resp = await host.http.request({\n                url: url,\n                method: method,\n                headers: headers,\n                body: body,\n                timeout: TIMEOUT,\n            });\n            if (resp.status === 200 && resp.body) {\n                try {\n                    const obj = JSON.parse(resp.body);\n                    if (obj && typeof obj === \"object\") return obj;\n                } catch (e) {\n                    return null;\n                }\n            }\n        } catch (e) {\n            // retry below\n        }\n        // immediate retry; the host sandbox has no timers\n    }\n    return null;\n}\n\nfunction extractToken(body) {\n    if (!body || typeof body !== \"object\") return \"\";\n    let t = firstText(body, [\"token\", \"access_token\", \"accessToken\"]);\n    if (t) return t;\n    const data = body.data;\n    if (data && typeof data === \"object\") {\n        t = firstText(data, [\"token\", \"access_token\", \"accessToken\"]);\n    }\n    return t;\n}\n\nasync function getToken() {\n    const now = Date.now();\n    if (memToken && now < memTokenExp) return memToken;\n    try {\n        const saved = host.storage.get(\"yaguo_token\");\n        const savedExp = parseInt(host.storage.get(\"yaguo_token_exp\") || \"0\", 10);\n        if (saved && isFinite(savedExp) && now < savedExp) {\n            memToken = saved;\n            memTokenExp = savedExp;\n            return memToken;\n        }\n    } catch (e) {\n        // storage optional\n    }\n    const body = await httpJson(LOGIN_URL, {\n        method: \"POST\",\n        headers: {\"platform\": \"1\"},\n        data: {device: DEVICE},\n    });\n    const token = extractToken(body);\n    if (token) {\n        memToken = token;\n        memTokenExp = now + TOKEN_TTL_MS;\n        try {\n            host.storage.set(\"yaguo_token\", token);\n            host.storage.set(\"yaguo_token_exp\", String(memTokenExp));\n        } catch (e) {\n            // ignore\n        }\n    }\n    return token;\n}\n\nfunction apiHeaders(token) {\n    return {\n        \"Referer\": BASE_URL + \"/\",\n        \"authorization\": token,\n        \"platform\": \"1\",\n        \"version_name\": VERSION_NAME,\n    };\n}\n\nasync function apiGet(path, query) {\n    const token = await getToken();\n    if (!token) return null;\n    let url = BASE_URL + path;\n    if (query) {\n        const qs = host.url.encodeForm(query);\n        if (qs) url += \"?\" + qs;\n    }\n    return httpJson(url, {headers: apiHeaders(token)});\n}\n\nasync function apiSearch(keyword) {\n    const token = await getToken();\n    if (!token) return null;\n    return httpJson(BASE_URL + \"/v3/search\", {\n        method: \"POST\",\n        headers: apiHeaders(token),\n        data: {text: keyword},\n    });\n}\n\nfunction catalogItems(rows) {\n    const out = [];\n    if (!Array.isArray(rows)) return out;\n    for (const entry of rows) {\n        if (!entry || typeof entry !== \"object\") continue;\n        let target = entry;\n        if (entry.theater && typeof entry.theater === \"object\"\n            && Object.keys(entry.theater).length) {\n            target = entry.theater;\n        }\n        const vid = firstText(target, [\"id\", \"theater_id\", \"theater_parent_id\"]);\n        if (!vid) continue;\n        const title = firstText(target, [\"title\", \"name\"]);\n        if (!title) continue;\n        let count = 0;\n        for (const k of [\"total\", \"total_num\", \"current_num\"]) {\n            count = intValue(target[k]);\n            if (count > 0) break;\n        }\n        const cover = firstText(target, [\"cover_url\", \"son_cover_url\", \"cover\"]);\n        out.push({\n            id: vid,\n            title: title,\n            cover: cover,\n            remarks: count > 0 ? (\"共\" + count + \"集\") : \"\",\n            duration: \"\",\n            tags: [],\n        });\n    }\n    return out;\n}\n\nasync function fetchCats() {\n    const resp = await apiGet(\"/cloud/v2/theater/classes\");\n    const out = [];\n    const seen = {};\n    if (resp && typeof resp === \"object\" && Array.isArray(resp.data)) {\n        for (const group of resp.data) {\n            if (!group || typeof group !== \"object\") continue;\n            const classes = group.alg_class;\n            if (!Array.isArray(classes)) continue;\n            for (const entry of classes) {\n                if (!entry || typeof entry !== \"object\") continue;\n                const cid = txt(entry.id);\n                const name = firstText(entry, [\"class_name\", \"name\"]);\n                if (!cid || !name || name.length > 24 || seen[cid]) continue;\n                seen[cid] = true;\n                out.push({id: cid, name: name});\n            }\n        }\n    }\n    if (!out.length) {\n        return FALLBACK_CATS.map((c) => ({id: c.id, name: c.name}));\n    }\n    return out;\n}\n\nasync function fetchCatalog(tid, pg) {\n    if (tid === \"9\") {\n        const resp = await apiGet(\"/cloud/v1/first_level_ranking/detail\", {id: \"1\"});\n        if (resp && typeof resp === \"object\"\n            && resp.data && typeof resp.data === \"object\"\n            && Array.isArray(resp.data.list)) {\n            return catalogItems(resp.data.list);\n        }\n        return [];\n    }\n    const classId = /^-?\\d+$/.test(tid) ? tid : \"\";\n    const resp = await apiGet(\"/cloud/v2/theater/home_page\", {\n        theater_class_id: classId,\n        type: \"1\",\n        class2_ids: \"0\",\n        page_num: String(pg),\n        page_size: \"24\",\n    });\n    if (resp && typeof resp === \"object\"\n        && resp.data && typeof resp.data === \"object\"\n        && Array.isArray(resp.data.list)) {\n        return catalogItems(resp.data.list);\n    }\n    return [];\n}\n\nfunction normPage(pg) {\n    const n = parseInt(pg, 10);\n    return isFinite(n) && n >= 1 ? n : 1;\n}\n\nfunction normId(ids) {\n    if (Array.isArray(ids)) return ids.length ? str(ids[0]) : \"\";\n    return str(ids || \"\");\n}\n\nasync function home() {\n    const cats = await fetchCats();\n    let items = [];\n    if (cats.length) items = await fetchCatalog(cats[0].id, 1);\n    return {categories: cats, items: items, hasMore: false};\n}\n\nasync function category(arg) {\n    const tid = normId(arg && arg.id);\n    const pg = normPage(arg && arg.page);\n    const items = await fetchCatalog(tid, pg);\n    return {items: items, hasMore: items.length > 0};\n}\n\nasync function search(arg) {\n    const keyword = str(arg && arg.keyword);\n    const resp = await apiSearch(keyword);\n    let items = [];\n    if (resp && typeof resp === \"object\") {\n        const data = resp.data;\n        let rows = null;\n        if (data && typeof data === \"object\") {\n            if (Array.isArray(data.list)) {\n                rows = data.list;\n            } else if (data.theater && typeof data.theater === \"object\"\n                && Array.isArray(data.theater.search_data)) {\n                rows = data.theater.search_data;\n            }\n        }\n        if (Array.isArray(rows)) items = catalogItems(rows);\n    }\n    return {items: items, hasMore: false};\n}\n\nasync function detail(arg) {\n    const sid = normId(arg && arg.id);\n    if (!sid) return {id: \"\", title: \"\", cover: \"\", desc: \"\", tags: [], lines: []};\n    const resp = await apiGet(\"/v2/theater_parent/detail\", {theater_parent_id: sid});\n    let data = null;\n    if (resp && typeof resp === \"object\"\n        && resp.data && typeof resp.data === \"object\"\n        && Object.keys(resp.data).length) {\n        data = resp.data;\n    }\n    if (!data) return {id: sid, title: sid, cover: \"\", desc: \"\", tags: [], lines: []};\n    const title = firstText(data, [\"title\", \"share_title\"]);\n    const cover = firstText(data, [\"cover_url\", \"share_cover\"]);\n    const rawList = data.theaters;\n    if (!Array.isArray(rawList)) {\n        return {id: sid, title: title || sid, cover: cover, desc: \"\", tags: [], lines: []};\n    }\n    const indexed = [];\n    for (let i = 0; i < rawList.length; i++) {\n        const entry = rawList[i];\n        if (!entry || typeof entry !== \"object\") continue;\n        const url = firstText(entry, [\"son_video_url\", \"video_url\"]);\n        if (!url) continue;\n        let number = 0;\n        for (const k of [\"num\", \"sort\"]) {\n            number = intValue(entry[k]);\n            if (number > 0) break;\n        }\n        if (number <= 0) number = i + 1;\n        const nodeTitle = firstText(entry, [\"son_title\", \"title\"]);\n        const epTitle = nodeTitle ? nodeTitle : (\"第\" + number + \"集\");\n        indexed.push({n: number, name: epTitle, url: url});\n    }\n    if (!indexed.length) {\n        return {id: sid, title: title || sid, cover: cover, desc: \"\", tags: [], lines: []};\n    }\n    indexed.sort((a, b) => a.n - b.n);\n    return {\n        id: sid,\n        title: title,\n        cover: cover,\n        desc: \"\",\n        tags: [],\n        lines: [{\n            name: \"在线播放\",\n            episodes: indexed.map((e) => ({id: e.url, name: e.name})),\n        }],\n    };\n}\n\nasync function resolveMaster(url, headers) {\n    try {\n        const resp = await host.http.get(url, {headers: headers, timeout: TIMEOUT});\n        if (resp.status !== 200 || !resp.body) return url;\n        const text = resp.body;\n        if (text.indexOf(\"#EXT-X-STREAM-INF\") < 0) return url;\n        const lines = text.split(/\\r?\\n/);\n        for (let i = 0; i < lines.length; i++) {\n            const line = lines[i].trim();\n            if (line.indexOf(\"#EXT-X-STREAM-INF\") === 0) {\n                for (let j = i + 1; j < lines.length; j++) {\n                    const cand = lines[j].trim();\n                    if (cand && cand.charAt(0) !== \"#\") {\n                        return host.url.resolve(url, cand);\n                    }\n                }\n            }\n        }\n    } catch (e) {\n        // fall back to the master url itself\n    }\n    return url;\n}\n\nasync function play(arg) {\n    let raw = str((arg && arg.episodeId) || (arg && arg.id));\n    if (raw.indexOf(\"$\") >= 0) raw = raw.split(\"$\")[1] || \"\";\n    raw = raw.trim();\n    const headers = {\"User-Agent\": UA, \"Referer\": BASE_URL + \"/\"};\n    if (!/^https?:\\/\\//i.test(raw)) {\n        throw new Error(\"无效的播放地址\");\n    }\n    let url = raw;\n    let format = \"\";\n    if (/\\.m3u8($|\\?)/i.test(url)) {\n        format = \"hls\";\n        url = await resolveMaster(url, headers);\n    } else if (/\\.mp4($|\\?)/i.test(url)) {\n        format = \"mp4\";\n    } else {\n        const clean = url.split(\"?\")[0];\n        const parts = clean.split(\".\");\n        format = parts.length > 1 ? parts[parts.length - 1].toLowerCase() : \"\";\n    }\n    return {\n        streams: [{url: url, format: format, headers: headers, name: \"在线播放\"}],\n        expiresAt: Date.now() + 30 * 60 * 1000,\n    };\n}\n\nexport default {home: home, category: category, search: search, detail: detail, play: play};\n"}}