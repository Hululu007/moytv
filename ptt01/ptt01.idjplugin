{"manifest":{"schema":1,"id":"com.idj.ext.ptt01","name":"🔞PTT01┃三级稀缺","version":"1.0.0","author":{"name":"py 蜘蛛改写"},"description":"🔞PTT01┃三级稀缺（ptt01.com，综合影视 HTML 站：电影/电视剧/短剧/动漫/综艺/体育 + 大陆/香港/台湾/日本/韩国地区分类）。分类与内置 jar 蜘蛛 ZakaPttAmns 1:1 共 11 个；列表/搜索走站内 HTML 卡片解析，详情页 <source> 直取 m3u8（AES-128 HLS 由播放器原生解），封面与流经实测可直连（带本站 Referer/UA），不走原蜘蛛的本机回环代理。由内置 jar 蜘蛛 ZakaPttAmns 改写。","type":"video","adult":true,"language":["zh"],"minAppVersion":"1.5","entry":"main.js","permissions":{"http":["ptt01.com"],"media":["ptt01.com","*.vcwinford.cc","hd.kuktxu.com","ckzy3.com","*.baisiweiting.com"],"cloudflare":false,"storage":false,"login":false},"capabilities":["home","category","search","detail","play"],"settings":[],"update":{"url":"https://raw.githubusercontent.com/hoyittvggfh45/moytv/plugins/ptt01/ptt01.idjplugin"},"integrity":"sha256-4LrHUpWotVsMBHj0X5c9YWWfWaDGri82w6t52XUfepg="},"files":{"main.js":"// PTT01 (ptt01.com) — idj plugin, 1:1 port of the builtin jar spider\n// ZakaPttAmns (key ptt01, ext empty). Plain HTML site: list pages carry\n// cards as href=\"/<5-7 digit id>\" plus a card <img alt/src>; the detail\n// page carries the stream in a <source src=\"....m3u8\"> tag (falling back\n// to any bare .m3u8 URL in the page). The original spider wrapped every\n// cover and stream through the shell loopback proxy (ZakaProxy /\n// ZakaStream) only to attach this site's Referer and UA; both the image\n// CDN and the stream CDNs were verified to answer direct requests with\n// plain headers, so the plugin returns the direct URLs plus the same\n// Referer/UA headers and needs no relay. The spider's hard-coded gate\n// cookie (x-index-auth=authed) is not needed: the site returns byte-\n// identical pages without it (verified 2026-11-26), and the host strips\n// Cookie headers anyway.\n\nconst HOST = \"https://ptt01.com\";\nconst UA = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36\";\nconst TIMEOUT = 58000;\n\n// Original CATS table, verbatim (id, display name, path template).\nconst CATS = [\n    [\"p1\", \"🎬 电影\", \"/p/1?page=%d\"],\n    [\"p3\", \"📺 电视剧\", \"/p/3?page=%d\"],\n    [\"p66\", \"⚡ 短剧\", \"/p/66?page=%d\"],\n    [\"p4\", \"🎌 动漫\", \"/p/4?page=%d\"],\n    [\"p2\", \"🎤 综艺\", \"/p/2?page=%d\"],\n    [\"p53\", \"🏀 体育\", \"/p/53?page=%d\"],\n    [\"r19\", \"🇨🇳 大陆\", \"/?category_id=19&page=%d\"],\n    [\"r20\", \"🇭🇰 香港\", \"/?category_id=20&page=%d\"],\n    [\"r81\", \"🏝 台湾\", \"/?category_id=81&page=%d\"],\n    [\"r83\", \"🇯🇵 日本\", \"/?category_id=83&page=%d\"],\n    [\"r82\", \"🇰🇷 韩国\", \"/?category_id=82&page=%d\"],\n];\n\nfunction str(v) { return v == null ? \"\" : String(v); }\n\nfunction unesc(s) {\n    return str(s).replace(/\\\\\\//g, \"/\").replace(/\\\\u0026/g, \"&\")\n        .replace(/&amp;/g, \"&\").replace(/&quot;/g, '\"').replace(/&#39;/g, \"'\")\n        .replace(/&lt;/g, \"<\").replace(/&gt;/g, \">\").replace(/&#x27;/g, \"'\")\n        .replace(/&#x2F;/g, \"/\").replace(/&nbsp;/g, \" \");\n}\n\nfunction absUrl(u) {\n    const t = unesc(u).trim();\n    if (t.indexOf(\"//\") === 0) return \"https:\" + t;\n    if (t.charAt(0) === \"/\") return HOST + t;\n    return t;\n}\n\nfunction headers() {\n    return {\n        \"User-Agent\": UA,\n        \"Accept\": \"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\",\n        \"Accept-Language\": \"zh-CN,zh;q=0.9,zh-Hant;q=0.8\",\n        \"Referer\": HOST + \"/\",\n    };\n}\n\nfunction isChallenge(body, status) {\n    const t = str(body);\n    return t.indexOf(\"Just a moment\") >= 0 || t.indexOf(\"challenges.cloudflare.com\") >= 0 ||\n        t.indexOf(\"cf_chl\") >= 0 || (status === 403 && t.indexOf(\"cloudflare\") >= 0);\n}\n\nasync function fetchPage(url) {\n    let resp;\n    try {\n        resp = await host.http.get(url, {headers: headers(), timeout: TIMEOUT});\n    } catch (e) {\n        if (e && e.code) throw e;\n        throw host.error(\"E_NETWORK\", \"请求失败：\" + (e && e.message ? e.message : e));\n    }\n    if (isChallenge(resp.body, resp.status)) {\n        throw host.error(\"E_CF_REQUIRED\", \"站点要求人机验证（Cloudflare）\");\n    }\n    if (resp.status !== 200) {\n        throw host.error(\"E_NETWORK\", \"站点返回 HTTP \" + resp.status + \"：\" + url);\n    }\n    return str(resp.body);\n}\n\n// Port of the spider appendCards: scan href=\"/<id>\" links, dedupe, then\n// read title (first img alt) and cover (first usable img src) from the\n// 700 chars following each link.\nfunction parseCards(html, limit) {\n    const items = [];\n    if (!html || html.length < 200) return items;\n    const seen = {};\n    const re = /href=\"\\/(\\d{5,7})\"/g;\n    let m;\n    while ((m = re.exec(html)) !== null && items.length < limit) {\n        const id = m[1];\n        if (seen[id]) continue;\n        seen[id] = true;\n        const chunk = html.slice(m.index, Math.min(html.length, m.index + m[0].length + 700));\n        const altM = /<img[^>]*alt=\"([^\"]*)\"/.exec(chunk);\n        const title = altM ? unesc(altM[1]).trim() : \"\";\n        if (title.length < 1) continue;\n        let cover = \"\";\n        const imgRe = /<img[^>]*src=\"([^\"]+)\"/g;\n        let im;\n        while ((im = imgRe.exec(chunk)) !== null) {\n            const u = absUrl(im[1]);\n            if (u.indexOf(\"data:image\") < 0 && u.indexOf(\"logo\") < 0 && u.indexOf(\"http\") === 0) {\n                cover = u;\n                break;\n            }\n        }\n        const item = {id: HOST + \"/\" + id, title: title, remarks: \"PTT01\"};\n        if (cover) item.cover = cover;\n        items.push(item);\n    }\n    return items;\n}\n\nfunction qualityLabel(u) {\n    const s = str(u).toLowerCase();\n    if (s.indexOf(\"2160\") >= 0 || s.indexOf(\"4k\") >= 0) return \"4K\";\n    if (s.indexOf(\"1080\") >= 0) return \"1080P\";\n    if (s.indexOf(\"720\") >= 0) return \"720P\";\n    if (s.indexOf(\"480\") >= 0) return \"480P\";\n    if (s.indexOf(\"360\") >= 0) return \"360P\";\n    return \"Auto\";\n}\n\n// Port of the spider streams(): <source> tags first, else bare m3u8 URLs.\nfunction parseStreams(html) {\n    const out = [];\n    const seen = {};\n    const srcRe = /<source[^>]*src=\"([^\"]+)\"[^>]*>/gi;\n    let m;\n    while ((m = srcRe.exec(html)) !== null) {\n        let u = unesc(m[1]).trim();\n        if (u.length < 12) continue;\n        u = absUrl(u);\n        if (u.indexOf(\"http\") !== 0 || seen[u]) continue;\n        seen[u] = true;\n        out.push({name: u.toLowerCase().indexOf(\".m3u8\") < 0 ? qualityLabel(u) : \"HLS\", url: u});\n    }\n    if (!out.length) {\n        const mRe = /https?:\\/\\/[^\\s\"'<>]+?\\.m3u8[^\\s\"'<>]*/gi;\n        while ((m = mRe.exec(html)) !== null) {\n            const u = unesc(m[0]).trim();\n            if (seen[u]) continue;\n            seen[u] = true;\n            out.push({name: \"HLS\", url: u});\n        }\n    }\n    return out;\n}\n\nfunction firstMatch(html, re) {\n    const m = re.exec(html || \"\");\n    return m ? m[1].trim() : \"\";\n}\n\nexport default {\n    async home() {\n        const categories = CATS.map(c => ({id: c[0], name: c[1]}));\n        const html = await fetchPage(HOST + \"/p/1\");\n        const items = parseCards(html, 40);\n        return {categories: categories, items: items, hasMore: false};\n    },\n\n    async category(args) {\n        const id = str(args && args.id);\n        let page = parseInt(args && args.page, 10);\n        if (!isFinite(page) || page < 1) page = 1;\n        let tpl = \"/p/1?page=%d\";\n        for (const c of CATS) {\n            if (c[0] === id) { tpl = c[2]; break; }\n        }\n        const html = await fetchPage(HOST + tpl.replace(\"%d\", String(page)));\n        const items = parseCards(html, 72);\n        return {items: items, hasMore: items.length >= 12};\n    },\n\n    async search(args) {\n        const kw = str(args && args.keyword);\n        let page = parseInt(args && args.page, 10);\n        if (!isFinite(page) || page < 1) page = 1;\n        let url = HOST + \"/node/search?title=\" + encodeURIComponent(kw);\n        if (page > 1) url += \"&page=\" + page;\n        const html = await fetchPage(url);\n        const items = parseCards(html, 60);\n        return {items: items, hasMore: items.length >= 12};\n    },\n\n    async detail(args) {\n        let id = str(args && args.id).trim();\n        if (id.length < 6) throw host.error(\"E_PARSE\", \"详情 id 无效\");\n        if (id.charAt(0) === \"/\") id = HOST + id;\n        const html = await fetchPage(id);\n        let title = unesc(firstMatch(html, /<title>([\\s\\S]*?)<\\/title>/)).trim();\n        const cut = title.lastIndexOf(\" - \");\n        if (cut > 2) title = title.slice(0, cut).trim();\n        if (!title) title = \"PTT01 影视\";\n        let cover = unesc(firstMatch(html, /property=\"og:image\"[^>]*content=\"([^\"]*)\"/));\n        if (!cover) {\n            const imgRe = /<img[^>]*src=\"([^\"]+)\"/g;\n            let im;\n            while ((im = imgRe.exec(html)) !== null) {\n                const u = absUrl(im[1]);\n                if (u.indexOf(\"71352.men\") >= 0) { cover = u; break; }\n            }\n        } else {\n            cover = absUrl(cover);\n        }\n        const desc = unesc(firstMatch(html, /property=\"og:description\"[^>]*content=\"([^\"]*)\"/)).trim();\n        const streams = parseStreams(html);\n        if (!streams.length) {\n            throw host.error(\"E_PARSE\", \"详情页未取到播放地址\");\n        }\n        const episodes = streams.map(s => ({id: s.url, name: s.name}));\n        const out = {\n            id: id,\n            title: title,\n            desc: desc || \"\",\n            lines: [{name: \"PTT01·HLS\", episodes: episodes}],\n        };\n        if (cover) out.cover = cover;\n        return out;\n    },\n\n    async play(args) {\n        const url = str((args && (args.id || args.episodeId)) || \"\").trim();\n        if (!url || url.indexOf(\"http\") !== 0) {\n            throw host.error(\"E_PARSE\", \"播放 id 无效\");\n        }\n        const isHls = url.toLowerCase().indexOf(\".m3u8\") >= 0;\n        return {\n            streams: [{\n                url: url,\n                format: isHls ? \"hls\" : \"auto\",\n                headers: {\"User-Agent\": UA, \"Referer\": HOST + \"/\"},\n            }],\n        };\n    },\n};\n"}}