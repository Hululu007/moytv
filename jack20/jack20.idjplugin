{"manifest":{"schema":1,"id":"com.idj.ext.jack20","name":"後宮電影院","version":"1.0.0","author":{"name":"py 蜘蛛改写"},"description":"後宮電影院（xvideos 聚合）。10 个分类与内置蜘蛛硬编码表 1:1，且与站点现行导航（标签云/菜单）逐项核对一致：最新影片加日本無碼/歐美短片/國語長片/日本有碼/卡通短片/其它短片/其他長片/卡通長片/歐美長片；列表页 <article data-post-id> 卡片正则直取、详情页 player-x.php 的 base64 令牌解出 xvideos 嵌入地址、播放时现抓嵌入页取 setVideoHLS/setVideoUrlHigh/setVideoUrlLow 直链（HLS 线与 MP4 线双线路），照原蜘蛛 1:1 复刻。由内置 jar 蜘蛛 ZakaJack20Amns 改写。","type":"video","adult":true,"language":["zh"],"minAppVersion":"1.5","entry":"main.js","permissions":{"http":["20jack.com","www.xvideos.com"],"media":["20jack.com","www.xvideos.com","*.xvideos-cdn.com"],"cloudflare":false,"storage":false,"login":false},"capabilities":["home","category","search","detail","play"],"settings":[],"update":{"url":"https://raw.githubusercontent.com/hoyittvggfh45/moytv/plugins/jack20/jack20.idjplugin"},"integrity":"sha256-DEXAWGnDpvl1A0+6WIW6BdQo6oG6vaM/J2VJPWhEUhI="},"files":{"main.js":"// jack20 - idj1 plugin, rewritten from the built-in jar spider\n// com.github.catvod.spider.ZakaJack20Amns (registry key jack20,\n// name \"🔞🆕後宮電影院┃xvideos聚合\", ext empty). WordPress site\n// https://20jack.com aggregating xvideos embeds: list pages carry\n// <article ... data-post-id=\"N\"> cards (href /?p=N, <a title>,\n// img.video-main-thumb cover, views/duration spans), category\n// pages are /?cat=<id>, search is /?s=<kw>, and the detail page\n// /?p=<id> carries a player-x.php?q=<base64> token whose decoded\n// payload is an xvideos embed iframe URL; play fetches that embed\n// page and picks setVideoHLS / setVideoUrlHigh / setVideoUrlLow.\n// All of that is copied 1:1 from the spider. Live check on\n// 2026-11-26: the site's own category navigation (tag cloud and\n// menu links) is exactly the spider's hardcoded 9-category table\n// with the same ids and names, so the table below matches the\n// live navigation 1:1. The spider's playerContent falls back to\n// parse=1 (shell web sniffing) when the embed page yields no\n// direct stream; the plugin sandbox cannot do that, so play\n// throws instead (documented in verdict.json).\n\nconst HOSTS = [\"https://20jack.com\"];\nconst UA = \"Mozilla/5.0 (Linux; Android 12) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Mobile Safari/537.36\";\nconst PAGE = 36;\nconst TIMEOUT = 55000;\nconst ATTEMPTS = 3;\n\nconst CATS = [\n    [\"home\", \"最新影片\"],\n    [\"6364\", \"日本無碼\"],\n    [\"788\", \"歐美短片\"],\n    [\"3419\", \"國語長片\"],\n    [\"6365\", \"日本有碼\"],\n    [\"4071\", \"卡通短片\"],\n    [\"6404\", \"其它短片\"],\n    [\"819\", \"其他長片\"],\n    [\"5346\", \"卡通長片\"],\n    [\"5422\", \"歐美長片\"],\n];\nconst CAT_IDS = {};\nfor (const pair of CATS) CAT_IDS[pair[0]] = true;\n\nfunction str(v) { return v == null ? \"\" : String(v); }\nfunction intVal(v, fb) { const n = parseInt(v, 10); return isFinite(n) ? n : fb; }\n\nfunction unesc(s) {\n    if (s == null) return \"\";\n    let out = String(s)\n        .replace(/&amp;/g, \"&\").replace(/&lt;/g, \"<\").replace(/&gt;/g, \">\")\n        .replace(/&quot;/g, \"\\\"\").replace(/&#039;/g, \"'\").replace(/&apos;/g, \"'\")\n        .replace(/&nbsp;/g, \" \").replace(/&hellip;/g, \"…\").replace(/&mdash;/g, \"—\")\n        .replace(/&ndash;/g, \"–\").replace(/&rsquo;/g, \"’\").replace(/&lsquo;/g, \"‘\")\n        .replace(/&ldquo;/g, \"“\").replace(/&rdquo;/g, \"”\").replace(/&middot;/g, \"·\");\n    out = out.replace(/&#(x?)([0-9a-fA-F]+);/g, (m, x, digits) => {\n        const code = x ? parseInt(digits, 16) : parseInt(digits, 10);\n        if (code > 0 && code <= 0x10FFFF) {\n            try { return String.fromCodePoint(code); } catch (e) { return m; }\n        }\n        return m;\n    });\n    return out;\n}\n\nfunction strip(s) {\n    if (s == null) return \"\";\n    try {\n        return unesc(String(s)\n            .replace(/<script[\\s\\S]*?<\\/script>/gi, \" \")\n            .replace(/<[^>]+>/g, \" \"))\n            .replace(/ /g, \" \")\n            .replace(/\\s+/g, \" \")\n            .trim();\n    } catch (e) {\n        return \"\";\n    }\n}\n\nfunction pageHeaders(hostBase) {\n    const h = {\n        \"User-Agent\": UA,\n        \"Accept\": \"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\",\n        \"Accept-Language\": \"zh-TW,zh;q=0.9,en;q=0.8\",\n    };\n    if (hostBase) h[\"Referer\"] = hostBase + \"/\";\n    return h;\n}\n\nasync function fetchBody(url, headers, attempts) {\n    let lastErr = null;\n    const n = attempts || ATTEMPTS;\n    for (let i = 0; i < n; i++) {\n        try {\n            const resp = await host.http.get(url, {headers: headers || {}, timeout: TIMEOUT});\n            if (resp && resp.body) return String(resp.body);\n            lastErr = new Error(\"http \" + (resp ? resp.status : \"no response\") + \" \" + url);\n        } catch (e) {\n            lastErr = e;\n        }\n    }\n    if (lastErr) host.log(\"jack20 fetch failed\", url, String(lastErr && lastErr.message));\n    return \"\";\n}\n\n// Spider html(): try each host in order, accept the first body of\n// at least 1200 chars containing the needle.\nasync function html(path, needle) {\n    for (const base of HOSTS) {\n        const body = await fetchBody(base + path, pageHeaders(base), 2);\n        if (body && body.length >= 1200 && (!needle || body.indexOf(needle) >= 0)) return body;\n    }\n    return \"\";\n}\n\n// Spider cards(): split on \"<article\", each chunk capped at 4000\n// chars; id from id=\"post-N\" / class post-N / data-post-id; a card\n// only counts when it carries an href=\"...?p=N\" link; title from\n// <a title=\"...\">; cover from img.video-main-thumb src/data-src,\n// then data-main-thumb, then the first entry of data-thumbs, then\n// the last plain src that is not an xvideos-cdn / uploads /\n// 18jenny URL; remarks combine duration and view count.\nfunction parseCards(pageHtml) {\n    const out = [];\n    if (!pageHtml || pageHtml.length < 800) return out;\n    const chunks = String(pageHtml).split(\"<article\");\n    for (let i = 1; i < chunks.length; i++) {\n        try {\n            let chunk = chunks[i];\n            if (chunk.length > 4000) chunk = chunk.slice(0, 4000);\n            let id = \"\";\n            let m = /id=\"post-(\\d+)\"/.exec(chunk);\n            if (m) id = m[1];\n            if (!id) {\n                m = /class=\"[^\"]*\\bpost-(\\d+)\\b/.exec(chunk);\n                if (m) id = m[1];\n            }\n            if (!id) {\n                m = /data-post-id=\"(\\d+)\"/.exec(chunk);\n                if (m) id = m[1];\n            }\n            if (!id) continue;\n            const href = /<a[^>]*href=\"([^\"]*\\?p=(\\d+))\"/.exec(chunk);\n            if (!href || !href[1]) continue;\n            const tm = /<a[^>]*title=\"([^\"]{1,400})\"/.exec(chunk);\n            let title = tm ? unesc(tm[1]) : \"\";\n            let cover = \"\";\n            const img = /<img[^>]*class=\"[^\"]*video-main-thumb[^\"]*\"[^>]*>/.exec(chunk);\n            if (img) {\n                const sm = /src=\"([^\"]+)\"/.exec(img[0]);\n                if (sm) cover = sm[1];\n                if (!cover) {\n                    const lm = /data-src=\"([^\"]+)\"/.exec(img[0]);\n                    if (lm) cover = lm[1];\n                }\n            }\n            if (!cover) {\n                const mm = /data-main-thumb=\"([^\"]+)\"/.exec(chunk);\n                if (mm) cover = mm[1];\n            }\n            if (!cover) {\n                const th = /data-thumbs=\"([^\"]+)\"/.exec(chunk);\n                if (th) {\n                    const raw = th[1];\n                    const cut = raw.indexOf(\",\");\n                    cover = cut > 0 ? raw.slice(0, cut) : raw;\n                }\n            }\n            if (!cover) {\n                const srcRe = /src=\"([^\"]+)\"/g;\n                let sm2;\n                let lastAny = \"\";\n                while ((sm2 = srcRe.exec(chunk)) !== null) {\n                    lastAny = sm2[1];\n                    if (sm2[1].indexOf(\"xvideos-cdn\") < 0 &&\n                        sm2[1].indexOf(\"/wp-content/uploads/\") < 0 &&\n                        sm2[1].indexOf(\"18jenny\") < 0) {\n                        cover = sm2[1];\n                    }\n                }\n                if (!cover) cover = lastAny;\n            }\n            const vm = /<span class=\"views\">([\\s\\S]*?)<\\/span>/.exec(chunk);\n            let views = vm ? strip(vm[1]).split(\"views\").join(\"\").trim() : \"\";\n            const dm = /<span class=\"duration\">([\\s\\S]*?)<\\/span>/.exec(chunk);\n            let remarks = dm ? strip(dm[1]).trim() : \"\";\n            if (views) remarks = (remarks ? remarks + \" · \" : \"\") + views + \"次\";\n            out.push({\n                id: id,\n                title: title || (\"影片 \" + id),\n                cover: cover,\n                remarks: remarks,\n            });\n        } catch (e) {}\n    }\n    return out;\n}\n\nfunction pageCountOf(body, page) {\n    let pc = page + 1;\n    if (!body) return pc;\n    const re = /paged=(\\d+)\"[^>]*>(?:\\d+|Next|»)/gi;\n    let m;\n    let max = 0;\n    while ((m = re.exec(body)) !== null) {\n        const n = parseInt(m[1], 10);\n        if (isFinite(n) && n > max) max = n;\n    }\n    if (max > 0) pc = max;\n    return pc;\n}\n\nasync function home() {\n    const categories = CATS.map((pair) => ({id: pair[0], name: pair[1]}));\n    let body = await html(\"/?filter=latest\", \"data-post-id\");\n    if (!body) body = await html(\"/\", \"data-post-id\");\n    const items = parseCards(body);\n    return {categories: categories, items: items, hasMore: items.length > 0};\n}\n\nasync function category(arg) {\n    const page = Math.max(1, intVal(arg && arg.page, 1));\n    let tid = str(arg && arg.id).trim();\n    if (!tid) tid = \"home\";\n    if (!CAT_IDS[tid]) throw new Error(\"jack20 unknown category \" + tid);\n    let path;\n    if (tid === \"home\") path = \"/?filter=latest\";\n    else path = \"/?cat=\" + tid;\n    if (page > 1) path += \"&paged=\" + page;\n    const body = await html(path, \"data-post-id\");\n    const items = parseCards(body);\n    const pc = pageCountOf(body, page);\n    return {items: items, hasMore: page < pc};\n}\n\nasync function search(arg) {\n    const keyword = str(arg && arg.keyword).trim();\n    if (!keyword) return {items: [], hasMore: false};\n    const page = Math.max(1, intVal(arg && arg.page, 1));\n    let path = \"/?s=\" + encodeURIComponent(keyword);\n    if (page > 1) path += \"&paged=\" + page;\n    const items = parseCards(await html(path, \"data-post-id\"));\n    return {items: items, hasMore: items.length >= PAGE};\n}\n\nfunction metaOf(pageHtml, key) {\n    if (!pageHtml) return \"\";\n    let m = new RegExp(\"<meta[^>]*(?:property|name)=\\\"\" + key + \"\\\"[^>]*content=\\\"([^\\\"]*)\\\"\").exec(pageHtml);\n    if (m) return unesc(m[1]);\n    m = new RegExp(\"<meta[^>]*content=\\\"([^\\\"]*)\\\"[^>]*(?:property|name)=\\\"\" + key + \"\\\"\").exec(pageHtml);\n    if (m) return unesc(m[1]);\n    return \"\";\n}\n\nfunction urlDecode(s) {\n    const t = String(s).replace(/\\+/g, \" \");\n    try {\n        return decodeURIComponent(t);\n    } catch (e) {\n        return t.replace(/%([0-9a-fA-F]{2})/g, (m, hex) => String.fromCharCode(parseInt(hex, 16)));\n    }\n}\n\nfunction b64Decode(s) {\n    try {\n        const out = host.codec.base64Decode(String(s), {to: \"utf8\"});\n        if (out) return out;\n    } catch (e) {}\n    try {\n        return host.codec.base64Decode(String(s).replace(/-/g, \"+\").replace(/_/g, \"/\"), {to: \"utf8\"});\n    } catch (e) {}\n    return \"\";\n}\n\nfunction b64Encode(s) {\n    try {\n        return host.codec.base64Encode(String(s));\n    } catch (e) {\n        return \"\";\n    }\n}\n\n// Spider embedUrl(): base64-decode the player token, URL-decode\n// the payload, then take the iframe src (or the first bare URL).\nfunction embedUrl(token) {\n    let decoded = b64Decode(token);\n    if (!decoded || decoded.length < 20) return \"\";\n    const plain = urlDecode(decoded);\n    const sm = /src=\"([^\"]+)\"/.exec(plain);\n    if (sm) return sm[1].trim();\n    const um = /(https?:\\/\\/[^\"'\\s<>]+)/.exec(plain);\n    if (um) return um[1];\n    return \"\";\n}\n\nasync function detail(arg) {\n    let raw = str(arg && arg.id).trim();\n    // Spider num(): an id may carry a \"<prefix>:<number>\" form.\n    let numStr = raw;\n    const colon = numStr.indexOf(\":\");\n    if (colon >= 0) numStr = numStr.slice(colon + 1);\n    const idNum = parseInt(numStr, 10);\n    if (!isFinite(idNum) || idNum <= 0) throw new Error(\"jack20 invalid id \" + raw);\n    const body = await html(\"/?p=\" + idNum, \"<article\");\n    let title = \"\";\n    let pic = \"\";\n    let date = \"\";\n    let desc = \"\";\n    let token = \"\";\n    if (body) {\n        title = metaOf(body, \"og:title\");\n        if (!title) {\n            const h1 = /<h1[^>]*>([\\s\\S]*?)<\\/h1>/.exec(body);\n            if (h1) title = unesc(strip(h1[1]));\n        }\n        pic = metaOf(body, \"og:image\");\n        const dm = /itemprop=\"uploadDate\"[^>]*content=\"([^\"]+)\"/.exec(body);\n        if (dm) date = dm[1];\n        const cm = /name=\"description\"[^>]*content=\"([^\"]*)\"/.exec(body);\n        if (cm) desc = unesc(cm[1]);\n        const pm = /player-x\\.php\\?q=([A-Za-z0-9+/=]+)/.exec(body);\n        if (pm) token = pm[1];\n        if (!token) {\n            const cm2 = /clean-tube-player[^\"'\\\\s]*\\?q=([A-Za-z0-9+/=]+)/.exec(body);\n            if (cm2) token = cm2[1];\n        }\n    }\n    if (!title) title = \"後宮 #\" + idNum;\n    const embed = token && token.length > 12 ? embedUrl(token) : \"\";\n    const lines = [];\n    if (embed && embed.length > 12) {\n        const epId = b64Encode(embed);\n        if (epId) {\n            lines.push({name: \"線路①HLS\", episodes: [{id: epId, name: \"正片\"}]});\n            lines.push({name: \"線路②MP4\", episodes: [{id: epId, name: \"正片\"}]});\n        }\n    }\n    return {\n        id: raw,\n        title: title,\n        cover: pic,\n        desc: desc,\n        year: date.length >= 4 ? date.slice(0, 4) : \"\",\n        remarks: date.length >= 10 ? date.slice(5, 10) : \"\",\n        lines: lines,\n    };\n}\n\nfunction pick(pageHtml, re) {\n    const m = re.exec(pageHtml);\n    if (!m) return \"\";\n    let v = m[1];\n    if (v.indexOf(\"//\") === 0) v = \"https:\" + v;\n    return v.split(\"\\\\/\").join(\"/\");\n}\n\nfunction originOf(url) {\n    const m = /^([a-z][a-z0-9+.-]*:\\/\\/[^/]+)/i.exec(String(url));\n    return m ? m[1] + \"/\" : \"https://www.xvideos.com/\";\n}\n\n// Spider resolve(): fetch the xvideos embed page and pick the\n// direct stream. The MP4 line prefers UrlHigh, then UrlLow, then\n// HLS; the HLS line prefers HLS, then UrlHigh, then UrlLow; then\n// any quoted .m3u8, then any quoted .mp4 in the page.\nasync function resolve(embed, flag) {\n    let target = String(embed || \"\").trim();\n    if (!target) return \"\";\n    if (target.indexOf(\"//\") === 0) target = \"https:\" + target;\n    const headers = {\n        \"User-Agent\": UA,\n        \"Accept\": \"text/html,application/xhtml+xml,*/*;q=0.8\",\n        \"Accept-Language\": \"en-US,en;q=0.9,zh-TW;q=0.8\",\n        \"Referer\": originOf(target),\n    };\n    const body = await fetchBody(target, headers, 2);\n    if (!body || body.length < 500) return \"\";\n    const wantMp4 = flag != null && String(flag).indexOf(\"MP4\") >= 0;\n    const hls = pick(body, /setVideoHLS\\(\\s*[\"']([^\"']+)[\"']/);\n    const high = pick(body, /setVideoUrlHigh\\(\\s*[\"']([^\"']+)[\"']/);\n    const low = pick(body, /setVideoUrlLow\\(\\s*[\"']([^\"']+)[\"']/);\n    const order = wantMp4 ? [high, low, hls] : [hls, high, low];\n    for (const cand of order) {\n        if (cand && cand.length > 12) return cand;\n    }\n    const m1 = pick(body, /[\"'](https?:\\/\\/[^\"'\\s<>]+?\\.m3u8[^\"'\\s<>]*)[\"']/);\n    if (m1 && m1.length > 12) return m1;\n    const m2 = pick(body, /[\"'](https?:\\/\\/[^\"'\\s<>]+?\\.mp4[^\"'\\s<>]*)[\"']/);\n    if (m2 && m2.length > 12) return m2;\n    return \"\";\n}\n\nfunction resolveRelative(base, rel) {\n    const r = str(rel).trim();\n    if (!r) return base;\n    if (/^https?:\\/\\//i.test(r)) return r;\n    if (r.indexOf(\"//\") === 0) return \"https:\" + r;\n    if (r.charAt(0) === \"/\") {\n        const m = /^(https?:\\/\\/[^/]+)/i.exec(base);\n        return (m ? m[1] : \"\") + r;\n    }\n    const cut = base.lastIndexOf(\"/\");\n    return (cut >= 0 ? base.slice(0, cut + 1) : base) + r;\n}\n\n// play()-side master-playlist pre-resolution, string ops only\n// (the sandbox has no URL global).\nasync function resolveMaster(url, headers) {\n    const text = await fetchBody(url, headers, 2);\n    if (!text || text.indexOf(\"#EXT-X-STREAM-INF\") < 0) return url;\n    const lines = text.split(/\\r?\\n/).map((s) => s.trim()).filter((s) => s.length > 0);\n    for (let i = 0; i < lines.length; i++) {\n        if (lines[i].indexOf(\"#EXT-X-STREAM-INF\") === 0) {\n            for (let j = i + 1; j < lines.length; j++) {\n                if (lines[j].charAt(0) !== \"#\") return resolveRelative(url, lines[j]);\n            }\n        }\n    }\n    return url;\n}\n\nasync function play(arg) {\n    let raw = str((arg && arg.episodeId) || (arg && arg.id) || \"\").trim();\n    if (raw.indexOf(\"$\") >= 0) raw = raw.split(\"$\").pop() || \"\";\n    const flag = str(arg && arg.line);\n    let embed = \"\";\n    if (raw.indexOf(\"http\") === 0) {\n        embed = raw;\n    } else {\n        embed = b64Decode(raw);\n    }\n    if (!embed || embed.length <= 12) throw new Error(\"jack20 no embed url\");\n    let url = await resolve(embed, flag);\n    if (!url || url.length < 12) throw new Error(\"jack20 resolve failed for \" + embed);\n    if (url.indexOf(\"http://\") === 0) url = \"https://\" + url.slice(7);\n    if (!/^https:\\/\\//i.test(url)) throw new Error(\"jack20 stream is not https: \" + url);\n    // Spider playerContent sends only the UA header with the stream.\n    const headers = {\"User-Agent\": UA};\n    let finalUrl = url;\n    if (/\\.m3u8($|\\?)/i.test(url)) {\n        finalUrl = await resolveMaster(url, headers);\n    }\n    return {\n        streams: [{\n            url: finalUrl,\n            format: /\\.m3u8($|\\?)/i.test(finalUrl) ? \"hls\" : \"mp4\",\n            headers: headers,\n            name: \"後宮電影院\",\n        }],\n        expiresAt: Date.now() + 3600 * 1000,\n    };\n}\n\nexport default {home, category, search, detail, play};\n"}}