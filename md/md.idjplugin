{"manifest":{"schema":1,"id":"com.idj.ext.md","name":"麻豆","version":"1.0.0","author":{"name":"py 蜘蛛改写"},"description":"麻豆（麻豆传媒系接口站 spi.d5c4a712.com，非 LissAV）。60 个分类与内置蜘蛛硬编码导航表 1:1（最新/麻豆传媒映画/乐播传媒/91制作/SWAG/糖心/天美传媒/蜜桃传媒等），接口为 AES-256-CBC 加密请求体加 MD5 签名协议（照原蜘蛛 1:1 复刻），列表只留免费条目（全页皆付费时才收付费条目并标「付费」），封面直出原图（原蜘蛛图片工场 mdimg.ystv.top 现回 429 额度错误、原图直拉已验 200），播放为 https m3u8、play 内主清单预解析。由内置 jar 蜘蛛 ZakaMdAmns 改写。","type":"video","adult":true,"language":["zh"],"minAppVersion":"1.5","entry":"main.js","permissions":{"http":["spi.d5c4a712.com","mdimg.ystv.top"],"media":["spi.d5c4a712.com","mdimg.ystv.top","*.n123dx.xyz","*.n6uem8.xyz"],"cloudflare":false,"storage":true,"login":false},"capabilities":["home","category","search","detail","play"],"settings":[],"update":{"url":"https://raw.githubusercontent.com/hoyittvggfh45/moytv/plugins/md/md.idjplugin"},"integrity":"sha256-HpURiwic5icq6Qsb+eqY5PTyP6Fm1GHBkpBQmtPykZw="},"files":{"main.js":"// md (madou) - idj1 plugin, rewritten from the built-in jar spider\n// com.github.catvod.spider.ZakaMdAmns (registry key ZakaMd, name\n// \"🔞麻豆\", ext empty). This is the Madou-media API station at\n// https://spi.d5c4a712.com -- NOT the LissAV web station (a different\n// registry entry, excluded on the hard-line list). Protocol copied 1:1\n// from the spider: POST form body \"post-data=\" + urlencoded\n// base64(AES-256-CBC/PKCS7(JSON of sorted params + timestamp +\n// encode_sign)), where encode_sign = md5hex(sorted \"k=v&...\" string +\n// SIGN_TAIL), the IV is IV_PREFIX + a 6-hex-char suffix (md5 of the\n// current millis, also sent as the \"suffix\" header), and the JSON\n// response {data, suffix} decrypts the same way with the response\n// suffix. Lists keep the spider's card filter: non-VIP items with an\n// id, a video_url and a title (title falls back to description); if a\n// page yields nothing, VIP items are admitted with a \"付费\" remark\n// (detail then carries no playable episode for them, same as the\n// spider). Covers: the spider routes thumbs through its image worker\n// https://mdimg.ystv.top/img?u=<urlencoded thumb>, but that worker\n// currently answers 429 \"error code: 1027\" (Cloudflare Workers quota)\n// on every attempt from here, while the raw thumb URL itself verifies\n// 200 image/jpeg, so the plugin emits the raw thumb directly (the\n// worker host stays in the allowlist). Detail/play read\n// the raw list item from the plugin cache (in-memory + host storage),\n// exactly like the spider's in-memory cache. Categories are the\n// spider's hardcoded 60-entry table, unchanged.\n\nconst BASE = \"https://spi.d5c4a712.com\";\nconst IMG_WORKER = \"https://mdimg.ystv.top\";\nconst UA = \"Mozilla/5.0 (Linux; Android 13; Pixel 7) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Mobile Safari/537.36\";\nconst AES_KEY = \"Vq234zBeSdGgYXzVTEfnnjjdmaTkk7A4\";\nconst IV_PREFIX = \"-p9B[~PnPs\";\nconst SIGN_TAIL = \"&m}q%ea6:LDcmS?aK)CeF287bPvd99@E,9Up^\";\nconst TIMEOUT = 60000;\nconst ATTEMPTS = 3;\n\nconst CATS = [\n    [\"latest\", \"最新\"],\n    [\"21\", \"麻豆传媒映画\"],\n    [\"101\", \"乐播传媒\"],\n    [\"20\", \"91制作\"],\n    [\"51\", \"91茄子\"],\n    [\"23\", \"探花系列\"],\n    [\"14\", \"SWAG\"],\n    [\"39\", \"日本AV-4K\"],\n    [\"38\", \"JVID\"],\n    [\"40\", \"国产三级片\"],\n    [\"41\", \"推特福利姬\"],\n    [\"52\", \"恋脚癖\"],\n    [\"64\", \"糖心\"],\n    [\"65\", \"兔子先生\"],\n    [\"74\", \"天美传媒\"],\n    [\"75\", \"蜜桃传媒\"],\n    [\"76\", \"皇家华人\"],\n    [\"77\", \"杏吧原创\"],\n    [\"80\", \"mini传媒\"],\n    [\"81\", \"大象传媒\"],\n    [\"82\", \"葫芦影业\"],\n    [\"87\", \"91短视频\"],\n    [\"33\", \"恐怖色情\"],\n    [\"35\", \"人妖\"],\n    [\"50\", \"高清动漫\"],\n    [\"26\", \"性爱课堂\"],\n    [\"27\", \"maomiav\"],\n    [\"53\", \"AI换脸\"],\n    [\"54\", \"Elise 兔兔\"],\n    [\"55\", \"Pornhub\"],\n    [\"56\", \"Team Skeet\"],\n    [\"57\", \"Wow girls\"],\n    [\"58\", \"不见星空\"],\n    [\"59\", \"刘玥\"],\n    [\"60\", \"国产直播\"],\n    [\"61\", \"果冻传媒\"],\n    [\"62\", \"精东影业\"],\n    [\"66\", \"玩偶姐姐\"],\n    [\"67\", \"网爆门事件\"],\n    [\"68\", \"星空传媒\"],\n    [\"69\", \"柚子猫\"],\n    [\"70\", \"ASMR\"],\n    [\"71\", \"Sxyporn\"],\n    [\"72\", \"XVideos\"],\n    [\"73\", \"Brazzers\"],\n    [\"78\", \"AV解说\"],\n    [\"79\", \"韩国R级\"],\n    [\"83\", \"COSPLAY\"],\n    [\"84\", \"拳交女王\"],\n    [\"86\", \"周甄娜\"],\n    [\"88\", \"猎奇系列\"],\n    [\"91\", \"软萌伪娘\"],\n    [\"93\", \"性爱娃娃\"],\n    [\"94\", \"约炮小百科\"],\n    [\"95\", \"xiao e\"],\n    [\"96\", \"Vivian\"],\n    [\"98\", \"海外直播\"],\n    [\"15\", \"性视界传媒\"],\n    [\"99\", \"爱豆传媒\"],\n    [\"100\", \"香蕉视频\"],\n];\nconst CAT_IDS = {};\nfor (const pair of CATS) CAT_IDS[pair[0]] = true;\n\nconst cache = {};\n\nfunction str(v) { return v == null ? \"\" : String(v); }\nfunction intVal(v, fb) { const n = parseInt(v, 10); return isFinite(n) ? n : fb; }\n\nfunction md5hex(s) {\n    return host.crypto.md5(s, {in: \"utf8\", out: \"hex\"});\n}\n\nasync function call(path, params) {\n    let lastErr = null;\n    for (let attempt = 0; attempt < ATTEMPTS; attempt++) {\n        try {\n            const merged = {};\n            for (const k of Object.keys(params || {})) merged[k] = str(params[k]);\n            merged[\"timestamp\"] = String(Date.now());\n            const keys = Object.keys(merged).sort();\n            const signStr = keys.map((k) => k + \"=\" + merged[k]).join(\"&\");\n            merged[\"encode_sign\"] = md5hex(signStr + SIGN_TAIL);\n            const ordered = {};\n            for (const k of Object.keys(merged).sort()) ordered[k] = merged[k];\n            const plain = JSON.stringify(ordered);\n            const suffix = md5hex(String(Date.now())).slice(0, 6);\n            const enc = host.crypto.aes({\n                op: \"encrypt\", mode: \"cbc\", key: AES_KEY, keyEncoding: \"utf8\",\n                iv: IV_PREFIX + suffix, ivEncoding: \"utf8\",\n                data: plain, in: \"utf8\", out: \"base64\",\n            });\n            const body = \"post-data=\" + encodeURIComponent(enc);\n            const resp = await host.http.post(BASE + path, body, {\n                headers: {\n                    \"User-Agent\": UA,\n                    \"suffix\": suffix,\n                    \"Content-Type\": \"application/x-www-form-urlencoded\",\n                },\n                timeout: TIMEOUT,\n            });\n            if (!resp || resp.status !== 200 || !resp.body) {\n                throw new Error(\"md http \" + (resp ? resp.status : \"no response\"));\n            }\n            const j = JSON.parse(resp.body);\n            if (!j || !j.data) throw new Error(\"md bad response envelope\");\n            const dec = host.crypto.aes({\n                op: \"decrypt\", mode: \"cbc\", key: AES_KEY, keyEncoding: \"utf8\",\n                iv: IV_PREFIX + str(j.suffix), ivEncoding: \"utf8\",\n                data: str(j.data), in: \"base64\", out: \"utf8\",\n            });\n            return JSON.parse(dec);\n        } catch (e) {\n            lastErr = e;\n        }\n    }\n    throw lastErr || new Error(\"md request failed\");\n}\n\nfunction img(thumb) {\n    const s = str(thumb);\n    if (!s) return \"\";\n    // Spider: IMG_WORKER + \"/img?u=\" + encodeURIComponent(s). The worker\n    // is quota-dead right now (429 / error 1027, verified repeatedly);\n    // the raw thumb verifies fine, so emit it directly.\n    return s;\n}\n\nfunction cachePut(obj) {\n    const id = str(obj && obj.id);\n    if (!id) return;\n    cache[id] = obj;\n    try { host.storage.set(\"it:\" + id, JSON.stringify(obj)); } catch (e) {}\n}\n\nfunction cacheGet(id) {\n    const k = str(id);\n    if (cache[k]) return cache[k];\n    try {\n        const raw = host.storage.get(\"it:\" + k);\n        if (raw) {\n            const obj = JSON.parse(raw);\n            cache[k] = obj;\n            return obj;\n        }\n    } catch (e) {}\n    return null;\n}\n\nfunction card(obj, allowVip) {\n    if (!obj) return null;\n    const vip = intVal(obj.is_vip, 0) !== 0;\n    if (vip && !allowVip) return null;\n    const id = str(obj.id);\n    const url = str(obj.video_url);\n    if (!id || !url) return null;\n    let title = str(obj.title);\n    if (!title) title = str(obj.description);\n    if (!title) return null;\n    const tagNames = [];\n    const tags = Array.isArray(obj.tags) ? obj.tags : [];\n    for (const t of tags) {\n        const n = str(t && t.name);\n        if (n) tagNames.push(n);\n    }\n    cachePut(obj);\n    return {\n        id: id,\n        title: title,\n        cover: img(obj.thumb),\n        remarks: vip ? \"付费\" : tagNames.join(\"·\"),\n        tags: tagNames,\n    };\n}\n\nfunction cards(arr) {\n    const list = Array.isArray(arr) ? arr : [];\n    let out = [];\n    for (const obj of list) {\n        const c = card(obj, false);\n        if (c) out.push(c);\n    }\n    if (out.length === 0) {\n        for (const obj of list) {\n            const c = card(obj, true);\n            if (c) out.push(c);\n        }\n    }\n    return out;\n}\n\nasync function listPage(channel, page) {\n    const params = {list_row: \"60\", page: String(page), type: \"2\"};\n    const ch = str(channel);\n    if (ch && ch !== \"latest\") params[\"channel\"] = ch;\n    const root = await call(\"/video/listcache\", params);\n    const data = (root && root.data) || {};\n    const items = cards(data.data);\n    const lastPage = intVal(data.last_page, page);\n    return {items: items, hasMore: page < lastPage, total: intVal(data.total, items.length)};\n}\n\nasync function home() {\n    const categories = CATS.map((pair) => ({id: pair[0], name: pair[1]}));\n    let items = [];\n    try {\n        items = (await listPage(\"21\", 1)).items;\n    } catch (e) {\n        items = [];\n    }\n    return {categories: categories, items: items, hasMore: items.length > 0};\n}\n\nasync function category(arg) {\n    const page = Math.max(1, intVal(arg && arg.page, 1));\n    const tid = str(arg && arg.id).trim() || \"latest\";\n    if (!CAT_IDS[tid]) throw new Error(\"md unknown category \" + tid);\n    const r = await listPage(tid, page);\n    return {items: r.items, hasMore: r.hasMore};\n}\n\nasync function search(arg) {\n    const keyword = str(arg && arg.keyword).trim();\n    if (!keyword) return {items: [], hasMore: false};\n    const page = Math.max(1, intVal(arg && arg.page, 1));\n    const root = await call(\"/video/list\", {list_row: \"60\", page: String(page), keyword: keyword});\n    const data = (root && root.data) || {};\n    const items = cards(data.data);\n    const lastPage = intVal(data.last_page, page);\n    return {items: items, hasMore: page < lastPage};\n}\n\nasync function detail(arg) {\n    const id = str(arg && arg.id).trim();\n    if (!id) throw new Error(\"invalid video id\");\n    const obj = cacheGet(id);\n    let title = obj ? (str(obj.title) || str(obj.description)) : \"\";\n    if (!title) title = \"视频\" + id;\n    const vip = obj ? intVal(obj.is_vip, 0) !== 0 : false;\n    const url = obj ? str(obj.video_url) : \"\";\n    const episodes = [];\n    if (!vip && url) {\n        episodes.push({id: \"play:\" + url, name: \"正片\"});\n    }\n    return {\n        id: id,\n        title: title,\n        cover: obj ? img(obj.thumb) : \"\",\n        desc: obj ? str(obj.description) : \"\",\n        tags: [],\n        lines: episodes.length ? [{name: \"麻豆\", episodes: episodes}] : [],\n    };\n}\n\nasync function fetchRaw(url, headers) {\n    try {\n        const resp = await host.http.get(url, {headers: headers || {}, timeout: TIMEOUT});\n        if (resp && resp.status === 200 && resp.body) return String(resp.body);\n    } catch (e) {\n        // fall through\n    }\n    return \"\";\n}\n\nasync function resolveMaster(url, headers) {\n    const text = await fetchRaw(url, headers);\n    if (!text || text.indexOf(\"#EXT-X-STREAM-INF\") < 0) return url;\n    const lines = text.split(/\\r?\\n/).map((s) => s.trim()).filter((s) => s.length > 0);\n    for (let i = 0; i < lines.length; i++) {\n        if (lines[i].indexOf(\"#EXT-X-STREAM-INF\") === 0) {\n            for (let j = i + 1; j < lines.length; j++) {\n                if (lines[j].charAt(0) !== \"#\") {\n                    try {\n                        return new URL(lines[j], url).href;\n                    } catch (e) {\n                        return url;\n                    }\n                }\n            }\n        }\n    }\n    return url;\n}\n\nasync function play(arg) {\n    let raw = str((arg && arg.episodeId) || (arg && arg.id) || \"\");\n    if (raw.indexOf(\"$\") >= 0) raw = raw.split(\"$\").pop() || \"\";\n    let url = \"\";\n    if (raw.indexOf(\"play:\") === 0) {\n        url = raw.slice(5);\n    } else if (/^https?:\\/\\//i.test(raw)) {\n        url = raw;\n    } else {\n        const obj = cacheGet(raw);\n        if (obj) url = str(obj.video_url);\n    }\n    if (!url || !/^https:\\/\\//i.test(url)) throw new Error(\"md no playable url\");\n    const headers = {\"User-Agent\": UA, \"Referer\": BASE + \"/\"};\n    let finalUrl = url;\n    if (/\\.m3u8($|\\?)/i.test(url)) {\n        finalUrl = await resolveMaster(url, headers);\n    }\n    return {\n        streams: [{\n            url: finalUrl,\n            format: /\\.m3u8($|\\?)/i.test(finalUrl) ? \"hls\" : \"mp4\",\n            headers: headers,\n            name: \"麻豆\",\n        }],\n        expiresAt: Date.now() + 3600 * 1000,\n    };\n}\n\nexport default {home, category, search, detail, play};\n"}}