{"manifest":{"schema":1,"id":"com.idj.ext.591av","name":"591AV┃亚洲素人","version":"1.0.0","author":{"name":"py 蜘蛛改写"},"description":"591AV┃亚洲素人（591av.ws，KVS 模板 HTML 站）。分类与站导航 1:1：最新更新+33 个分类（原 jar 蜘蛛 ZakaKvsAmns 静态表 24 个与站现行 /categories/ 全表并集，含站点新增 9 个）+搜索热榜；列表 /new/<页>/、分类 /categories/<slug>/<页>/、搜索 /search/?q=&page= 正则解卡；详情页 var stream 的 jmpres m3u8 直取（302 跳旋转 CDN 由播放器跟随），<source>/mp4 兜底照原蜘蛛。由内置 jar 蜘蛛 ZakaKvsAmns 的 591av 分支改写。","type":"video","adult":true,"language":["zh"],"minAppVersion":"1.5","entry":"main.js","permissions":{"http":["591av.ws","*.vcwinford.cc"],"media":["591av.ws","*.vcwinford.cc"],"cloudflare":false,"storage":false,"login":false},"capabilities":["home","category","search","detail","play"],"settings":[],"update":{"url":"https://raw.githubusercontent.com/hoyittvggfh45/moytv/plugins/591av/591av.idjplugin"},"integrity":"sha256-vPMvJBiw4qxL7JWFzoOmn83A4CCWyhWkG7ENMb9hZAg="},"files":{"main.js":"// 591AV (591av.ws) — idj1 plugin, 1:1 port of the 591av branch of the\n// builtin jar spider ZakaKvsAmns (com.github.catvod.spider.ZakaKvsAmns,\n// ext {\"site\":\"591av\"}). KVS-style HTML site: list /new/<p>/, category\n// /categories/<slug>/<p>/, search /search/?q=<kw>&page=<p>; cards are\n// <div class=\"item card-video...\"> blocks; the detail page carries the\n// HLS stream in a `var stream = '<host>/jmpres/.../<id>.m3u8'` script\n// line (the spider's generic .m3u8 scan picks exactly that URL; its\n// <source>/mp4 fallbacks are kept below). The jmpres URL 302-redirects\n// to a rotating media CDN; the plugin returns the 591av.ws URL itself\n// (https, bare domain) and lets the player follow the redirect.\n\nconst BASE = \"https://591av.ws\";\nconst UA = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36\";\nconst TIMEOUT = 55000;\n\n// Category table: the spider's static CATS for 591av (24 slugs) unioned\n// with the live /categories/ index (33 slugs, 9 added by the site since:\n// student/cheongsam/kemonomimi/yoga-pants/dolfin-shorts/flight-attendant/\n// pantyhose/nurse/knee-socks). Order and display names are the site's\n// current navigation, taken verbatim from https://591av.ws/categories/.\nconst CATS = [\n    [\"china-av\", \"中国AV\"],\n    [\"japan-producer\", \"日本片商\"],\n    [\"amateur\", \"素人自拍\"],\n    [\"china\", \"中国\"],\n    [\"taiwan\", \"台湾\"],\n    [\"japan\", \"日本\"],\n    [\"se-asia\", \"东南亚\"],\n    [\"korea\", \"韩国\"],\n    [\"hongkong\", \"香港\"],\n    [\"cosplay\", \"Cosplay\"],\n    [\"streamer\", \"主播\"],\n    [\"first-person-pov\", \"主观视角\"],\n    [\"bdsm\", \"凌辱\"],\n    [\"drama\", \"剧情\"],\n    [\"threesome\", \"多P\"],\n    [\"91-tanhua\", \"探花\"],\n    [\"released\", \"流出\"],\n    [\"uncensored\", \"无码\"],\n    [\"lesbian\", \"百合\"],\n    [\"exhibitionists\", \"野外露出\"],\n    [\"office-lady\", \"OL\"],\n    [\"acg\", \"动漫\"],\n    [\"costume\", \"古装\"],\n    [\"maid\", \"女仆\"],\n    [\"student\", \"学生\"],\n    [\"cheongsam\", \"旗袍\"],\n    [\"kemonomimi\", \"兽耳\"],\n    [\"yoga-pants\", \"瑜伽裤\"],\n    [\"dolfin-shorts\", \"真理裤\"],\n    [\"flight-attendant\", \"空姐\"],\n    [\"pantyhose\", \"丝袜\"],\n    [\"nurse\", \"护士\"],\n    [\"knee-socks\", \"过膝袜\"],\n];\n\nfunction str(v) { return v == null ? \"\" : String(v); }\nfunction intValue(v, fb) { const n = parseInt(v, 10); return isFinite(n) ? n : fb; }\n\nfunction unesc(s) {\n    return str(s).replace(/\\\\\\//g, \"/\").replace(/\\\\u0026/g, \"&\").replace(/&amp;/g, \"&\")\n        .replace(/&quot;/g, '\"').replace(/&#39;/g, \"'\").replace(/&lt;/g, \"<\").replace(/&gt;/g, \">\")\n        .replace(/&#x2F;/g, \"/\");\n}\n\nfunction headers() {\n    return {\n        \"User-Agent\": UA,\n        \"Accept\": \"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\",\n        \"Accept-Language\": \"zh-CN,zh;q=0.9,en;q=0.8\",\n        \"Referer\": BASE + \"/\",\n    };\n}\n\nfunction isChallenge(body, status) {\n    const t = str(body);\n    return t.indexOf(\"Just a moment\") >= 0 || t.indexOf(\"challenges.cloudflare.com\") >= 0 ||\n        t.indexOf(\"cf_chl\") >= 0 || (status === 403 && t.toLowerCase().indexOf(\"cloudflare\") >= 0);\n}\n\nasync function fetchText(url) {\n    let lastErr = null;\n    for (let attempt = 0; attempt < 2; attempt++) {\n        try {\n            const resp = await host.http.get(url, {headers: headers(), timeout: TIMEOUT});\n            const body = resp ? str(resp.body) : \"\";\n            if (isChallenge(body, resp && resp.status)) {\n                throw host.error(\"E_CF_REQUIRED\", \"591av returned a Cloudflare challenge (HTTP \" + (resp && resp.status) + \")\");\n            }\n            if (resp && resp.status >= 200 && resp.status < 300) return body;\n            if (body && body.length >= 200) return body;\n            lastErr = host.error(\"E_NETWORK\", \"591av HTTP \" + (resp ? resp.status : \"no response\") + \" for \" + url);\n        } catch (e) {\n            if (e && (e.code === \"E_CF_REQUIRED\" || e.code === \"E_NETWORK\")) throw e;\n            lastErr = e;\n        }\n    }\n    throw lastErr || host.error(\"E_NETWORK\", \"591av fetch failed: \" + url);\n}\n\n// Spider page1(): strip the trailing /%d or /%d/ page segment for page 1.\nfunction page1(tpl) {\n    if (tpl.endsWith(\"/%d/\")) return tpl.slice(0, tpl.length - 4) + \"/\";\n    if (tpl.endsWith(\"/%d\")) return tpl.slice(0, tpl.length - 3) + \"/\";\n    if (tpl.endsWith(\"%d/\")) return tpl.slice(0, tpl.length - 3);\n    if (tpl.endsWith(\"%d\")) return tpl.slice(0, tpl.length - 2);\n    return tpl;\n}\n\nfunction listUrl(page) {\n    const tpl = \"/new/%d/\";\n    return BASE + (page <= 1 ? page1(tpl) : tpl.replace(\"%d\", String(page)));\n}\nfunction catUrl(slug, page) {\n    const tpl = \"/categories/%s/%d/\".replace(\"%s\", slug);\n    return BASE + (page <= 1 ? page1(tpl) : tpl.replace(\"%d\", String(page)));\n}\nfunction searchUrl(kw, page) {\n    return BASE + \"/search/?q=\" + encodeURIComponent(kw) + \"&page=\" + page;\n}\n\nfunction absUrl(u) {\n    const t = unesc(u).trim();\n    if (t.indexOf(\"//\") === 0) return \"https:\" + t;\n    if (t.charAt(0) === \"/\") return BASE + t;\n    return t;\n}\n\n// Spider pickLink(): first href that looks like a video page.\nfunction pickLink(block) {\n    const re = /href=\"([^\"]+)\"/g;\n    let m;\n    while ((m = re.exec(block)) !== null) {\n        const g = m[1];\n        // Spider regex was /v/[a-z0-9]{4,10}; search-result slugs are the\n        // hyphenated long form (/v/2fbdsl-fc2ppv2110084/), which that\n        // pattern misses entirely — widened to hyphenated slugs.\n        let ok = g.indexOf(\"/video/\") >= 0 || /\\/v\\/[a-z0-9][a-z0-9-]*\\/?$/.test(g);\n        if (g.indexOf(\"embed\") >= 0) ok = false;\n        if (ok) return absUrl(g);\n    }\n    return \"\";\n}\n\nfunction cardTitle(block, link) {\n    let m = /title=\"([^\"]*)\"/.exec(block);\n    if (m && m[1].trim().length > 1) return unesc(m[1]).trim();\n    m = /<img[^>]*alt=\"([^\"]*)\"/.exec(block);\n    if (m && m[1].trim().length > 1) return unesc(m[1]).trim();\n    m = /<div class=\"title\"[^>]*>([^<]{2,200})<\\/div>/.exec(block);\n    if (m && m[1].trim().length > 1) return unesc(m[1]).trim();\n    let s = link.split(\"?\")[0];\n    const vi = s.lastIndexOf(\"/video/\");\n    if (vi >= 0) s = s.slice(vi + 7);\n    s = s.replace(/\\/+$/, \"\");\n    const li = s.lastIndexOf(\"/\");\n    if (li >= 0) s = s.slice(li + 1);\n    return s.replace(/-/g, \" \").trim();\n}\n\nfunction picOf(block) {\n    let m;\n    const lazy = /data-(?:src|original|webp)=\"([^\"]+)\"/g;\n    while ((m = lazy.exec(block)) !== null) {\n        let g = m[1];\n        if (g.indexOf(\"//\") === 0) g = \"https:\" + g;\n        if (g.indexOf(\"http\") === 0 && g.indexOf(\"placeholder\") < 0 && g.indexOf(\"data:image\") < 0) return g;\n    }\n    m = /<img[^>]*src=\"([^\"]+)\"/.exec(block);\n    if (!m) return \"\";\n    let g = m[1];\n    if (g.indexOf(\"//\") === 0) g = \"https:\" + g;\n    if (g.indexOf(\"data:image\") >= 0) return \"\";\n    if (g.charAt(0) === \"/\") g = BASE + g;\n    return g.indexOf(\"http\") === 0 ? g : \"\";\n}\n\nfunction durOf(block) {\n    let m = /class=\"duracion\"[^>]*>\\s*([0-9:]{3,10})\\s*</.exec(block);\n    if (m) return m[1].trim();\n    m = /class=\"duration\"[^>]*>\\s*([0-9:]{3,10})\\s*</.exec(block);\n    if (m) return m[1].trim();\n    m = /__duration\"[^>]*>\\s*([0-9:]{3,10})\\s*</.exec(block);\n    return m ? m[1].trim() : \"\";\n}\n\n// Spider appendCards() + fallbackCards().\nfunction parseCards(html, limit) {\n    const out = [];\n    if (!html || html.length < 200) return out;\n    const seen = new Set();\n    const cardRe = /<div class=\"item card-video[^\"]*\">([\\s\\S]*?)(?=<div class=\"item card-video|<\\/section>)/g;\n    let m;\n    while ((m = cardRe.exec(html)) !== null && out.length < limit) {\n        const block = m[1];\n        const link = pickLink(block);\n        if (link.length < 8 || seen.has(link)) continue;\n        seen.add(link);\n        out.push({\n            id: link,\n            title: cardTitle(block, link),\n            cover: picOf(block),\n            remarks: durOf(block) || \"591AV\",\n            tags: [],\n        });\n    }\n    if (!out.length) {\n        const re = /href=\"([^\"]+)\"/g;\n        while ((m = re.exec(html)) !== null && out.length < limit) {\n            let g = m[1];\n            const ok = (g.indexOf(\"/video/\") >= 0 || /\\/v\\/[a-z0-9][a-z0-9-]*\\/?$/.test(g)) && g.indexOf(\"embed\") < 0;\n            if (!ok) continue;\n            if (g.charAt(0) === \"/\") g = BASE + g;\n            if (g.indexOf(\"http\") !== 0 || seen.has(g)) continue;\n            seen.add(g);\n            out.push({id: g, title: cardTitle(g, g), cover: \"\", remarks: \"591AV\", tags: []});\n        }\n    }\n    return out;\n}\n\nfunction categories() {\n    const out = [{id: \"new\", name: \"🔥 最新更新\"}];\n    for (const c of CATS) out.push({id: \"c:\" + c[0], name: c[1]});\n    out.push({id: \"hot\", name: \"🔍 搜索热榜\"});\n    return out;\n}\n\nasync function home() {\n    const html = await fetchText(listUrl(1));\n    const items = parseCards(html, 30);\n    if (!items.length) throw host.error(\"E_PARSE\", \"591av home list parsed empty\");\n    return {categories: categories(), items: items, hasMore: true};\n}\n\nasync function category(arg) {\n    const tid = str(arg && arg.id).trim();\n    const page = Math.max(1, intValue(arg && arg.page, 1));\n    let url;\n    if (tid.indexOf(\"c:\") === 0) url = catUrl(tid.slice(2), page);\n    else if (tid === \"hot\") url = searchUrl(\"anal\", page);\n    else url = listUrl(page);\n    const html = await fetchText(url);\n    const items = parseCards(html, 60);\n    return {items: items, hasMore: items.length >= 12};\n}\n\nasync function search(arg) {\n    const keyword = str(arg && arg.keyword).trim();\n    if (!keyword) return {items: [], hasMore: false};\n    const page = Math.max(1, intValue(arg && arg.page, 1));\n    const html = await fetchText(searchUrl(keyword, page));\n    const items = parseCards(html, 40);\n    return {items: items, hasMore: items.length >= 12};\n}\n\nfunction firstMeta(html, prop) {\n    const m = new RegExp('property=\"' + prop + '\" content=\"([^\"]*)\"').exec(html);\n    return m ? m[1].trim() : \"\";\n}\n\nfunction qualityLabel(u) {\n    const s = str(u).toLowerCase();\n    if (s.indexOf(\"2160\") >= 0 || s.indexOf(\"4k\") >= 0) return \"4K\";\n    if (s.indexOf(\"1080\") >= 0) return \"1080P\";\n    if (s.indexOf(\"720\") >= 0) return \"720P\";\n    if (s.indexOf(\"480\") >= 0) return \"480P\";\n    if (s.indexOf(\"360\") >= 0) return \"360P\";\n    return \"Auto\";\n}\n\nfunction isPreview(u) {\n    const s = str(u).toLowerCase();\n    return s.indexOf(\"preview\") >= 0 || s.indexOf(\"_sample\") >= 0 || s.indexOf(\"thumbs\") >= 0;\n}\n\n// Spider streams(): m3u8 scan first (max 4), then <source> tags, then any\n// mp4 matching get_file|jmpres|/videos/, then the /embed/<id> page rescan.\nfunction extractStreams(html, pageUrl) {\n    const out = [];\n    const seen = new Set();\n    const push = (label, u) => {\n        const t = unesc(u).trim();\n        if (t.length < 12 || seen.has(t)) return;\n        seen.add(t);\n        out.push({label: label, url: t});\n    };\n    let m;\n    const m3u8 = /https?:\\/\\/[^\"'\\s<>\\\\]+?\\.m3u8[^\"'\\s<>\\\\]*/gi;\n    let n = 0;\n    while ((m = m3u8.exec(html)) !== null && n < 4) {\n        const t = unesc(m[0]).trim();\n        if (t.indexOf(\".jpg\") >= 0 || t.indexOf(\".png\") >= 0 || t.indexOf(\".webp\") >= 0) continue;\n        n++;\n        push(\"HLS\", t);\n    }\n    const src = /<source[^>]*src=\"([^\"]+)\"[^>]*>/gi;\n    while ((m = src.exec(html)) !== null) {\n        let t = unesc(m[1]).trim();\n        if (t.length < 12 || isPreview(t)) continue;\n        t = absUrl(t);\n        if (t.indexOf(\"http\") !== 0) continue;\n        const tag = m[0];\n        let label = \"\";\n        const tm = /title=\"([^\"]*)\"/.exec(tag);\n        if (tm) label = tm[1].trim();\n        if (!label) { const lm = /label=\"([^\"]*)\"/.exec(tag); if (lm) label = lm[1].trim(); }\n        if (!label) { const sm = /size=\"([0-9]{3,4})\"/.exec(tag); if (sm) label = sm[1] + \"P\"; }\n        if (!label) label = qualityLabel(t);\n        push(label, t);\n    }\n    if (!out.length) {\n        const any = /https?:\\/\\/[^\"'\\s<>\\\\]+?(?:get_file|jmpres|\\/videos?\\/)[^\"'\\s<>\\\\]*?\\.mp4\\/?[^\"'\\s<>\\\\]*/gi;\n        while ((m = any.exec(html)) !== null) {\n            const t = unesc(m[0]).trim();\n            if (!isPreview(t)) push(qualityLabel(t), t);\n        }\n        const rel = /\\/(?:get_file|jmpres)\\/[^\"'\\s<>\\\\]+?\\.mp4\\/?[^\"'\\s<>\\\\]*/gi;\n        while ((m = rel.exec(html)) !== null) {\n            const t = BASE + unesc(m[0]).trim();\n            if (!isPreview(t)) push(qualityLabel(t), t);\n        }\n    }\n    return out;\n}\n\nasync function detail(arg) {\n    const raw = str(arg && arg.id).trim();\n    if (raw.length < 8) throw host.error(\"E_PARSE\", \"empty detail id\");\n    const url = raw.charAt(0) === \"/\" ? BASE + raw : raw;\n    const html = await fetchText(url);\n    let title = unesc(firstMeta(html, \"og:title\")).trim();\n    if (!title) {\n        const ti = html.indexOf(\"<title>\");\n        const te = html.indexOf(\"</title>\");\n        if (ti >= 0 && te > ti) title = unesc(html.slice(ti + 7, te)).trim();\n    }\n    if (!title) title = \"591AV 影片\";\n    let cover = firstMeta(html, \"og:image\");\n    if (cover.indexOf(\"//\") === 0) cover = \"https:\" + cover;\n    const desc = unesc(firstMeta(html, \"og:description\")).trim();\n    const durSec = intValue(firstMeta(html, \"video:duration\"), 0);\n    let streams = extractStreams(html, url);\n    if (!streams.length) {\n        const em = /(?:https?:\\/\\/[^\"'\\s]+)?\\/embed\\/(\\d+)/i.exec(html);\n        if (em) {\n            const ehtml = await fetchText(BASE + \"/embed/\" + em[1]);\n            streams = extractStreams(ehtml, url);\n        }\n    }\n    if (!streams.length) throw host.error(\"E_PARSE\", \"591av detail has no playable stream: \" + url);\n    const episodes = streams.map(s => ({id: s.url, name: s.label}));\n    return {\n        id: raw,\n        title: title,\n        cover: cover,\n        desc: desc,\n        remarks: durSec > 0 ? Math.floor(durSec / 60) + \" 分钟\" : streams[0].label,\n        tags: [],\n        lines: [{name: \"591AV·正片\", episodes: episodes}],\n    };\n}\n\nasync function play(arg) {\n    let raw = str((arg && arg.episodeId) || (arg && arg.id)).trim();\n    if (raw.indexOf(\"http\") !== 0) throw host.error(\"E_PARSE\", \"invalid play id\");\n    if (raw.indexOf(\"http://\") === 0) raw = \"https://\" + raw.slice(7);\n    if (raw.indexOf(\"https://\") !== 0) throw host.error(\"E_PARSE\", \"play only accepts https streams\");\n    const isHls = /\\.m3u8($|\\?)/i.test(raw);\n    return {\n        streams: [{\n            url: raw,\n            format: isHls ? \"hls\" : \"mp4\",\n            headers: {\"User-Agent\": UA, \"Referer\": BASE + \"/\"},\n            name: str(arg && arg.line) || \"591AV\",\n        }],\n        expiresAt: Date.now() + 3600 * 1000,\n    };\n}\n\nexport default {home: home, category: category, search: search, detail: detail, play: play};\n"}}