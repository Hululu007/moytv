{"manifest":{"schema":1,"id":"com.idj.ext.yiren","name":"伊人AV","version":"1.0.0","author":{"name":"py 蜘蛛改写"},"description":"伊人AV（yiren234.cc）。分类与原 py 蜘蛛 1:1（动态解析 /categories，失败时静态表兜底），播放为详情页 JSON-LD VideoObject 的 contentUrl 直链，master 清单在 play 内预解析到子清单。由内置 py 蜘蛛改写。","type":"video","adult":true,"language":["zh"],"minAppVersion":"1.5","entry":"main.js","permissions":{"http":["yiren234.cc"],"media":["1111.slp261111.top","*.slp261111.top","2609.senlin2026.com","*.senlin2026.com"],"cloudflare":false,"storage":false,"login":false},"capabilities":["home","category","search","detail","play"],"settings":[],"update":{"url":"https://raw.githubusercontent.com/hoyittvggfh45/moytv/plugins/yiren/yiren.idjplugin"},"integrity":"sha256-95Tp/0HH3V0z3lEXX3Fjjphpmcu67bngy+Hy2F4MjU0="},"files":{"main.js":"// Yiren AV - idj1 plugin (rewritten from built-in py spider yiren)\n// Site: https://yiren234.cc ; HTML pages, detail carries a JSON-LD\n// VideoObject whose contentUrl is the direct stream address.\n\nconst BASE = \"https://yiren234.cc\";\nconst UA = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36\";\nconst TIMEOUT = 60000;\n\nconst CATS = [\n    [\"14\", \"AI Shortplay\"],\n    [\"13\", \"Wanderer.\"],\n    [\"12\", \"I don't know.\"],\n    [\"11\", \"AV explains.\"],\n    [\"10\", \"JAV Blacks Temptation\"],\n    [\"9\", \"Chinese subtitle for JAV\"],\n    [\"8\", \"Cavalry crack.\"],\n    [\"7\", \"Comics.\"],\n    [\"6\", \"America and America\"],\n    [\"5\", \"Domestic video\"],\n    [\"4\", \"Japanese Codeless\"],\n    [\"3\", \"Subtitles in Chinese\"],\n    [\"2\", \"Japan has codes.\"],\n    [\"1\", \"Chinese subtitles.\"],\n];\n\nconst CARD_RE = /<a class=\"card\" href=\"\\/video\\/(\\d+)\" title=\"([^\"]+)\">[\\s\\S]*?<img src=\"([^\"]+)\"/g;\nconst DUR_RE = /<span class=\"card-status\">([^<]+)<\\/span>/;\nconst CAT_RE = /href=\"\\/latest\\?category=(\\d+)\"[^>]*>([^<]{1,40})</g;\nconst LD_RE = /<script type=\"application\\/ld\\+json\">([\\s\\S]*?)<\\/script>/g;\n\nfunction str(value) {\n    if (value == null) return \"\";\n    return String(value).trim();\n}\n\nfunction intValue(value, fallback) {\n    const n = parseInt(value, 10);\n    return isFinite(n) ? n : fallback;\n}\n\nfunction unescapeHtml(s) {\n    if (!s) return \"\";\n    return String(s)\n        .replace(/&amp;/g, \"&\")\n        .replace(/&lt;/g, \"<\")\n        .replace(/&gt;/g, \">\")\n        .replace(/&quot;/g, '\"')\n        .replace(/&#0?39;/g, \"'\")\n        .replace(/&apos;/g, \"'\")\n        .replace(/&#(\\d+);/g, function (m, n) {\n            const c = parseInt(n, 10);\n            return isFinite(c) ? String.fromCharCode(c) : m;\n        })\n        .replace(/&#x([0-9a-fA-F]+);/g, function (m, n) {\n            const c = parseInt(n, 16);\n            return isFinite(c) ? String.fromCharCode(c) : m;\n        })\n        .trim();\n}\n\nfunction resolveUrl(raw, base) {\n    const u = str(raw);\n    if (!u) return \"\";\n    if (u.indexOf(\"//\") === 0) return \"https:\" + u;\n    if (/^https?:\\/\\//i.test(u)) return u;\n    try {\n        return host.url.resolve(base || (BASE + \"/\"), u);\n    } catch (error) {\n        return u;\n    }\n}\n\nfunction pageHeaders(referer) {\n    return {\n        \"User-Agent\": UA,\n        \"Accept\": \"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\",\n        \"Accept-Language\": \"zh-CN,zh;q=0.9,en;q=0.8\",\n        \"Referer\": referer || (BASE + \"/\"),\n    };\n}\n\nasync function httpGet(url, referer) {\n    let lastError = null;\n    for (let attempt = 0; attempt < 3; attempt++) {\n        try {\n            const resp = await host.http.get(url, {headers: pageHeaders(referer), timeout: TIMEOUT});\n            if (resp.status >= 200 && resp.status < 300 && resp.body && resp.body.trim()) {\n                return resp.body;\n            }\n            if (resp.body && resp.body.trim()) return resp.body;\n            lastError = new Error(\"HTTP \" + resp.status);\n        } catch (error) {\n            lastError = error;\n        }\n    }\n    if (lastError) throw lastError;\n    return \"\";\n}\n\nasync function httpGetSoft(url, referer) {\n    try {\n        return await httpGet(url, referer);\n    } catch (error) {\n        return \"\";\n    }\n}\n\nfunction parseCards(html) {\n    const out = [];\n    if (!html) return out;\n    const seen = {};\n    CARD_RE.lastIndex = 0;\n    let m;\n    while ((m = CARD_RE.exec(html)) !== null) {\n        const vid = m[1];\n        if (seen[vid]) continue;\n        const title = unescapeHtml(m[2]);\n        if (!title) continue;\n        seen[vid] = true;\n        const cover = resolveUrl(m[3], BASE + \"/\");\n        const windowText = html.slice(m.index + m[0].length, m.index + m[0].length + 2000);\n        const dm = DUR_RE.exec(windowText);\n        const remark = dm ? dm[1].trim() : \"\";\n        out.push({id: vid, title: title, cover: cover, remarks: remark, duration: remark, tags: []});\n    }\n    return out;\n}\n\nfunction parseCategories(html) {\n    const out = [];\n    if (!html) return out;\n    const seen = {};\n    CAT_RE.lastIndex = 0;\n    let m;\n    while ((m = CAT_RE.exec(html)) !== null) {\n        const cid = m[1];\n        const name = unescapeHtml(m[2]);\n        if (!name || name.indexOf(\"All videos\") === 0 || seen[cid]) continue;\n        seen[cid] = true;\n        out.push({id: cid, name: name});\n    }\n    return out;\n}\n\nlet catsCache = null;\n\nasync function fetchCategories() {\n    if (catsCache) return catsCache;\n    const html = await httpGetSoft(BASE + \"/categories\", BASE + \"/\");\n    let cats = parseCategories(html);\n    if (!cats.length) {\n        cats = CATS.map(function (item) { return {id: item[0], name: item[1]}; });\n    }\n    catsCache = cats;\n    return catsCache;\n}\n\nasync function catalog(tid, pg) {\n    const page = Math.max(1, intValue(pg, 1));\n    const url = BASE + \"/latest?category=\" + encodeURIComponent(str(tid)) + \"&page=\" + page;\n    const html = await httpGetSoft(url, BASE + \"/\");\n    return parseCards(html);\n}\n\nfunction voField(vo, key) {\n    if (!vo || typeof vo !== \"object\") return \"\";\n    const v = vo[key];\n    if (typeof v === \"string\") return v.trim();\n    if (Array.isArray(v) && v.length && typeof v[0] === \"string\") return v[0].trim();\n    return \"\";\n}\n\nfunction parseVideoObject(html) {\n    if (!html) return null;\n    LD_RE.lastIndex = 0;\n    let m;\n    while ((m = LD_RE.exec(html)) !== null) {\n        try {\n            const v = JSON.parse(m[1]);\n            if (v && typeof v === \"object\" && v[\"@type\"] === \"VideoObject\") return v;\n            if (Array.isArray(v)) {\n                for (const item of v) {\n                    if (item && typeof item === \"object\" && item[\"@type\"] === \"VideoObject\") return item;\n                }\n            }\n        } catch (error) {\n            // skip malformed block, same as py\n        }\n    }\n    return null;\n}\n\nfunction normVid(raw) {\n    let vid = str(raw);\n    if (vid.indexOf(\"/video/\") === 0) vid = vid.slice(7);\n    vid = vid.replace(/\\/+$/, \"\");\n    const m = /(\\d+)/.exec(vid);\n    if (m && /^[0-9\\/a-zA-Z._-]*$/.test(vid)) {\n        // ids in this site are plain numbers; keep digits when the\n        // value is not already a pure number\n        if (!/^\\d+$/.test(vid)) vid = m[1];\n    }\n    return vid;\n}\n\nasync function fetchDetail(vid) {\n    const html = await httpGet(BASE + \"/video/\" + vid, BASE + \"/\");\n    const vo = parseVideoObject(html);\n    if (!vo) return null;\n    const title = voField(vo, \"name\");\n    const stream = voField(vo, \"contentUrl\");\n    if (!title || !stream) return null;\n    return {\n        title: title,\n        stream: stream,\n        cover: resolveUrl(voField(vo, \"thumbnailUrl\"), BASE + \"/\"),\n        desc: voField(vo, \"description\"),\n        keywords: voField(vo, \"keywords\"),\n    };\n}\n\nasync function resolveMaster(url, headers) {\n    if (!/\\.m3u8($|\\?)/i.test(url)) return url;\n    try {\n        const resp = await host.http.get(url, {headers: headers, timeout: TIMEOUT});\n        if (resp.status < 200 || resp.status >= 300 || !resp.body) return url;\n        const text = resp.body;\n        if (text.indexOf(\"#EXT-X-STREAM-INF\") < 0) return url;\n        const lines = text.split(/\\r?\\n/);\n        for (let i = 0; i < lines.length; i++) {\n            if (lines[i].indexOf(\"#EXT-X-STREAM-INF\") === 0) {\n                for (let j = i + 1; j < lines.length; j++) {\n                    const line = lines[j].trim();\n                    if (line && line.charAt(0) !== \"#\") {\n                        return resolveUrl(line, url);\n                    }\n                }\n            }\n        }\n        return url;\n    } catch (error) {\n        return url;\n    }\n}\n\nasync function home() {\n    const categories = await fetchCategories();\n    let items = [];\n    if (categories.length) {\n        items = await catalog(categories[0].id, 1);\n    }\n    return {categories: categories, items: items, hasMore: items.length > 0};\n}\n\nasync function category(arg) {\n    const pg = Math.max(1, intValue(arg && arg.page, 1));\n    const tid = str(arg && arg.id) || CATS[0][0];\n    const items = await catalog(tid, pg);\n    return {items: items, hasMore: items.length > 0};\n}\n\nasync function search(arg) {\n    const keyword = str(arg && arg.keyword).trim();\n    if (!keyword) return {items: [], hasMore: false};\n    const url = BASE + \"/search?q=\" + encodeURIComponent(keyword);\n    const html = await httpGetSoft(url, BASE + \"/\");\n    const items = parseCards(html);\n    return {items: items, hasMore: false};\n}\n\nasync function detail(arg) {\n    const vid = normVid(arg && arg.id);\n    if (!vid) throw new Error(\"invalid video id\");\n    const d = await fetchDetail(vid);\n    if (!d) throw new Error(\"detail not found\");\n    let tags = [];\n    if (d.keywords) {\n        tags = d.keywords.split(/[,;]/).map(function (t) { return t.trim(); }).filter(function (t) { return !!t; });\n    }\n    return {\n        id: vid,\n        title: d.title,\n        cover: d.cover,\n        desc: d.desc,\n        tags: tags,\n        lines: [{name: \"Online\", episodes: [{id: vid, name: \"Play\"}]}],\n    };\n}\n\nasync function play(arg) {\n    const raw = str((arg && arg.episodeId) || (arg && arg.id));\n    let stream = \"\";\n    if (/^https?:\\/\\//i.test(raw)) {\n        stream = raw;\n    } else {\n        const vid = normVid(raw);\n        if (!vid) throw new Error(\"invalid play id\");\n        const d = await fetchDetail(vid);\n        if (!d || !d.stream) throw new Error(\"no stream found\");\n        stream = d.stream;\n    }\n    const headers = {\"User-Agent\": UA, \"Referer\": BASE + \"/\"};\n    const finalUrl = await resolveMaster(stream, headers);\n    const isHls = /\\.m3u8($|\\?)/i.test(finalUrl);\n    return {\n        streams: [{\n            url: finalUrl,\n            format: isHls ? \"hls\" : \"mp4\",\n            headers: headers,\n            name: \"Online\",\n        }],\n        expiresAt: Date.now() + 3600 * 1000,\n    };\n}\n\nexport default {home: home, category: category, search: search, detail: detail, play: play};\n"}}