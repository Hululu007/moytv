{"manifest":{"schema":1,"id":"com.idj.ext.hsck","name":"👑帝皇影视┃黄色仓库②","version":"1.0.0","author":{"name":"py 蜘蛛改写"},"description":"🔞👑帝皇影视┃黄色仓库②（hsck123.com，HTML 直解站）。与黄色仓库资源站（hsckzy，MacCMS 资源接口）及黄色仓库（69ck，MacCMS provide 接口）是三个不同站、不同协议，本插件按内置 jar 蜘蛛 ZakaHsckAmns 独立还原：蜘蛛只有 1 个分类『最新』，首页即列表、/?p=N 翻页（实测 totalPages 88），搜索走 /?p=N&search2=ndafeoafa&search= 盐值参数，详情 /view/?id= 页内 video_img 标签 alt 为封面、src 为直给 m3u8。由内置 jar 蜘蛛 ZakaHsckAmns 改写。","type":"video","adult":true,"language":["zh"],"minAppVersion":"1.5","entry":"main.js","permissions":{"http":["hsck123.com","aliyun.cctv05.com","*.97img.com"],"media":["hsck123.com","aliyun.cctv05.com","*.97img.com"],"cloudflare":false,"storage":false,"login":false},"capabilities":["home","category","search","detail","play"],"settings":[],"update":{"url":"https://raw.githubusercontent.com/hoyittvggfh45/moytv/plugins/hsck/hsck.idjplugin"},"integrity":"sha256-yMqZLI9e9FaNmvxMQsLW6f/YGjUeSczcXQh7yLCL2AM="},"files":{"main.js":"// Huangse Cangku 2 (hsck123.com) — idj1 plugin, 1:1 port of the builtin\n// jar spider ZakaHsckAmns. Plain HTML site: the homepage is the only\n// listing (single category \"new\"), pagination via /?p=N, search via\n// /?p=N&search2=ndafeoafa&search=<kw>, detail /view/?id=<id> carries the\n// stream in <img id=\"video_img\" alt=\"<cover>\" src=\"<m3u8>\">.\n\nconst HOST = \"https://hsck123.com\";\nconst UA = \"Mozilla/5.0 (Linux; Android 13; SM-G991B) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/131.0.0.0 Mobile Safari/537.36\";\nconst TIMEOUT = 58000;\nconst PER = 40;\nconst SEARCH_SALT = \"ndafeoafa\";\n\nfunction str(v) { return v == null ? \"\" : String(v); }\nfunction intValue(v, fb) { const n = parseInt(v, 10); return isFinite(n) ? n : fb; }\n\nfunction clean(s) {\n    return str(s).replace(/&lt;/g, \"<\").replace(/&gt;/g, \">\").replace(/&quot;/g, '\"')\n        .replace(/&#39;/g, \"'\").replace(/&#x27;/g, \"'\").replace(/&nbsp;/g, \" \")\n        .replace(/&amp;/g, \"&\").trim();\n}\n\nfunction headers() {\n    return {\n        \"User-Agent\": UA,\n        \"Accept\": \"text/html,application/xhtml+xml,*/*;q=0.8\",\n        \"Accept-Language\": \"zh-CN,zh;q=0.9\",\n        \"Referer\": HOST + \"/\",\n    };\n}\n\nfunction isChallenge(body, status) {\n    const t = str(body);\n    return t.indexOf(\"Just a moment\") >= 0 || t.indexOf(\"challenges.cloudflare.com\") >= 0 ||\n        t.indexOf(\"cf_chl\") >= 0 || (status === 403 && t.indexOf(\"cloudflare\") >= 0);\n}\n\nasync function page(url) {\n    let lastErr = null;\n    for (let attempt = 0; attempt < 2; attempt++) {\n        try {\n            const resp = await host.http.get(url, {headers: headers(), timeout: TIMEOUT});\n            const body = resp ? str(resp.body) : \"\";\n            if (isChallenge(body, resp && resp.status)) {\n                throw host.error(\"E_CF_REQUIRED\", \"hsck123.com Cloudflare challenge (HTTP \" + (resp && resp.status) + \")\");\n            }\n            if (resp && resp.status >= 200 && resp.status < 300 && body) return body;\n            lastErr = host.error(\"E_NETWORK\", \"hsck page HTTP \" + (resp ? resp.status : \"no response\") + \": \" + url);\n        } catch (e) {\n            if (e && e.code === \"E_CF_REQUIRED\") throw e;\n            lastErr = e;\n        }\n    }\n    throw lastErr || host.error(\"E_NETWORK\", \"hsck page failed: \" + url);\n}\n\n// Spider P_ITEM: href=\"/view/?id=xx\" ... title=\"...\" ... data-original=\"...\"\nfunction parseList(html) {\n    const out = [];\n    const seen = {};\n    const re = /href=\"(\\/view\\/\\?id=([a-z0-9]+))\"[^>]*?title=\"([^\"]*)\"[^>]*?data-original=\"([^\"]*)\"/g;\n    let m;\n    while ((m = re.exec(str(html))) !== null) {\n        const id = m[2];\n        if (!id || seen[id]) continue;\n        seen[id] = true;\n        const title = clean(m[3]);\n        if (!title) continue;\n        out.push({id: id, title: title, cover: str(m[4]).trim(), remarks: \"\", tags: []});\n    }\n    return out;\n}\n\nfunction totalPages(html) {\n    const m = /totalPages:\\s*(\\d+)/.exec(str(html));\n    return m ? intValue(m[1], 1) : 1;\n}\n\nasync function home() {\n    const html = await page(HOST + \"/\");\n    const items = parseList(html);\n    if (!items.length) throw host.error(\"E_PARSE\", \"hsck homepage returned no items\");\n    return {categories: [{id: \"new\", name: \"最新\"}], items: items, hasMore: totalPages(html) > 1};\n}\n\nasync function category(arg) {\n    const pageNo = Math.max(1, intValue(arg && arg.page, 1));\n    const html = await page(pageNo <= 1 ? HOST + \"/\" : HOST + \"/?p=\" + pageNo);\n    const items = parseList(html);\n    return {items: items, hasMore: pageNo < totalPages(html)};\n}\n\nasync function search(arg) {\n    const keyword = str(arg && arg.keyword).trim();\n    if (!keyword) return {items: [], hasMore: false};\n    const pageNo = Math.max(1, intValue(arg && arg.page, 1));\n    const url = HOST + \"/?p=\" + pageNo + \"&search2=\" + SEARCH_SALT + \"&search=\" + encodeURIComponent(keyword);\n    const items = parseList(await page(url));\n    return {items: items, hasMore: items.length >= PER};\n}\n\nasync function detail(arg) {\n    const id = str(arg && arg.id).trim();\n    if (!id) throw host.error(\"E_PARSE\", \"empty detail id\");\n    const html = await page(HOST + \"/view/?id=\" + encodeURIComponent(id));\n    let title = \"\";\n    const tm = /<title>([\\s\\S]*?)<\\/title>/.exec(html);\n    if (tm) {\n        title = clean(tm[1]);\n        const cut = title.lastIndexOf(\" - \");\n        if (cut > 0) title = title.slice(0, cut).trim();\n    }\n    let cover = \"\";\n    let playUrl = \"\";\n    const pm = /<img id=\"video_img\"[^>]*?alt=\"([^\"]*)\"[^>]*?src=\"([^\"]*)\"/.exec(html);\n    if (pm) {\n        cover = str(pm[1]).trim();\n        playUrl = str(pm[2]).trim();\n    }\n    if (!playUrl) {\n        const mm = /https?:\\/\\/[^\"'\\s<>]+\\.m3u8[^\"'\\s<>]*/.exec(html);\n        if (mm) playUrl = mm[0];\n    }\n    if (!playUrl) throw host.error(\"E_PARSE\", \"hsck detail has no stream: \" + id);\n    if (!title) title = \"黄色仓库 \" + id;\n    return {\n        id: id,\n        title: title,\n        cover: cover,\n        desc: title,\n        tags: [],\n        lines: [{name: \"hscK\", episodes: [{id: playUrl, name: \"正片\"}]}],\n    };\n}\n\nasync function play(arg) {\n    let raw = str((arg && arg.episodeId) || (arg && arg.id)).trim();\n    if (raw.indexOf(\"http://\") === 0) raw = \"https://\" + raw.slice(7);\n    if (raw.indexOf(\"https://\") !== 0) throw host.error(\"E_PARSE\", \"hsck play only accepts https streams\");\n    const isHls = /\\.m3u8($|\\?)/i.test(raw);\n    return {\n        streams: [{\n            url: raw,\n            format: isHls ? \"hls\" : \"mp4\",\n            headers: {\"User-Agent\": UA, \"Referer\": HOST + \"/\"},\n            name: str(arg && arg.line) || \"hscK\",\n        }],\n        expiresAt: Date.now() + 3600 * 1000,\n    };\n}\n\nexport default {home: home, category: category, search: search, detail: detail, play: play};\n"}}