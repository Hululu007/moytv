{"manifest":{"schema":1,"id":"com.idj.ext.hl365","name":"黑料不打烊","version":"1.0.0","author":{"name":"py 蜘蛛改写"},"description":"黑料不打烊（hl365.com）。分类与站点导航 1:1 共 23 类（今日看料/优选投放/每日大赛/AI短剧/每日热瓜/黑料大事/热门吃瓜/反差女神/学院热瓜/网红吃瓜/撸友看片/海角乱伦/黑料杂谈/探花大全/网黄专辑/明星吃瓜/av解说/原创投稿/性爱技巧/偷拍盗摄/官场秘闻/禁播动漫/PMV混剪）。Typecho 博客 HTML 解析列表，详情页 DPlayer 配置直取 m3u8（含加密地址 AES 解密兜底，同内置 jar 蜘蛛），play 内主清单预解析到子清单。由内置 jar 蜘蛛 ZakaHl365Amns 改写。","type":"video","adult":true,"language":["zh"],"minAppVersion":"1.5","entry":"main.js","permissions":{"http":["hl365.com","boat.rhemepsy.cc","rhemepsy.cc","absence.egiaajsd.cc"],"media":["hl365.com","pic.biacea.cn","*.biacea.cn","op.micgqv.cn","*.micgqv.cn","op.rfcbyf.cn","*.rfcbyf.cn","op.orwebn.cn","*.orwebn.cn","op.qzorxf.cn","*.qzorxf.cn","qw.mkimfs.cn","*.mkimfs.cn"],"cloudflare":false,"storage":false,"login":false},"capabilities":["home","category","search","detail","play"],"settings":[],"update":{"url":"https://raw.githubusercontent.com/hoyittvggfh45/moytv/plugins/hl365/hl365.idjplugin"},"integrity":"sha256-bJNn9nUNCTPfvht8B82cZd7RucBo74sb3mRxAfBR31I="},"files":{"main.js":"// hl365 (heiliao budayang) - idj1 plugin, rewritten from the built-in jar\n// spider com.github.catvod.spider.ZakaHl365Amns (registry key ZakaHl365,\n// ext empty). The spider hardcodes four base hosts; https://hl365.com is\n// the one verified live on 2026-11-26, the other three are kept as\n// fallbacks in the spider's own order. The site is a Typecho/Mirages blog:\n// list pages carry <article> cards (id from the /archives/<n>.html meta,\n// cover from z-image-loader-url, title from post-card-bottom-text), and\n// each post page embeds one DPlayer data-config JSON per video segment\n// whose video.url is the playable m3u8 (video.urls[] are line mirrors).\n// When video.url is not a plain http URL the spider AES-decrypts it\n// (AES/CBC/NoPadding, key f5d965df75336270, iv 97b60394abc2fbe1); that\n// fallback is kept here. Categories below are the site's live navigation\n// verified 1:1 on 2026-11-26 (23 entries, same slugs and names as the\n// spider's hardcoded table). The site is very slow through this egress\n// (45-60s per page), so requests use a 60s timeout with 3 attempts and\n// rotate to the next base host on failure.\n\nconst BASES = [\n    \"https://hl365.com\",\n    \"https://boat.rhemepsy.cc\",\n    \"https://rhemepsy.cc\",\n    \"https://absence.egiaajsd.cc\",\n];\nconst UA = \"Mozilla/5.0 (Linux; Android 13; Pixel 7) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Mobile Safari/537.36\";\nconst TIMEOUT = 60000;\nconst ATTEMPTS = 3;\nconst AES_KEY = \"f5d965df75336270\";\nconst AES_IV = \"97b60394abc2fbe1\";\n\nconst CATS = [\n    [\"24hcg\", \"今日看料\"],\n    [\"youxuan\", \"优选投放\"],\n    [\"mrds\", \"每日大赛\"],\n    [\"swdj\", \"AI短剧\"],\n    [\"mrrg\", \"每日热瓜\"],\n    [\"hlda\", \"黑料大事\"],\n    [\"rgtj\", \"热门吃瓜\"],\n    [\"fcns\", \"反差女神\"],\n    [\"xyrg\", \"学院热瓜\"],\n    [\"whhl\", \"网红吃瓜\"],\n    [\"lydt\", \"撸友看片\"],\n    [\"llsq\", \"海角乱伦\"],\n    [\"hlzt\", \"黑料杂谈\"],\n    [\"thdq\", \"探花大全\"],\n    [\"whzj\", \"网黄专辑\"],\n    [\"mxbg\", \"明星吃瓜\"],\n    [\"avjs\", \"av解说\"],\n    [\"qgzq\", \"原创投稿\"],\n    [\"wyxs\", \"性爱技巧\"],\n    [\"chjlb\", \"偷拍盗摄\"],\n    [\"gcmw\", \"官场秘闻\"],\n    [\"mrst\", \"禁播动漫\"],\n    [\"pmv\", \"PMV混剪\"],\n];\nconst CAT_IDS = {};\nfor (const pair of CATS) CAT_IDS[pair[0]] = true;\n\nlet goodBase = 0;\n\nfunction str(v) { return v == null ? \"\" : String(v); }\nfunction intVal(v, fb) { const n = parseInt(v, 10); return isFinite(n) ? n : fb; }\n\nfunction clean(s) {\n    let t = str(s).replace(/&nbsp;/g, \" \").replace(/&amp;/g, \"&\")\n        .replace(/&#039;/g, \"'\").replace(/&#39;/g, \"'\")\n        .replace(/&quot;/g, '\"').replace(/&lt;/g, \"<\").replace(/&gt;/g, \">\");\n    t = t.replace(/<[^>]+>/g, \"\").replace(/\\s+/g, \" \");\n    return t.trim();\n}\n\nfunction absUrl(u, base) {\n    const s = str(u).trim();\n    if (!s) return \"\";\n    if (/^https?:\\/\\//i.test(s)) return s;\n    if (s.indexOf(\"//\") === 0) return \"https:\" + s;\n    const b = base || BASES[goodBase];\n    if (s.charAt(0) === \"/\") return b + s;\n    return b + \"/\" + s;\n}\n\nasync function fetchText(path) {\n    const headers = {\"User-Agent\": UA, \"Accept\": \"text/html,application/xhtml+xml,*/*\"};\n    let best = \"\";\n    for (let i = 0; i < ATTEMPTS; i++) {\n        const base = BASES[(goodBase + i) % BASES.length];\n        const url = /^https?:\\/\\//i.test(path) ? path : base + path;\n        try {\n            const resp = await host.http.get(url, {headers: headers, timeout: TIMEOUT});\n            const text = resp && resp.body ? String(resp.body) : \"\";\n            if (text.length > best.length) best = text;\n            if (resp && resp.status === 200 && text.indexOf(\"</html>\") >= 0) {\n                if (!/^https?:\\/\\//i.test(path)) {\n                    const idx = BASES.indexOf(base);\n                    if (idx >= 0) goodBase = idx;\n                }\n                return text;\n            }\n        } catch (e) {\n            // slow / flaky egress: rotate base and retry\n        }\n    }\n    return best;\n}\n\nasync function fetchRaw(url, headers) {\n    try {\n        const resp = await host.http.get(url, {headers: headers || {}, timeout: TIMEOUT});\n        if (resp && resp.status === 200 && resp.body) return String(resp.body);\n    } catch (e) {\n        // fall through\n    }\n    return \"\";\n}\n\nfunction parseCards(html) {\n    const out = [];\n    if (!html) return out;\n    const seen = {};\n    const re = /<article[\\s\\S]*?<\\/article>/g;\n    let m;\n    while ((m = re.exec(html)) !== null) {\n        const block = m[0];\n        if (block.indexOf(\"/hc237/\") >= 0) continue;\n        const idm = /\\/archives\\/(\\d+)\\.html/.exec(block);\n        if (!idm) continue;\n        const pid = idm[1];\n        if (seen[pid]) continue;\n        const tm = /post-card-bottom-text\">\\s*([^<]+)/.exec(block);\n        const title = clean(tm ? tm[1] : \"\");\n        if (!title) continue;\n        seen[pid] = true;\n        let cover = \"\";\n        const cm = /z-image-loader-url=\"([^\"]+)\"/.exec(block);\n        if (cm) cover = absUrl(cm[1]);\n        let remarks = \"\";\n        const dm = /itemprop=\"dateModified\" content=\"([^\"]+)\"/.exec(block) ||\n            /itemprop=\"datePublished\" content=\"([^\"]+)\"/.exec(block);\n        if (dm) remarks = dm[1].slice(0, 10);\n        out.push({id: \"post:\" + pid, title: title, cover: cover, remarks: remarks, tags: []});\n    }\n    return out;\n}\n\nfunction parseConfigs(html) {\n    const out = [];\n    if (!html) return out;\n    const re = /data-config='([^']+)'/g;\n    let m;\n    while ((m = re.exec(html)) !== null) {\n        try {\n            const cfg = JSON.parse(m[1]);\n            if (cfg && cfg.video && (cfg.video.url || (cfg.video.urls && cfg.video.urls.length))) {\n                out.push(cfg);\n            }\n        } catch (e) {\n            // not a player config (ad sdk blocks share the attribute name\n            // but their JSON has no video field, filtered above)\n        }\n    }\n    return out;\n}\n\nfunction decryptUrl(raw) {\n    const s = str(raw).trim();\n    if (!s) return \"\";\n    if (/^https?:\\/\\//i.test(s)) return s;\n    const encodings = [\"base64\", \"hex\"];\n    for (const enc of encodings) {\n        try {\n            const dec = host.crypto.aes({\n                op: \"decrypt\", mode: \"cbc\", key: AES_KEY, keyEncoding: \"utf8\",\n                iv: AES_IV, ivEncoding: \"utf8\", data: s, in: enc, out: \"latin1\",\n                padding: \"none\",\n            });\n            const t = str(dec).replace(/[\\u0000-\\u001f]+/g, \"\").trim();\n            if (/^https?:\\/\\//i.test(t)) return t;\n        } catch (e) {\n            // try next encoding\n        }\n    }\n    return \"\";\n}\n\nfunction configUrl(cfg) {\n    if (!cfg || !cfg.video) return \"\";\n    let u = decryptUrl(cfg.video.url || \"\");\n    if (u) return u;\n    const urls = cfg.video.urls || [];\n    for (const it of urls) {\n        u = decryptUrl(it && it.url ? it.url : \"\");\n        if (u) return u;\n    }\n    return \"\";\n}\n\nasync function home() {\n    const categories = CATS.map((pair) => ({id: \"cat:\" + pair[0], name: pair[1]}));\n    const html = await fetchText(\"/\");\n    const items = parseCards(html);\n    return {categories: categories, items: items, hasMore: items.length > 0};\n}\n\nasync function category(arg) {\n    const page = Math.max(1, intVal(arg && arg.page, 1));\n    let tid = str(arg && arg.id).trim();\n    if (tid.indexOf(\"cat:\") === 0) tid = tid.slice(4);\n    if (!CAT_IDS[tid]) throw new Error(\"hl365 unknown category \" + tid);\n    const path = page <= 1 ? \"/category/\" + tid + \"/\" : \"/category/\" + tid + \"/page/\" + page + \"/\";\n    const html = await fetchText(path);\n    const items = parseCards(html);\n    return {items: items, hasMore: items.length > 0};\n}\n\nasync function search(arg) {\n    const keyword = str(arg && arg.keyword).trim();\n    if (!keyword) return {items: [], hasMore: false};\n    const page = Math.max(1, intVal(arg && arg.page, 1));\n    const enc = encodeURIComponent(keyword);\n    const path = page <= 1 ? \"/search/\" + enc + \"/\" : \"/search/\" + enc + \"/page/\" + page + \"/\";\n    const html = await fetchText(path);\n    const items = parseCards(html);\n    return {items: items, hasMore: items.length >= 10};\n}\n\nfunction postIdOf(raw) {\n    let s = str(raw).trim();\n    if (s.indexOf(\"post:\") === 0) s = s.slice(5);\n    const m = /(\\d+)/.exec(s);\n    return m ? m[1] : \"\";\n}\n\nasync function detail(arg) {\n    const pid = postIdOf(arg && arg.id);\n    if (!pid) throw new Error(\"invalid post id\");\n    const html = await fetchText(\"/archives/\" + pid + \".html\");\n    if (!html) throw new Error(\"hl365 empty response\");\n    let title = \"\";\n    const tm = /<title>([^<]+)<\\/title>/.exec(html);\n    if (tm) {\n        title = clean(tm[1]);\n        const suffix = \" - 黑料不打烊\";\n        if (title.slice(-suffix.length) === suffix) title = title.slice(0, -suffix.length).trim();\n    }\n    const configs = parseConfigs(html);\n    let cover = \"\";\n    let desc = \"\";\n    const dm = /<meta name=\"description\"[^>]*content=\"([^\"]*)\"/.exec(html);\n    if (dm) desc = clean(dm[1]);\n    const episodes = [];\n    configs.forEach((cfg, i) => {\n        if (!cover && cfg.video && cfg.video.pic) cover = absUrl(cfg.video.pic);\n        episodes.push({\n            id: \"post:\" + pid + \":\" + i,\n            name: configs.length > 1 ? \"第\" + (i + 1) + \"段\" : \"正片\",\n        });\n    });\n    if (!cover) {\n        const cm = /z-image-loader-url=\"([^\"]+)\"/.exec(html);\n        if (cm) cover = absUrl(cm[1]);\n    }\n    if (!title) title = \"文章 \" + pid;\n    return {\n        id: \"post:\" + pid,\n        title: title,\n        cover: cover,\n        desc: desc,\n        tags: [],\n        lines: episodes.length ? [{name: \"选集\", episodes: episodes}] : [],\n    };\n}\n\nasync function resolveMaster(url, headers) {\n    const text = await fetchRaw(url, headers);\n    if (!text || text.indexOf(\"#EXT-X-STREAM-INF\") < 0) return url;\n    const lines = text.split(/\\r?\\n/).map((s) => s.trim()).filter((s) => s.length > 0);\n    for (let i = 0; i < lines.length; i++) {\n        if (lines[i].indexOf(\"#EXT-X-STREAM-INF\") === 0) {\n            for (let j = i + 1; j < lines.length; j++) {\n                if (lines[j].charAt(0) !== \"#\") {\n                    try {\n                        return new URL(lines[j], url).href;\n                    } catch (e) {\n                        return url;\n                    }\n                }\n            }\n        }\n    }\n    return url;\n}\n\nasync function play(arg) {\n    let raw = str((arg && arg.episodeId) || (arg && arg.id) || \"\");\n    if (raw.indexOf(\"$\") >= 0) raw = raw.split(\"$\").pop() || \"\";\n    const m = /post:(\\d+)(?::(\\d+))?/.exec(raw) || /(\\d+)(?::(\\d+))?/.exec(raw);\n    if (!m) throw new Error(\"invalid play id\");\n    const pid = m[1];\n    const idx = intVal(m[2], 0);\n    const html = await fetchText(\"/archives/\" + pid + \".html\");\n    const configs = parseConfigs(html);\n    const cfg = configs[idx] || configs[0];\n    const url = cfg ? configUrl(cfg) : \"\";\n    if (!url) throw new Error(\"hl365 no video in post \" + pid);\n    const base = BASES[goodBase];\n    const headers = {\"User-Agent\": UA, \"Referer\": base + \"/\"};\n    let finalUrl = url;\n    if (/\\.m3u8($|\\?)/i.test(url)) {\n        finalUrl = await resolveMaster(url, headers);\n    }\n    return {\n        streams: [{\n            url: finalUrl,\n            format: /\\.m3u8($|\\?)/i.test(finalUrl) ? \"hls\" : \"mp4\",\n            headers: headers,\n            name: \"黑料不打烊\",\n        }],\n        expiresAt: Date.now() + 3600 * 1000,\n    };\n}\n\nexport default {home, category, search, detail, play};\n"}}