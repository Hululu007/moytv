{"manifest":{"schema":1,"id":"com.idj.ext.coolinet","name":"酷愛成人網","version":"1.0.0","author":{"name":"py 蜘蛛改写"},"description":"酷愛成人網（WP 全站直取）。分类 8 个与内置蜘蛛硬编码表 1:1（最新發表 + 中文字幕/亞洲AV/歐美AV/直播/亞洲自拍偷拍/歐美自拍偷拍/性感美圖），与现行站点导航逐项一致（站上另有非视频的「公告」分类，蜘蛛未收、插件同样不收）；列表页 videoPost 卡片正则直取、详情走 WP REST 接口（posts?_embed=1）加 /?p= 网页兜底、播放 iframe 三条 player=1/2/3 线路、play 现取播放页 m3u8 并预解析主清单，全部照原蜘蛛 1:1 复刻；蜘蛛第一主机 230304.xyz 现 301 跳往无关站 52papa.tv，插件以实测活站 coolinet.net 为主、旧主机兜底且靠正文特征词校验不误收跳转页。由内置 jar 蜘蛛 ZakaCoolAmns 改写。","type":"video","adult":true,"language":["zh"],"minAppVersion":"1.5","entry":"main.js","permissions":{"http":["coolinet.net","www.coolinet.net","230304.xyz","www.230304.xyz","52papa.tv","www.52papa.tv","*.yocoolnet.in"],"media":["*.yocoolnet.in","coolinet.net","www.coolinet.net"],"cloudflare":false,"storage":true,"login":false},"capabilities":["home","category","search","detail","play"],"settings":[],"update":{"url":"https://raw.githubusercontent.com/hoyittvggfh45/moytv/plugins/coolinet/coolinet.idjplugin"},"integrity":"sha256-Xj0xJDtsOy4f7zR/I4NoZcz4ecZD+K9JJ9IvkJute3c="},"files":{"main.js":"// coolinet - idj1 plugin, rewritten from the built-in jar spider\n// com.github.catvod.spider.ZakaCoolAmns (registry key coolinet,\n// name \"🔞🆕酷愛成人網┃WP全站直取\", ext empty). WordPress station:\n// list pages carry <div class=\"videoPost\" id=\"post-<id>\"> cards\n// (thlink / videoLink title / first <img> cover / thumbViews\n// remarks), category paths are /category/<slug>/ with /page/<n>/\n// paging, search is /?s=<kw>, detail comes from the WP REST API\n// /wp-json/wp/v2/posts/<id>?_embed=1 (title.rendered, date,\n// content.rendered, _embedded featured media, category ids mapped\n// back to names) with an HTML fallback on /?p=<id>, and the play\n// iframe (player_coolinet on *.yocoolnet.in) is emitted as three\n// lines differing only in the player=1/2/3 parameter; play fetches\n// the player page with Referer https://www.coolinet.net/ and picks\n// the m3u8 (loadSource(...) first). All copied 1:1 from the spider.\n// One live update, documented in verdict.json: the spider's first\n// host https://www.230304.xyz now 301-redirects to an unrelated\n// site (www.52papa.tv), so the verified live host\n// https://www.coolinet.net is tried first and the spider host stays\n// as fallback (the spider's body-needle check keeps a redirected\n// foreign page from ever being accepted). Categories are the\n// spider's hardcoded table: home (最新發表) plus 7 slugs, which\n// matches the live site navigation 1:1 (the site's extra 公告 /\n// bulletin section is an announcement category the spider never\n// carried and the plugin does not either).\n\nconst HOSTS = [\"https://www.coolinet.net\", \"https://www.230304.xyz\"];\nconst PLAYER_REF = \"https://www.coolinet.net/\";\nconst UA = \"Mozilla/5.0 (Linux; Android 12) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Mobile Safari/537.36\";\nconst PAGE = 20;\nconst TIMEOUT = 55000;\nconst ATTEMPTS = 2;\n\n// [slug, name, wp category id] -- slug/name 1:1 from the spider's\n// CATS, id from the spider's cidBySlug (used only to map REST\n// category ids back to names in detail).\nconst CATS = [\n    [\"chinese-subtitle\", \"中文字幕\", 60],\n    [\"asia-video\", \"亞洲AV\", 50],\n    [\"eu-us-movie\", \"歐美AV\", 4],\n    [\"%e7%9b%b4%e6%92%ad\", \"直播\", 64],\n    [\"%e4%ba%9e%e6%b4%b2%e8%87%aa%e6%8b%8d%e5%81%b7%e6%8b%8d\", \"亞洲自拍偷拍\", 56],\n    [\"eu-us-self\", \"歐美自拍偷拍\", 49],\n    [\"%e6%80%a7%e6%84%9f%e7%be%8e%e5%9c%96\", \"性感美圖\", 65],\n];\nconst CAT_IDS = {};\nfor (const c of CATS) CAT_IDS[c[0]] = true;\nconst LINE_NAMES = [\"酷愛①\", \"酷愛②\", \"酷愛③\"];\n\nconst cardCache = {};\n\nfunction str(v) { return v == null ? \"\" : String(v); }\nfunction intVal(v, fb) { const n = parseInt(v, 10); return isFinite(n) ? n : fb; }\n\nfunction unesc(s) {\n    if (s == null) return \"\";\n    let out = String(s)\n        .replace(/&amp;/g, \"&\").replace(/&lt;/g, \"<\").replace(/&gt;/g, \">\")\n        .replace(/&quot;/g, \"\\\"\").replace(/&#039;/g, \"'\").replace(/&apos;/g, \"'\")\n        .replace(/&nbsp;/g, \" \").replace(/&hellip;/g, \"…\").replace(/&mdash;/g, \"—\")\n        .replace(/&ndash;/g, \"–\").replace(/&rsquo;/g, \"’\").replace(/&lsquo;/g, \"‘\")\n        .replace(/&ldquo;/g, \"“\").replace(/&rdquo;/g, \"”\").replace(/&middot;/g, \"·\");\n    out = out.replace(/&#(x?)([0-9a-fA-F]+);/g, (m, x, digits) => {\n        const code = x ? parseInt(digits, 16) : parseInt(digits, 10);\n        if (code > 0 && code <= 0x10FFFF) {\n            try { return String.fromCodePoint(code); } catch (e) { return m; }\n        }\n        return m;\n    });\n    return out;\n}\n\n// Spider strip(): drop script/style, <br> and </p> become newlines,\n// tags become spaces, unescape, collapse blanks, cap 1200 chars.\nfunction strip(s) {\n    if (s == null) return \"\";\n    let out = unesc(String(s)\n        .replace(/<script[\\s\\S]*?<\\/script>/gi, \" \")\n        .replace(/<style[\\s\\S]*?<\\/style>/gi, \" \")\n        .replace(/<br\\s*\\/?>/gi, \"\\n\")\n        .replace(/<\\/p>/gi, \"\\n\")\n        .replace(/<[^>]+>/g, \" \"))\n        .replace(/ /g, \" \")\n        .replace(/[ \\t\\x0B\\f\\r]+/g, \" \")\n        .replace(/\\n{2,}/g, \"\\n\");\n    if (out.length > 1200) out = out.slice(0, 1200);\n    return out.trim();\n}\n\nfunction hdr(hostBase, accept) {\n    const h = {\n        \"User-Agent\": UA,\n        \"Accept\": accept || \"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\",\n        \"Accept-Language\": \"zh-TW,zh;q=0.9,en;q=0.8\",\n    };\n    if (hostBase && hostBase.length > 8) h[\"Referer\"] = hostBase + \"/\";\n    return h;\n}\n\nasync function fetchBody(url, headers, attempts) {\n    let lastErr = null;\n    const n = attempts || ATTEMPTS;\n    for (let i = 0; i < n; i++) {\n        try {\n            const resp = await host.http.get(url, {headers: headers || {}, timeout: TIMEOUT});\n            if (resp && resp.body) return String(resp.body);\n            lastErr = new Error(\"http \" + (resp ? resp.status : \"no response\") + \" \" + url);\n        } catch (e) {\n            lastErr = e;\n        }\n    }\n    if (lastErr) host.log(\"coolinet fetch failed\", url, String(lastErr && lastErr.message));\n    return \"\";\n}\n\n// Spider html(): try each host in order, accept the first body of\n// at least 1500 chars containing the needle.\nasync function html(path, needle) {\n    for (const base of HOSTS) {\n        const body = await fetchBody(base + path, hdr(base), ATTEMPTS);\n        if (body && body.length >= 1500 && (!needle || body.indexOf(needle) >= 0)) return body;\n    }\n    return \"\";\n}\n\n// Spider rest(): same host walk, Accept json, body at least 60\n// chars starting with { or [.\nasync function rest(path) {\n    for (const base of HOSTS) {\n        const body = await fetchBody(base + path, hdr(base, \"application/json,*/*\"), ATTEMPTS);\n        if (body && body.length >= 60 && (body.charAt(0) === \"{\" || body.charAt(0) === \"[\")) return body;\n    }\n    return \"\";\n}\n\nfunction cacheCard(item) {\n    if (!item || !item.id) return;\n    cardCache[item.id] = item;\n    try { host.storage.set(\"card:\" + item.id, JSON.stringify(item)); } catch (e) {}\n}\n\nfunction cachedCard(id) {\n    if (cardCache[id]) return cardCache[id];\n    try {\n        const raw = host.storage.get(\"card:\" + id);\n        if (raw) {\n            const obj = JSON.parse(raw);\n            cardCache[id] = obj;\n            return obj;\n        }\n    } catch (e) {}\n    return null;\n}\n\n// Spider cards(): split on <div class=\"videoPost\", 3000-char\n// window per card; id from id=\"post-(\\d+)\", title from the\n// videoLink title attribute (fallback: any title attribute),\n// cover from the first <img src>, remarks from thumbViews with\n// \" 觀看\" replaced by \"次\".\nfunction parseCards(pageHtml) {\n    const out = [];\n    if (!pageHtml || pageHtml.length < 500) return out;\n    const parts = pageHtml.split('<div class=\"videoPost\"');\n    for (let i = 1; i < parts.length; i++) {\n        let win = parts[i];\n        if (win.length > 3000) win = win.slice(0, 3000);\n        const idM = /id=\"post-(\\d+)\"/.exec(win);\n        if (!idM) continue;\n        const id = idM[1];\n        let title = \"\";\n        const tM = /<a[^>]*class=\"videoLink\"[^>]*title=\"([^\"]*)\"/i.exec(win);\n        if (tM) title = unesc(tM[1]);\n        if (!title) {\n            const t2 = /title=\"([^\"]+)\"/.exec(win);\n            if (t2) title = unesc(t2[1]);\n        }\n        let cover = \"\";\n        const img = /<img[^>]*src=\"([^\"]+)\"/i.exec(win);\n        if (img) cover = img[1];\n        let remarks = \"\";\n        const vM = /thumbViews\">([^<]*)</i.exec(win);\n        if (vM) {\n            const v = unesc(vM[1]).trim();\n            if (v) remarks = v.split(\" 觀看\").join(\"次\");\n        }\n        const item = {id: id, title: title || (\"酷愛 #\" + id), cover: cover, remarks: remarks};\n        cacheCard(item);\n        out.push(item);\n    }\n    return out;\n}\n\nfunction pageCountOf(pageHtml, curPage) {\n    let pc = curPage + 1;\n    const m = /class=\"end\"[^>]*href=\"[^\"]*?\\/page\\/(\\d+)\\/\"/.exec(pageHtml || \"\");\n    if (m) {\n        const n = parseInt(m[1], 10);\n        if (isFinite(n) && n > 0) pc = n;\n    }\n    return pc;\n}\n\nasync function home() {\n    const categories = [{id: \"home\", name: \"最新發表\"}];\n    for (const c of CATS) categories.push({id: c[0], name: c[1]});\n    let items = [];\n    try {\n        items = parseCards(await html(\"/\", \"videoPost\"));\n    } catch (e) {\n        items = [];\n    }\n    return {categories: categories, items: items, hasMore: items.length > 0};\n}\n\nasync function category(arg) {\n    const page = Math.max(1, intVal(arg && arg.page, 1));\n    let tid = str(arg && arg.id).trim();\n    let path;\n    if (!tid || tid === \"home\") {\n        path = page > 1 ? \"/page/\" + page + \"/\" : \"/\";\n    } else {\n        if (!CAT_IDS[tid]) throw new Error(\"coolinet unknown category \" + tid);\n        path = \"/category/\" + tid + \"/\" + (page <= 1 ? \"\" : \"page/\" + page + \"/\");\n    }\n    const body = await html(path, \"videoPost\");\n    const items = parseCards(body);\n    const pc = pageCountOf(body, page);\n    return {items: items, hasMore: page < pc};\n}\n\nasync function search(arg) {\n    const keyword = str(arg && arg.keyword).trim();\n    if (!keyword) return {items: [], hasMore: false};\n    const page = Math.max(1, intVal(arg && arg.page, 1));\n    const path = (page > 1 ? \"/page/\" + page + \"/\" : \"/\") + \"?s=\" + encodeURIComponent(keyword);\n    let items = parseCards(await html(path, \"videoPost\"));\n    if (!items.length) items = parseCards(await html(path, \"post-\"));\n    return {items: items, hasMore: items.length >= PAGE};\n}\n\n// Spider num(): take the part after the first \":\" if present,\n// then parseInt.\nfunction numOf(idStr) {\n    let s = str(idStr);\n    const c = s.indexOf(\":\");\n    if (c >= 0) s = s.slice(c + 1);\n    const n = parseInt(s.trim(), 10);\n    return isFinite(n) ? n : 0;\n}\n\nfunction catNames(catIds) {\n    if (!Array.isArray(catIds) || !catIds.length) return \"\";\n    const names = [];\n    for (const cid of catIds) {\n        for (const c of CATS) {\n            if (c[2] === cid) { names.push(c[1]); break; }\n        }\n    }\n    return names.join(\" / \");\n}\n\n// Spider embeddedPic(): _embedded[\"wp:featuredmedia\"][0]\n// source_url, else media_details.sizes medium_large / large /\n// full source_url.\nfunction embeddedPic(post) {\n    try {\n        const emb = post && post._embedded;\n        const media = emb && emb[\"wp:featuredmedia\"];\n        if (!Array.isArray(media) || !media.length) return \"\";\n        const m0 = media[0];\n        if (!m0) return \"\";\n        if (m0.source_url) return String(m0.source_url);\n        const sizes = m0.media_details && m0.media_details.sizes;\n        if (!sizes) return \"\";\n        for (const key of [\"medium_large\", \"large\", \"full\"]) {\n            if (sizes[key] && sizes[key].source_url) return String(sizes[key].source_url);\n        }\n        return \"\";\n    } catch (e) {\n        return \"\";\n    }\n}\n\nasync function mediaUrl(mediaId) {\n    if (!mediaId || mediaId <= 0) return \"\";\n    const body = await rest(\"/wp-json/wp/v2/media/\" + mediaId);\n    if (!body || body.length < 40) return \"\";\n    try {\n        const obj = JSON.parse(body);\n        if (obj.source_url) return String(obj.source_url);\n        if (obj.media_details && obj.media_details.source_url) return String(obj.media_details.source_url);\n    } catch (e) {}\n    return \"\";\n}\n\n// Spider iframeSrc(): player_coolinet src on //video... hosts,\n// then any https player_coolinet, then *.yocoolnet.in player URLs\n// (https or protocol-relative).\nfunction iframeSrc(s) {\n    if (!s || s.length < PAGE) return \"\";\n    let m = /src=\"(\\/\\/video[^\"']*player_coolinet[^\"']*)\"/.exec(s);\n    if (m) return m[1];\n    m = /src=\"(https?:\\/\\/[^\"']*player_coolinet[^\"']*)\"/.exec(s);\n    if (m) return m[1];\n    m = /(https?:\\/\\/[a-z0-9.\\-]*yocoolnet\\.in[^\"'\\s<]*player[^\"'\\s<]*)/.exec(s);\n    if (m) return m[1];\n    m = /(\\/\\/[a-z0-9.\\-]*yocoolnet\\.in[^\"'\\s<]*player[^\"'\\s<]*)/.exec(s);\n    if (m) return m[1];\n    return \"\";\n}\n\n// Spider withPlayer(): // gains https:, http:// upgrades to\n// https://, and player=\\d+ is replaced with player=<n>.\nfunction withPlayer(raw, n) {\n    let s = str(raw).trim();\n    if (s.indexOf(\"//\") === 0) s = \"https:\" + s;\n    if (s.indexOf(\"http://\") === 0) s = \"https://\" + s.slice(7);\n    return s.replace(/player=\\d+/, \"player=\" + n);\n}\n\nfunction b64Encode(s) {\n    return host.codec.base64Encode(str(s));\n}\n\nfunction b64Decode(s) {\n    try { return host.codec.base64Decode(str(s)); } catch (e) { return \"\"; }\n}\n\nasync function detail(arg) {\n    const rawId = str(arg && arg.id).trim();\n    const idNum = numOf(rawId);\n    if (idNum <= 0) throw new Error(\"coolinet invalid id \" + rawId);\n    let title = \"\";\n    let date = \"\";\n    let content = \"\";\n    let pic = \"\";\n    let cats = \"\";\n    let iframe = \"\";\n    const body = await rest(\"/wp-json/wp/v2/posts/\" + idNum + \"?_embed=1\");\n    if (body && body.length > 40) {\n        try {\n            const post = JSON.parse(body);\n            if (post.title && post.title.rendered) title = unesc(post.title.rendered);\n            date = str(post.date);\n            const rendered = post.content && post.content.rendered ? String(post.content.rendered) : \"\";\n            content = strip(rendered);\n            pic = embeddedPic(post);\n            if (!pic) pic = await mediaUrl(intVal(post.featured_media, 0));\n            cats = catNames(post.categories);\n            iframe = iframeSrc(rendered);\n            if (!iframe) {\n                const ex = post.excerpt && post.excerpt.rendered ? String(post.excerpt.rendered) : str(post.excerpt);\n                iframe = iframeSrc(ex);\n            }\n        } catch (e) {}\n    }\n    // Spider HTML fallback when the REST pass left title or\n    // iframe empty: /?p=<id> must contain \"allmyplayer\".\n    if (!title || !iframe) {\n        const pageHtml = await html(\"/?p=\" + idNum, \"allmyplayer\");\n        if (pageHtml) {\n            if (!title) {\n                const h2 = /<h2[^>]*>([\\s\\S]*?)<\\/h2>/i.exec(pageHtml);\n                if (h2) title = unesc(strip(h2[1]));\n            }\n            if (!title) {\n                const tm = /<title>([\\s\\S]*?)<\\/title>/i.exec(pageHtml);\n                if (tm) title = unesc(tm[1]).split(\"酷愛成人網\").join(\"\").split(\"–coolinet.net\").join(\"\").trim();\n            }\n            if (!iframe) iframe = iframeSrc(pageHtml);\n            if (!content) {\n                const cm = /id=\"videoPostContent\">([\\s\\S]*?)<\\/div>/i.exec(pageHtml);\n                if (cm) content = strip(cm[1]);\n            }\n            if (!cats) {\n                const hm = /class=\"[^\"]*hentry([^\"]*)\"/.exec(pageHtml);\n                if (hm) cats = hm[1].split(\"category-\").join(\"\").split(\"tag-\").join(\"\").trim();\n            }\n        }\n    }\n    const cached = cachedCard(rawId) || cachedCard(String(idNum));\n    if (!title && cached) title = cached.title;\n    if (!pic && cached) pic = cached.cover;\n    if (!title) title = \"酷愛 #\" + idNum;\n    const descParts = [];\n    if (cats) descParts.push(\"分類：\" + cats);\n    if (content) descParts.push(content);\n    let remarks = \"\";\n    if (date.length >= 10) remarks = date.slice(5, 10).replace(\"-\", \"/\");\n    else if (cached) remarks = cached.remarks || \"\";\n    const lines = [];\n    if (iframe && iframe.length > PAGE) {\n        for (let i = 0; i < 3; i++) {\n            const u = withPlayer(iframe, i + 1);\n            if (u.length >= PAGE) {\n                lines.push({name: LINE_NAMES[i], episodes: [{id: b64Encode(u), name: \"正片\"}]});\n            }\n        }\n    }\n    return {\n        id: rawId,\n        title: title,\n        cover: pic,\n        desc: descParts.join(\"\\n\"),\n        tags: cats ? cats.split(\" / \") : [],\n        remarks: remarks,\n        year: date.length >= 4 ? date.slice(0, 4) : \"\",\n        lines: lines,\n    };\n}\n\n// Spider pickM3u8(): loadSource('...m3u8') first, then a quoted\n// m3u8 URL, then any bare m3u8 URL.\nfunction pickM3u8(s) {\n    if (!s) return \"\";\n    let m = /loadSource\\(\\s*[\"']([^\"']+\\.m3u8[^\"']*)[\"']/.exec(s);\n    if (m) return m[1];\n    m = /[\"'](https?:\\/\\/[^\"'\\s<>]+?\\.m3u8[^\"'\\s<>]*)[\"']/.exec(s);\n    if (m) return m[1];\n    m = /(https?:\\/\\/[^\"'\\s<>]+?\\.m3u8[^\"'\\s<>]*)/.exec(s);\n    if (m) return m[1];\n    return \"\";\n}\n\n// Spider resolve(): fetch the player page with the site root as\n// Referer; a page that only carries the \"想看A片\" gate text and\n// no m3u8 counts as unresolvable.\nasync function resolvePlayer(playerUrl) {\n    let u = str(playerUrl).trim();\n    if (u.indexOf(\"//\") === 0) u = \"https:\" + u;\n    if (!u) return \"\";\n    const headers = {\n        \"User-Agent\": UA,\n        \"Accept\": \"text/html,*/*\",\n        \"Accept-Language\": \"zh-TW,zh;q=0.9\",\n        \"Referer\": PLAYER_REF,\n    };\n    const body = await fetchBody(u, headers, ATTEMPTS);\n    if (body && body.length >= 400) {\n        if (body.indexOf(\"想看A片\") >= 0 && body.indexOf(\"m3u8\") < 0) return \"\";\n        return pickM3u8(body);\n    }\n    return \"\";\n}\n\nfunction resolveRelative(base, rel) {\n    const r = str(rel).trim();\n    if (!r) return base;\n    if (/^https?:\\/\\//i.test(r)) return r;\n    if (r.indexOf(\"//\") === 0) return \"https:\" + r;\n    if (r.charAt(0) === \"/\") {\n        const m = /^(https?:\\/\\/[^/]+)/i.exec(base);\n        return (m ? m[1] : \"\") + r;\n    }\n    const cut = base.lastIndexOf(\"/\");\n    return (cut >= 0 ? base.slice(0, cut + 1) : base) + r;\n}\n\n// play()-side master-playlist pre-resolution, string ops only\n// (the sandbox has no URL global).\nasync function resolveMaster(url, headers) {\n    const text = await fetchBody(url, headers, ATTEMPTS);\n    if (!text || text.indexOf(\"#EXT-X-STREAM-INF\") < 0) return url;\n    const lines = text.split(/\\r?\\n/).map((s) => s.trim()).filter((s) => s.length > 0);\n    for (let i = 0; i < lines.length; i++) {\n        if (lines[i].indexOf(\"#EXT-X-STREAM-INF\") === 0) {\n            for (let j = i + 1; j < lines.length; j++) {\n                if (lines[j].charAt(0) !== \"#\") return resolveRelative(url, lines[j]);\n            }\n        }\n    }\n    return url;\n}\n\nasync function play(arg) {\n    let raw = str((arg && arg.episodeId) || (arg && arg.id) || \"\").trim();\n    if (raw.indexOf(\"$\") >= 0) raw = raw.split(\"$\").pop() || \"\";\n    let playerUrl = raw;\n    if (!/^https?:\\/\\//i.test(playerUrl)) {\n        playerUrl = b64Decode(raw);\n    }\n    if (!playerUrl || !/^https?:\\/\\//i.test(playerUrl)) throw new Error(\"coolinet bad episode id\");\n    if (playerUrl.indexOf(\"http://\") === 0) playerUrl = \"https://\" + playerUrl.slice(7);\n    let stream = await resolvePlayer(playerUrl);\n    if (!stream) {\n        // The three detail lines differ only in player=<n>; if the\n        // requested player page yields nothing, walk the other\n        // player numbers before giving up (same iframe, same id).\n        for (let n = 1; n <= 3 && !stream; n++) {\n            const alt = playerUrl.replace(/player=\\d+/, \"player=\" + n);\n            if (alt !== playerUrl) stream = await resolvePlayer(alt);\n        }\n    }\n    if (!stream || !/^https:\\/\\//i.test(stream)) throw new Error(\"coolinet no playable url\");\n    const headers = {\"User-Agent\": UA};\n    let finalUrl = stream;\n    if (/\\.m3u8($|\\?)/i.test(stream)) {\n        finalUrl = await resolveMaster(stream, headers);\n    }\n    return {\n        streams: [{\n            url: finalUrl,\n            format: /\\.m3u8($|\\?)/i.test(finalUrl) ? \"hls\" : \"mp4\",\n            headers: headers,\n            name: \"酷愛成人網\",\n        }],\n        expiresAt: Date.now() + 3600 * 1000,\n    };\n}\n\nexport default {home, category, search, detail, play};\n"}}