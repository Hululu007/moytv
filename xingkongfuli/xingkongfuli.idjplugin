{"manifest":{"schema":1,"id":"com.idj.ext.xingkongfuli","name":"星空福利视频","version":"1.0.0","author":{"name":"py 蜘蛛改写"},"description":"星空福利视频（xksp1359.lol）。5 个分类（与原 py 完全一致），MacCMS 整站 HTML 解析，播放页 player_aaaa 现取 m3u8 直链播放。由内置 py 蜘蛛改写。","type":"video","adult":true,"language":["zh"],"minAppVersion":"1.5","entry":"main.js","permissions":{"http":["xksp1359.lol","*.cdn-xj.cc"],"media":["*.cdn-xj.cc","*.cdn-99.cc"],"cloudflare":false,"storage":false,"login":false},"capabilities":["home","category","search","detail","play"],"settings":[],"update":{"url":"https://raw.githubusercontent.com/hoyittvggfh45/moytv/plugins/xingkongfuli/xingkongfuli.idjplugin"},"integrity":"sha256-6EdMcgBSUfqX0xg57CmuYwR7L814Jo0fkQMEjMGrI78="},"files":{"main.js":"// xingkongfuli - idj1 plugin (rewritten 1:1 from the built-in py spider)\n// Site: https://xksp1359.lol, MacCMS HTML, no API, no encryption.\n// Categories: parsed from the home page nav, falling back to the hardcoded\n// table from the py spider when parsing finds nothing.\n// Play: the detail flow fetches the play page and reads player_aaaa.url as\n// the m3u8; play() pre-resolves a master playlist to its sub-playlist.\n// The site is slow from this network, so timeout is widened and requests\n// are retried, mirroring the py spider.\n\nconst BASE = \"https://xksp1359.lol\";\nconst UA = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36\";\nconst TIMEOUT = 58000;\nconst RETRIES = 3;\n\nconst CATS = [\n    [\"75\", \"国产视频\"],\n    [\"88\", \"日韩AV\"],\n    [\"94\", \"蓝光超清\"],\n    [\"99\", \"欧美视频\"],\n    [\"103\", \"动漫精选\"],\n];\n\nfunction str(value) {\n    if (value == null) return \"\";\n    return String(value);\n}\n\nfunction intValue(value, fallback) {\n    const number = parseInt(value, 10);\n    return isFinite(number) ? number : fallback;\n}\n\nfunction decodeText(s) {\n    let out = str(s);\n    if (!out) return \"\";\n    out = out.replace(/&#x([0-9a-fA-F]+);/g, function (m, hex) {\n        try { return String.fromCodePoint(parseInt(hex, 16)); } catch (e) { return m; }\n    });\n    out = out.replace(/&#(\\d+);/g, function (m, dec) {\n        try { return String.fromCodePoint(parseInt(dec, 10)); } catch (e) { return m; }\n    });\n    out = out.replace(/&amp;/g, \"&\").replace(/&lt;/g, \"<\").replace(/&gt;/g, \">\")\n        .replace(/&quot;/g, '\"').replace(/&apos;/g, \"'\").replace(/&#39;/g, \"'\")\n        .replace(/&nbsp;/g, \" \");\n    return out.replace(/\\\\\\//g, \"/\").trim();\n}\n\nfunction cleanText(s) {\n    const noTags = str(s).replace(/<[^>]+>/g, \" \");\n    return decodeText(noTags.replace(/\\s+/g, \" \"));\n}\n\nfunction fixUrl(raw) {\n    const u = str(raw).trim();\n    if (!u) return \"\";\n    if (u.indexOf(\"//\") === 0) return \"https:\" + u;\n    if (u.charAt(0) === \"/\") return BASE + u;\n    return u;\n}\n\nasync function getHtml(url, referer) {\n    const headers = {\n        \"User-Agent\": UA,\n        \"Accept\": \"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\",\n        \"Referer\": referer || BASE,\n    };\n    let lastError = null;\n    for (let i = 0; i < RETRIES; i++) {\n        try {\n            const resp = await host.http.get(url, {headers: headers, timeout: TIMEOUT});\n            if (resp.status === 200 && resp.body && resp.body.trim()) return resp.body;\n            lastError = new Error(\"HTTP \" + resp.status);\n        } catch (error) {\n            lastError = error;\n        }\n    }\n    if (lastError) host.log(\"xingkongfuli getHtml failed: \" + url + \" \" + (lastError && lastError.message));\n    return \"\";\n}\n\nfunction parseCards(html, mode) {\n    const out = [];\n    const seen = {};\n    let re;\n    if (mode === \"search\") {\n        re = /<a href=\"\\/index\\.php\\/vod\\/play\\/id\\/(\\d+)\\/sid\\/1\\/nid\\/1\\.html\" title=\"[^\"]*?([^\"]+)\"[^>]*>[\\s\\S]*?<img[^>]*data-src=\"([^\"]+)\"/g;\n    } else {\n        re = /<a href=\"\\/index\\.php\\/vod\\/detail\\/id\\/(\\d+)\\.html\" title=\"([^\"]+)\"[^>]*>[\\s\\S]*?<img[^>]*data-src=\"([^\"]+)\"/g;\n    }\n    let m;\n    while ((m = re.exec(html || \"\")) !== null) {\n        const vid = m[1].trim();\n        if (!vid || seen[vid]) continue;\n        let title = decodeText(m[2]);\n        if (mode === \"search\") title = title.replace(/^立刻播放/, \"\").trim();\n        const cover = fixUrl(m[3]);\n        if (!title || !cover) continue;\n        seen[vid] = true;\n        out.push({id: vid, title: title, cover: cover, remarks: \"\", duration: \"\", tags: []});\n    }\n    return out;\n}\n\nfunction parseCategories(html) {\n    const out = [];\n    const seen = {};\n    const re = /<a class=\"nav-link[^\"]*\"[^>]*href=\"\\/index\\.php\\/vod\\/type\\/id\\/(\\d+)\\.html\"[^>]*>([\\s\\S]*?)<\\/a>/g;\n    let m;\n    while ((m = re.exec(html || \"\")) !== null) {\n        const cid = m[1];\n        const name = cleanText(m[2]);\n        if (!name || seen[cid]) continue;\n        seen[cid] = true;\n        out.push({id: cid, name: name});\n    }\n    return out;\n}\n\nasync function fetchCats() {\n    const html = await getHtml(BASE, BASE + \"/\");\n    const cats = parseCategories(html);\n    if (cats.length) return cats;\n    return CATS.map(function (item) { return {id: item[0], name: item[1]}; });\n}\n\nasync function catalog(tid, pg) {\n    let url;\n    if (pg <= 1) {\n        url = BASE + \"/index.php/vod/show/id/\" + tid + \".html\";\n    } else {\n        url = BASE + \"/index.php/vod/show/id/\" + tid + \"/page/\" + pg + \".html\";\n    }\n    const html = await getHtml(url, BASE + \"/\");\n    return parseCards(html, \"list\");\n}\n\nasync function home() {\n    const categories = await fetchCats();\n    let items = [];\n    if (categories.length) {\n        items = await catalog(categories[0].id, 1);\n    }\n    return {categories: categories, items: items, hasMore: items.length > 0};\n}\n\nasync function category(arg) {\n    const page = Math.max(1, intValue(arg && arg.page, 1));\n    const tid = str(arg && arg.id).trim() || CATS[0][0];\n    const items = await catalog(tid, page);\n    return {items: items, hasMore: items.length >= 24};\n}\n\nasync function search(arg) {\n    const keyword = str(arg && arg.keyword).trim();\n    if (!keyword) return {items: [], hasMore: false};\n    const url = BASE + \"/index.php/vod/search.html?wd=\" + encodeURIComponent(keyword);\n    const html = await getHtml(url, BASE + \"/\");\n    return {items: parseCards(html, \"search\"), hasMore: false};\n}\n\nasync function detail(arg) {\n    let nid = str(arg && arg.id).trim().replace(/^\\/+|\\/+$/g, \"\");\n    if (nid.indexOf(\"index.php/vod/detail/id/\") === 0) {\n        nid = nid.slice(\"index.php/vod/detail/id/\".length);\n    }\n    nid = nid.split(\"/\")[0].replace(/\\.html$/, \"\");\n    if (!nid) throw host.error(\"E_PARSE\", \"invalid video id\");\n    const html = await getHtml(BASE + \"/index.php/vod/detail/id/\" + nid + \".html\", BASE + \"/\");\n    if (!html) throw host.error(\"E_NETWORK\", \"detail page fetch failed\");\n    const tm = /<h1[^>]*>([\\s\\S]*?)<\\/h1>/.exec(html);\n    const title = tm ? cleanText(tm[1]) : \"\";\n    const cm = /data-src=\"([^\"]+)\"/.exec(html);\n    const cover = cm ? fixUrl(cm[1]) : \"\";\n    const dm = /<meta name=\"description\"[^>]*content=\"([^\"]+)\"/.exec(html);\n    const desc = dm ? decodeText(dm[1]) : \"\";\n    const playHtml = await getHtml(BASE + \"/index.php/vod/play/id/\" + nid + \"/sid/1/nid/1.html\", BASE + \"/\");\n    let m3u8 = \"\";\n    let genre = \"\";\n    if (playHtml) {\n        const pm = /var player_aaaa=(\\{[\\s\\S]*?\\})\\s*<\\/script>/.exec(playHtml);\n        if (pm) {\n            try {\n                const player = JSON.parse(pm[1]);\n                m3u8 = decodeText(player.url || \"\");\n                const vd = player.vod_data || {};\n                if (vd && typeof vd === \"object\") genre = str(vd.vod_class || \"\");\n            } catch (e) { /* handled below */ }\n        }\n    }\n    if (!title || !m3u8) throw host.error(\"E_PARSE\", \"detail parse failed or no play url\");\n    const tags = genre ? [genre] : [];\n    return {\n        id: nid,\n        title: title,\n        cover: cover,\n        desc: desc,\n        tags: tags,\n        lines: [{name: \"在线播放\", episodes: [{id: m3u8, name: \"播放\"}]}],\n    };\n}\n\nasync function play(arg) {\n    let raw = str((arg && arg.episodeId) || (arg && arg.id));\n    if (raw.indexOf(\"$\") >= 0) raw = raw.split(\"$\")[1] || \"\";\n    raw = raw.trim();\n    if (!/^https?:\\/\\//i.test(raw)) throw host.error(\"E_PARSE\", \"invalid play id\");\n    let url = raw;\n    const headers = {\"User-Agent\": UA, \"Referer\": BASE + \"/\"};\n    const isHls = /\\.m3u8($|\\?)/i.test(url);\n    if (isHls) {\n        try {\n            const resp = await host.http.get(url, {headers: headers, timeout: TIMEOUT});\n            if (resp.status === 200 && resp.body && resp.body.indexOf(\"#EXT-X-STREAM-INF\") >= 0) {\n                const lines = resp.body.split(/\\r?\\n/).map(function (s) { return s.trim(); })\n                    .filter(function (s) { return s && s.charAt(0) !== \"#\"; });\n                if (lines.length) url = host.url.resolve(url, lines[0]);\n            }\n        } catch (e) { /* fall back to the original url */ }\n    }\n    return {\n        streams: [{url: url, format: isHls ? \"hls\" : \"mp4\", headers: headers, name: \"在线播放\"}],\n        expiresAt: Date.now() + 3600 * 1000,\n    };\n}\n\nexport default {home: home, category: category, search: search, detail: detail, play: play};\n"}}