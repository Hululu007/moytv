{"manifest":{"schema":1,"id":"com.idj.ext.18av","name":"18AV","version":"1.0.0","author":{"name":"CatVod 蜘蛛改写"},"description":"18AV（18av1.net）。10 个视频分类，内容页加密 blob 经进制+XOR+AES-128 解出 token 再调 play.php 取 m3u8；m3u8 必须带 Referer（play 已带）。","type":"video","adult":true,"language":["zh"],"minAppVersion":"1.5","entry":"main.js","permissions":{"http":["18av1.net","18av02.com","18av01.cc","18av.ws","18av.pw","18av01.net","18av.nl"],"media":["*.vcwinford.cc","gifb.eemmhh01.com","*.vcjuligi.com","*.vcmathe.com"],"cloudflare":false,"storage":false,"login":false},"capabilities":["home","category","search","detail","play"],"settings":[],"update":{"url":"https://raw.githubusercontent.com/hoyittvggfh45/moytv/plugins/18av/18av.idjplugin"},"integrity":"sha256-SU2yI4CJY4hYHImlFKm88loZ2dcI4R3UtcXRefvZl8A="},"files":{"main.js":"// 18av — idj1 插件（2026-11-24 新写，非 CatVod 改写）\n// 站点：https://18av1.net（99dh 第 12 项；镜像 18av02.com / 18av01.cc / 18av.ws / 18av.pw / 18av01.net / 18av.nl）\n// 自有模板（非 MacCMS）：视频分类 /zh/<type>_random/all/index.html（翻页 /all/<页>.html），\n// 搜索 /zh/fc_search/all/<关键词>/<页>.html（fc = 全部影片），内容页 /zh/<type>_content/<id>/<番号>.html。\n// 首页必须是 /enter：站根 / 只回 HTTP 500 的“继续访问”门禁页（2026-11-24 现取实证），\n// /enter 才回真首页（200、136,078 字节、264 个 _content 链接）；home() 故抓 /enter。\n// 播放链（2026-11-24 实测打通）：内容页 mvarr['10_1']（1080p）/ mvarr['11_1']（720p）是加密 blob；\n// 先 decrypto：按页内 hcdeedg252 作进制、分隔符 chr(进制+97)、每段 parseInt(进制) 再 XOR hadeedg252，\n// 得 base64 密文；再 AES 解密（key/iv 取页内 argdeqweqweqwe / hdddedg252，UTF-8，CBC/PKCS7），\n// 得 token；调 //18av1.net/js/player/play.php?numresolution=<画质>&id=<token>，\n// 页内 videoSources 数组取对应画质 m3u8。\n// 注意：m3u8 必须带 Referer（play.php 地址）才回真播放列表，不带只回 143 字节 tip.ts 占位；\n// play() 返回的 streams 里已带 Referer 头。\n//\n// 降级 / 硬限制：\n// - 只做视频分类（10 个）；漫画（18H漫画）、写真图片、国产写真、小说是非视频区，不进插件。\n// - 搜索只搜全部影片（fc）；站内分类型搜索（censoredonly 等）未接。\n// - 内容页的视频预览 mp4（gifb.eemmhh01.com）只是相关视频的悬停预览，不是正片，不用。\n// - 解密常数（进制/XOR/key/iv）逐页从内容页现取；取不到时直接报错，不写死旧值。\n\nconst SITE = \"https://18av1.net\";\nconst UA = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36\";\nconst TIMEOUT = 30000;\n\n// 导航视频分类（home 解析不到时兜底；与 2026-11-24 实抓导航 1:1；漫画/写真/小说是非视频区，不列）\nconst FALLBACK_CATEGORIES = [\n    [\"chinese\", \"中文字幕AV\"], [\"censored\", \"有碼AV\"], [\"uncensored\", \"無碼AV\"],\n    [\"amateurjav\", \"素人AV\"], [\"reducing-mosaic\", \"無碼破解\"], [\"animation\", \"H動畫,H動漫\"],\n    [\"CensoredAnimation\", \"H有碼動畫\"], [\"UncensoredAnimation\", \"H無碼動畫\"],\n    [\"tdAnimation\", \"H_3D動畫\"], [\"dt\", \"國產自拍\"],\n];\n\nfunction str(value) {\n    if (value == null) return \"\";\n    return String(value);\n}\n\nfunction absUrl(url, base) {\n    const value = str(url).trim();\n    if (!value) return \"\";\n    if (/^https?:\\/\\//i.test(value)) return value;\n    if (/^\\/\\//.test(value)) return \"https:\" + value;\n    if (/^\\//.test(value)) return base.replace(/\\/+$/, \"\") + value;\n    return base.replace(/\\/+$/, \"\") + \"/\" + value;\n}\n\nfunction cleanText(value) {\n    return str(value)\n        .replace(/<[^>]*>/g, \" \")\n        .replace(/&nbsp;/gi, \" \")\n        .replace(/&amp;/gi, \"&\")\n        .replace(/&quot;/gi, '\"')\n        .replace(/&#39;|&apos;/gi, \"'\")\n        .replace(/&lt;/gi, \"<\")\n        .replace(/&gt;/gi, \">\")\n        .replace(/\\s+/g, \" \")\n        .trim();\n}\n\nfunction firstMatch(text, regex, index) {\n    const match = regex.exec(text);\n    return match ? str(match[index == null ? 1 : index]) : \"\";\n}\n\nasync function fetchText(url, referer) {\n    const resp = await host.http.request({\n        url: url,\n        method: \"GET\",\n        headers: {\n            \"User-Agent\": UA,\n            \"Referer\": referer || SITE + \"/\",\n            \"Accept\": \"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\",\n            \"Accept-Language\": \"zh-CN,zh;q=0.9\",\n        },\n        timeout: TIMEOUT,\n    });\n    if (resp.status !== 200) throw new Error(\"请求失败 HTTP \" + resp.status + \"：\" + url);\n    return resp.body || \"\";\n}\n\n// 内容页相对路径 -> 插件内影片 id（去掉开头的 / 与 zh/ 前缀无关，保留完整相对路径）\nfunction contentIdFromHref(href) {\n    const path = str(href).replace(/^https?:\\/\\/[^\\/]+/i, \"\").replace(/^\\//, \"\");\n    return path;\n}\n\n// 列表项：<a href=\"..._content/<id>/<slug>.html\"><img src='封面' …></a> … <h3><a href=\"…\">标题</a></h3>\nfunction parseVideos(html) {\n    const items = [];\n    const seen = {};\n    const regex = /<a[^>]+href=\"(https?:\\/\\/18av1\\.net\\/zh\\/\\w+_content\\/\\d+\\/[^\"']+\\.html|\\/zh\\/\\w+_content\\/\\d+\\/[^\"']+\\.html)\"[^>]*>([\\s\\S]{0,600}?)<\\/a>/gi;\n    let match;\n    while ((match = regex.exec(html)) !== null) {\n        const id = contentIdFromHref(match[1]);\n        if (!id || seen[id]) continue;\n        seen[id] = true;\n        const inner = match[2];\n        const cover = absUrl(\n            firstMatch(inner, /<img[^>]+src='([^']+)'/i) || firstMatch(inner, /<img[^>]+src=\"([^\"]+)\"/i),\n            SITE);\n        // 标题在后面 <h3> 的同链接里\n        const tail = html.slice(match.index, match.index + 1500);\n        const title = cleanText(firstMatch(tail, /<h3[^>]*>[\\s\\S]*?<a[^>]*>([\\s\\S]*?)<\\/a>/i));\n        items.push({id: id, title: title || id, cover: cover, remarks: \"\"});\n    }\n    return items;\n}\n\nfunction parseCategories(html) {\n    // 只认视频分类：漫画/写真/小说（cg、cwp、novel、18H漫画）是非视频区，绝不进插件\n    const VIDEO_TYPES = {\n        \"chinese\": true, \"censored\": true, \"uncensored\": true, \"amateurjav\": true,\n        \"reducing-mosaic\": true, \"animation\": true, \"CensoredAnimation\": true,\n        \"UncensoredAnimation\": true, \"tdAnimation\": true, \"dt\": true,\n    };\n    const seen = {};\n    const result = [];\n    const regex = /href=\"https?:\\/\\/18av1\\.net\\/zh\\/([\\w-]+)_random\\/all\\/index\\.html\"[^>]*>([^<]+)<\\/a>/gi;\n    let match;\n    while ((match = regex.exec(html)) !== null) {\n        const id = match[1];\n        const name = cleanText(match[2]);\n        if (!id || !name || seen[id] || !VIDEO_TYPES[id]) continue;\n        seen[id] = true;\n        result.push({id: id, name: name});\n    }\n    if (result.length < FALLBACK_CATEGORIES.length) {\n        // 解析不全时按导航顺序补齐缺失的视频分类（不编新分类，只补已知的 10 个）\n        const have = {};\n        for (const c of result) have[c.id] = true;\n        for (const pair of FALLBACK_CATEGORIES) {\n            if (!have[pair[0]]) result.push({id: pair[0], name: pair[1]});\n        }\n        // 按 FALLBACK 顺序排\n        const order = {};\n        FALLBACK_CATEGORIES.forEach((p, i) => { order[p[0]] = i; });\n        result.sort((a, b) => (order[a.id] || 0) - (order[b.id] || 0));\n    }\n    return result;\n}\n\nfunction pageCount(html, current) {\n    const numbers = [];\n    const regex = /\\/zh\\/\\w+_list\\/all\\/(\\d+)\\.html/gi;\n    let match;\n    while ((match = regex.exec(html)) !== null) numbers.push(parseInt(match[1], 10));\n    if (!numbers.length) return current;\n    const max = Math.max.apply(null, numbers);\n    return Math.max(current, isFinite(max) ? max : current);\n}\n\nfunction listUrl(type, page) {\n    if (page <= 1) return SITE + \"/zh/\" + type + \"_random/all/index.html\";\n    return SITE + \"/zh/\" + type + \"_random/all/\" + page + \".html\";\n}\n\nasync function home() {\n    let html = \"\";\n    try {\n        html = await fetchText(SITE + \"/enter\");\n    } catch (error) {\n        html = \"\";\n    }\n    return {\n        categories: parseCategories(html),\n        items: parseVideos(html),\n        hasMore: false,\n    };\n}\n\nasync function category(arg) {\n    const id = str(arg && arg.id);\n    const page = Math.max(1, parseInt((arg && arg.page) || \"1\", 10) || 1);\n    if (!id) throw new Error(\"无效的分类 ID\");\n    const html = await fetchText(listUrl(id, page));\n    return {\n        items: parseVideos(html),\n        hasMore: pageCount(html, page) > page,\n    };\n}\n\nasync function search(arg) {\n    const keyword = str(arg && arg.keyword).trim();\n    const page = Math.max(1, parseInt((arg && arg.page) || \"1\", 10) || 1);\n    if (!keyword) return {items: [], hasMore: false};\n    const html = await fetchText(\n        SITE + \"/zh/fc_search/all/\" + encodeURIComponent(keyword) + \"/\" + page + \".html\");\n    return {\n        items: parseVideos(html),\n        hasMore: pageCount(html, page) > page,\n    };\n}\n\nasync function detail(arg) {\n    const rawId = str(arg && arg.id);\n    if (!rawId) throw new Error(\"无效的影片 ID\");\n    const url = absUrl(rawId, SITE);\n    let html = \"\";\n    try {\n        html = await fetchText(url);\n    } catch (error) {\n        html = \"\";\n    }\n    let title = cleanText(firstMatch(html, /<title>([^<]*)<\\/title>/i))\n        .replace(/ 18AV.*$/, \"\").replace(/\\s+18AV.*$/, \"\");\n    if (!title) title = rawId;\n    const cover = absUrl(firstMatch(html, /<img[^>]+src='(https?:\\/\\/[^']*\\/18avmmcg\\/b\\/[^']+)'/i)\n        || firstMatch(html, /<img[^>]+src=\"(https?:\\/\\/[^\"]*\\/18avmmcg\\/b\\/[^\"]+)\"/i), SITE);\n    const desc = cleanText(firstMatch(html, /<meta name='description' content='([^']*)'/i)\n        || firstMatch(html, /<meta name=\"description\" content=\"([^\"]*)\"/i));\n    const tags = [];\n    const tagRegex = /\\/zh\\/\\w+_category\\/\\d+\\/([^\\/]+)\\/1\\.html/gi;\n    let tagMatch;\n    while ((tagMatch = tagRegex.exec(html)) !== null) {\n        const tag = cleanText(decodeURIComponent(tagMatch[1]));\n        if (tag && tags.indexOf(tag) === -1) tags.push(tag);\n    }\n    const lines = [];\n    if (/mvarr\\['10_1'\\]/.test(html)) {\n        lines.push({name: \"1080p\", episodes: [{id: \"1080|\" + rawId, name: \"正片\"}]});\n    }\n    if (/mvarr\\['11_1'\\]/.test(html)) {\n        lines.push({name: \"720p\", episodes: [{id: \"720|\" + rawId, name: \"正片\"}]});\n    }\n    return {\n        id: rawId,\n        title: title,\n        cover: cover,\n        desc: desc,\n        tags: tags,\n        lines: lines,\n    };\n}\n\n// 站方 decrypto（见内容页内联脚本 + content_mv_protect.js）：\n// base = hcdeedg252（25 以上取 %25），分隔符 chr(base+97)，每段 parseInt(base) 后 XOR hadeedg252\nfunction decrypto(blob, base, xorv) {\n    let b = base;\n    b = 25 >= b ? b : b % 25;\n    const sep = String.fromCharCode(b + 97);\n    const parts = str(blob).split(sep);\n    let out = \"\";\n    for (let i = 0; i < parts.length; i++) {\n        let k = parseInt(parts[i], b);\n        if (isNaN(k)) continue;\n        k = 1 * k ^ xorv;\n        out += String.fromCharCode(k);\n    }\n    return out;\n}\n\nasync function play(arg) {\n    const raw = str((arg && arg.id) || (arg && arg.episodeId));\n    const bar = raw.indexOf(\"|\");\n    if (bar < 0) throw new Error(\"无效的播放地址\");\n    const res = raw.slice(0, bar);\n    const contentPath = raw.slice(bar + 1);\n    if (!contentPath) throw new Error(\"无效的播放地址\");\n    const pageUrl = absUrl(contentPath, SITE);\n    const html = await fetchText(pageUrl);\n    const base = parseInt(firstMatch(html, /hcdeedg252\\s*=\\s*(\\d+)/i), 10);\n    const xorv = parseInt(firstMatch(html, /hadeedg252\\s*=\\s*(\\d+)/i), 10);\n    const aesKey = firstMatch(html, /argdeqweqweqwe\\s*=\\s*'([^']+)'/i);\n    const aesIv = firstMatch(html, /hdddedg252\\s*=\\s*'([^']+)'/i);\n    if (isNaN(base) || isNaN(xorv) || !aesKey || !aesIv) throw new Error(\"未找到解密参数\");\n    const key = res === \"1080\" ? \"10_1\" : \"11_1\";\n    const mvarr = firstMatch(html, new RegExp(\"mvarr\\\\['\" + key + \"'\\\\]=\\\\[\\\\[[\\\\s\\\\S]*?'([^']{100,})'\"));\n    if (!mvarr) throw new Error(\"未找到播放数据\");\n    const b64 = decrypto(mvarr, base, xorv);\n    if (!b64) throw new Error(\"解密失败\");\n    const token = host.crypto.aes({\n        op: \"decrypt\", key: aesKey, iv: aesIv, data: b64,\n        keyEncoding: \"utf8\", ivEncoding: \"utf8\",\n    });\n    if (!token) throw new Error(\"解密失败\");\n    const playUrl = \"https://18av1.net/js/player/play.php?numresolution=\" + res + \"&id=\" + encodeURIComponent(token);\n    const playerHtml = await fetchText(playUrl, pageUrl);\n    const sources = [];\n    const srcRegex = /\\{src: '([^']+\\.m3u8)',type: 'application\\/x-mpegURL', size: (\\d+)\\}/g;\n    let srcMatch;\n    while ((srcMatch = srcRegex.exec(playerHtml)) !== null) {\n        sources.push({url: absUrl(srcMatch[1], \"https://18av1.net\"), size: parseInt(srcMatch[2], 10)});\n    }\n    if (!sources.length) throw new Error(\"未找到可用播放地址\");\n    let picked = sources[0];\n    for (const s of sources) {\n        if (s.size === parseInt(res, 10)) { picked = s; break; }\n        if (s.size > picked.size) picked = s;\n    }\n    return {\n        streams: [{\n            url: picked.url,\n            format: \"hls\",\n            headers: {\"User-Agent\": UA, \"Referer\": playUrl},\n            name: \"18AV\",\n        }],\n    };\n}\n\nexport default {home: home, category: category, search: search, detail: detail, play: play};\n"}}