{"manifest":{"schema":1,"id":"com.idj.ext.one","name":"🔞一点播","version":"1.0.0","author":{"name":"py 蜘蛛改写"},"description":"一点播（one55.app 的 App 后端，品牌 ONE一个）。域名分发 api.luatiaonli.com 轮换域名池，插件走蜘蛛自带兜底域名池（池内域名互通）；分类：推荐/全部佳丽/有视频/试驾报告+城市（接口动态，最多 48 个）；详情 showvideo 为 MP4 直链，无视频条目为图文。由内置 jar 蜘蛛 One（one.jar）改写。与订阅里 com.idj.bundled.one（ONE一个影片库，/v2.5/bootstrap+discovery+video_download 协议）是不同站不同协议，不重复。","type":"video","adult":true,"language":["zh"],"minAppVersion":"1.5","entry":"main.js","permissions":{"http":["api.luatiaonli.com","api.2963c30e4341.com","api.723a8bd6c5c2.com","api.3b3fe922f7fc.com","api.79b4243b3297.com","api.27bc543eeb3e.com","api.ee5cf45ff4a8.com","api.80619062b9e0.com","api.70f5dd26506c.com","api.08c63eaadefb.xyz","api.70f5dd26506c.xyz"],"media":["api.2963c30e4341.com","api.723a8bd6c5c2.com","api.3b3fe922f7fc.com","api.79b4243b3297.com","api.27bc543eeb3e.com","api.ee5cf45ff4a8.com","api.80619062b9e0.com","api.70f5dd26506c.com","api.08c63eaadefb.xyz","api.70f5dd26506c.xyz"],"cloudflare":false,"storage":true,"login":false},"capabilities":["home","category","search","detail","play"],"settings":[],"update":{"url":"https://raw.githubusercontent.com/hoyittvggfh45/moytv/plugins/one/one.idjplugin"},"integrity":"sha256-vuhTMtGrGpWjBnD/Jvoex0D+/ce4CnP8QBFPwX0WiJ0="},"files":{"main.js":"// One (一点播) — idj plugin, rewritten 1:1 from the builtin jar spider\n// com.github.catvod.spider.One (assets/jars/one.jar, decompiled 2026-11-27).\n//\n// Protocol (spider parity):\n// - API host is issued at runtime: GET https://api.luatiaonli.com/grpc/v1/\n//   Appdomain?name=one-app&userId= answers 302 to a rotating pool host\n//   to a rotating pool host (api subdomain on a random hex root, .com or\n//   .xyz). Pool roots are unbounded, so they cannot be\n//   whitelisted; the plugin therefore uses the spider's own FALLBACK hosts\n//   (verified alive, pool hosts are interchangeable) plus pool hosts sampled\n//   live on 2026-11-27, pinged in order like the spider's ping(). The chosen\n//   host is cached 30 minutes (spider HOST_TTL) in host.storage.\n// - GET  /grpc/v1/Index?page=N&pageSize=20        recommended feed\n// - GET  /api/v2/girlGetList?page=N&pageSize=20[&city=]  girl listings\n// - GET  /api/v2/girlCityList                     city classes (top 48)\n// - GET  /api/v2/girlGet?id=                      girl detail (showvideo)\n// - POST /grpc/v1/YgnTestdrive {page,pageSize}    testdrive list\n// - POST /grpc/v1/Testdrive {id}                  testdrive detail\n// - Search has no API: spider scans girl pages + testdrive pages locally.\n// - playerContent in the spider returns the detail URL as-is (mp4 direct\n//   link or image), parse=0, headers UA + Referer <base>/.\n\nconst UA = \"Mozilla/5.0 (Linux; Android 13; SM-G981B) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Mobile Safari/537.36\";\nconst DISPATCH = \"https://api.luatiaonli.com/grpc/v1/Appdomain?name=one-app&userId=\";\nconst HOST_TTL_MS = 1800000;\n// Spider FALLBACK first, then pool hosts sampled from DISPATCH on\n// 2026-11-27 (all verified 200 with a \"code\" body the same day).\nconst KNOWN_HOSTS = [\n  \"https://api.2963c30e4341.com\",\n  \"https://api.723a8bd6c5c2.com\",\n  \"https://api.3b3fe922f7fc.com\",\n  \"https://api.79b4243b3297.com\",\n  \"https://api.27bc543eeb3e.com\",\n  \"https://api.ee5cf45ff4a8.com\",\n  \"https://api.80619062b9e0.com\",\n  \"https://api.70f5dd26506c.com\",\n  \"https://api.08c63eaadefb.xyz\",\n  \"https://api.70f5dd26506c.xyz\",\n];\nconst FIXED_CATS = [\n  [\"index\", \"推荐\"],\n  [\"girl\", \"全部佳丽\"],\n  [\"video\", \"有视频\"],\n  [\"testdrive\", \"试驾报告\"],\n];\n\nlet baseHost = \"\";\nlet baseTime = 0;\n\nfunction str(v) { return v == null ? \"\" : String(v); }\nfunction intValue(v, fb) { const n = parseInt(v, 10); return isFinite(n) ? n : fb; }\nfunction obj(v) { return v && typeof v === \"object\" && !Array.isArray(v) ? v : {}; }\nfunction arr(v) { return Array.isArray(v) ? v : []; }\nfunction get(o, k) { return str(obj(o)[k]); }\n\nfunction loadCachedHost() {\n  try {\n    const raw = host.storage.get(\"one_host\");\n    if (!raw) return \"\";\n    const rec = JSON.parse(raw);\n    if (rec && rec.host && Date.now() - Number(rec.ts || 0) < HOST_TTL_MS) return str(rec.host);\n  } catch (e) { /* fall through */ }\n  return \"\";\n}\nfunction saveHost(h) {\n  baseHost = h; baseTime = Date.now();\n  try { host.storage.set(\"one_host\", JSON.stringify({ host: h, ts: baseTime })); } catch (e) { /* ignore */ }\n}\n\nasync function rawHttp(url, method, body, timeout) {\n  const opts = {\n    method: method,\n    url: url,\n    headers: {\n      \"User-Agent\": UA,\n      \"Accept\": \"application/json, text/plain, */*\",\n      \"Accept-Language\": \"zh-CN,zh;q=0.9\",\n    },\n    timeout: timeout || 45000,\n  };\n  if (baseHost) opts.headers[\"Referer\"] = baseHost + \"/\";\n  if (body != null) {\n    opts.headers[\"Content-Type\"] = \"application/json;charset=UTF-8\";\n    opts.body = body;\n  }\n  const resp = await host.http.request(opts);\n  if (resp.status >= 400) throw host.error(\"E_NETWORK\", \"接口返回 \" + resp.status);\n  return resp;\n}\n\n// Spider ping(): GET <host>/grpc/v1/Index?page=1&pageSize=1, body has \"code\".\nasync function ping(h) {\n  try {\n    const resp = await host.http.request({\n      method: \"GET\",\n      url: h + \"/grpc/v1/Index?page=1&pageSize=1\",\n      headers: { \"User-Agent\": UA },\n      timeout: 15000,\n    });\n    return resp.status === 200 && String(resp.body || \"\").indexOf(\"\\\"code\\\"\") >= 0;\n  } catch (e) { return false; }\n}\n\nfunction schemeHost(u) {\n  const m = /^(https?:\\/\\/[^\\/:?#]+(?::\\d+)?)/i.exec(str(u));\n  if (!m) return \"\";\n  // spider schemeHost(): drop default ports\n  return m[1].replace(/:(80|443)$/, \"\");\n}\n\nasync function resolveHost(force) {\n  if (!force && baseHost && Date.now() - baseTime < HOST_TTL_MS) return baseHost;\n  if (!force) {\n    const cached = loadCachedHost();\n    if (cached) { baseHost = cached; baseTime = Date.now(); return baseHost; }\n  }\n  // Known hosts first: the dispatch endpoint 302s to a brand-new pool root\n  // almost every time, and a fresh root is never in the plugin whitelist\n  // (the host checks every redirect hop), so spider's dispatch-first order\n  // would waste a round trip and then fail anyway. The spider's FALLBACK\n  // hosts are whitelisted and pool hosts are interchangeable, so ping them\n  // first; dispatch stays as a last resort (usable if its root happens to\n  // be whitelisted).\n  for (const h of KNOWN_HOSTS) {\n    if (await ping(h)) { saveHost(h); return baseHost; }\n  }\n  try {\n    const resp = await host.http.request({\n      method: \"GET\", url: DISPATCH,\n      headers: { \"User-Agent\": \"okhttp/4.9.3\" }, timeout: 12000,\n    });\n    const loc = (resp.headers && (resp.headers[\"location\"] || resp.headers[\"Location\"])) || resp.url || \"\";\n    const h = schemeHost(loc);\n    if (h && h.indexOf(\"luatiaonli\") < 0) {\n      if (await ping(h)) { saveHost(h); return baseHost; }\n    }\n  } catch (e) { /* no usable host from dispatch either */ }\n  saveHost(KNOWN_HOSTS[0]); // spider: fall back to FALLBACK[0] regardless\n  return baseHost;\n}\n\nasync function base() {\n  if (!baseHost) await resolveHost(false);\n  return baseHost;\n}\n\nfunction abs(u) {\n  const s = str(u).trim();\n  if (!s) return \"\";\n  if (/^https?:\\/\\//i.test(s)) return s;\n  if (s.indexOf(\"//\") === 0) return \"https:\" + s;\n  return baseHost + (s.charAt(0) === \"/\" ? s : \"/\" + s);\n}\n\n// Spider http(): on failure re-resolve the host and retry once.\nasync function api(path, method, bodyObj) {\n  const b = await base();\n  const body = bodyObj == null ? null : JSON.stringify(bodyObj);\n  try {\n    const resp = await rawHttp(b + path, method, body, 45000);\n    return JSON.parse(resp.body);\n  } catch (e) {\n    const old = baseHost;\n    await resolveHost(true);\n    if (baseHost && baseHost !== old) {\n      const resp = await rawHttp(baseHost + path, method, body, 45000);\n      return JSON.parse(resp.body);\n    }\n    throw e;\n  }\n}\n\nfunction firstPic(item) {\n  const pics = arr(obj(item.oneMoreThing).pics);\n  if (!pics.length) return { big: get(item, \"avatar\"), small: \"\" };\n  return obj(pics[0]);\n}\n\nfunction indexItem(item) {\n  const id = get(item, \"id\");\n  if (!id) return null;\n  const person = obj(item.personInfo);\n  const pic = firstPic(item);\n  const remarks = [];\n  if (get(person, \"city\")) remarks.push(get(person, \"city\"));\n  if (get(person, \"age\") && get(person, \"age\") !== \"0\") remarks.push(get(person, \"age\") + \"岁\");\n  if (get(person, \"cup\")) remarks.push(get(person, \"cup\") + \"罩杯\");\n  return {\n    id: \"g_\" + id,\n    title: get(item, \"name\"),\n    cover: abs(get(pic, \"big\") || get(pic, \"small\")),\n    remarks: remarks.join(\" · \"),\n  };\n}\n\nfunction girlItem(item) {\n  const id = get(item, \"id\");\n  if (!id) return null;\n  const remarks = [];\n  if (get(item, \"city\")) remarks.push(get(item, \"city\"));\n  if (get(item, \"age\") && get(item, \"age\") !== \"0\") remarks.push(get(item, \"age\") + \"岁\");\n  if (get(item, \"cup\")) remarks.push(get(item, \"cup\") + \"杯\");\n  if (get(item, \"price\")) remarks.push(\"¥\" + get(item, \"price\"));\n  return {\n    id: \"g_\" + id,\n    title: get(item, \"name\"),\n    cover: abs(get(item, \"image\")),\n    remarks: remarks.join(\" · \"),\n  };\n}\n\nfunction testdriveItem(item) {\n  const id = get(item, \"id\");\n  if (!id) return null;\n  const remarks = [];\n  if (get(item, \"location\")) remarks.push(get(item, \"location\"));\n  if (get(item, \"name\")) remarks.push(get(item, \"name\"));\n  if (get(item, \"hits\")) remarks.push(\"阅\" + get(item, \"hits\"));\n  return {\n    id: \"t_\" + id,\n    title: get(item, \"title\") || get(item, \"name\"),\n    cover: abs(get(item, \"home_image\") || get(item, \"image\")),\n    remarks: remarks.join(\" · \"),\n  };\n}\n\nasync function homeList() {\n  const root = await api(\"/grpc/v1/Index?page=1&pageSize=20\", \"GET\", null);\n  const items = [];\n  for (const it of arr(obj(root.data).data)) {\n    const v = indexItem(it); if (v) items.push(v);\n  }\n  return items;\n}\n\nasync function cityClasses() {\n  const out = [];\n  try {\n    const root = await api(\"/api/v2/girlCityList\", \"GET\", null);\n    const rows = arr(root.data).filter(r => get(r, \"city\") && get(r, \"city\") !== \"全区\");\n    rows.sort((a, b) => intValue(obj(b).num, 0) - intValue(obj(a).num, 0));\n    for (const r of rows.slice(0, 48)) {\n      out.push({ id: \"city:\" + get(r, \"city\"), name: get(r, \"city\") + \"(\" + get(r, \"num\") + \")\" });\n    }\n  } catch (e) { /* spider swallows city failures too */ }\n  return out;\n}\n\nasync function girlPage(page, city, out) {\n  let path = \"/api/v2/girlGetList?page=\" + page + \"&pageSize=20\";\n  if (city) path += \"&city=\" + encodeURIComponent(city);\n  const root = await api(path, \"GET\", null);\n  const data = obj(root.data);\n  for (const it of arr(data.items)) { const v = girlItem(it); if (v) out.push(v); }\n  return intValue(data.total, 0);\n}\n\nasync function testdrivePage(page, out) {\n  const root = await api(\"/grpc/v1/YgnTestdrive\", \"POST\", { page: page, pageSize: 20 });\n  for (const it of arr(root.data)) { const v = testdriveItem(it); if (v) out.push(v); }\n  const total = intValue(obj(root.page).total, 0);\n  return total > 0 ? total : 5000;\n}\n\nasync function girlVideo(id) {\n  // No host re-resolve here: this runs per item during video filtering and\n  // a re-resolve storm would stall the whole page on a bad network. The\n  // spider's girlVideo likewise just returns \"\" on any failure.\n  try {\n    const b = await base();\n    const resp = await rawHttp(b + \"/api/v2/girlGet?id=\" + encodeURIComponent(id), \"GET\", null, 45000);\n    const data = obj(JSON.parse(resp.body).data);\n    return get(data, \"showvideo\") || get(obj(data.info), \"showvideo\");\n  } catch (e) { return \"\"; }\n}\n\nasync function filterWithVideo(raw) {\n  // Spider checks the page with a 6-thread pool; 3 at a time is the safe\n  // equivalent here (wide parallel bursts die on flaky egress).\n  const kept = [];\n  for (let i = 0; i < raw.length; i += 3) {\n    const batch = raw.slice(i, i + 3);\n    const checked = await Promise.all(batch.map(async (v) => (await girlVideo(v.id.substring(2))) ? v : null));\n    for (const v of checked) if (v) kept.push(v);\n  }\n  return kept;\n}\n\nasync function videoPage(page, out) {\n  const raw = [];\n  await girlPage(page, null, raw);\n  let kept = await filterWithVideo(raw);\n  if (!kept.length) {\n    for (let extra = 1; extra <= 2 && !kept.length; extra++) {\n      const more = [];\n      try {\n        await girlPage(page + extra, null, more);\n        kept = await filterWithVideo(more);\n      } catch (e) { /* spider ignores extra-page failures */ }\n    }\n  }\n  for (const v of kept) {\n    v.remarks = (v.remarks ? v.remarks + \" · \" : \"\") + \"有视频\";\n    out.push(v);\n  }\n  return 700000; // spider's nominal total for this class\n}\n\nfunction mapPrice(priceObj, info) {\n  if (priceObj && typeof priceObj === \"object\") {\n    const p = obj(priceObj);\n    if (get(p, \"price\")) {\n      const p2 = get(p, \"price2\"), p3 = get(p, \"price3\");\n      return p2 && p3 ? get(p, \"price\") + \"/\" + p2 + \"/\" + p3 : get(p, \"price\");\n    }\n  } else if (priceObj != null) {\n    const s = str(priceObj);\n    if (s && s !== \"null\" && s.charAt(0) !== \"{\") return s;\n  }\n  const ip = get(info, \"info_price\");\n  return ip && ip !== \"0\" ? ip : \"\";\n}\n\nfunction mediaUrls(data) {\n  const urls = [];\n  for (const m of arr(data.media)) {\n    const u = get(obj(m), \"url\") || get(obj(m), \"s_url\");\n    if (u) urls.push(abs(u));\n  }\n  return urls;\n}\n\nasync function detailGirl(id, fullId) {\n  const root = await api(\"/api/v2/girlGet?id=\" + encodeURIComponent(id), \"GET\", null);\n  const data = obj(root.data);\n  const info = Object.keys(obj(data.info)).length ? obj(data.info) : data;\n  const video = get(data, \"showvideo\") || get(info, \"showvideo\");\n  const images = mediaUrls(data);\n  const parts = [];\n  if (get(info, \"city\")) parts.push(\"城市: \" + get(info, \"city\"));\n  if (get(info, \"age\") && get(info, \"age\") !== \"0\") parts.push(\"年龄: \" + get(info, \"age\"));\n  if (get(info, \"height\") && get(info, \"height\") !== \"0\") parts.push(\"身高: \" + get(info, \"height\") + \"cm\");\n  if (get(info, \"cup\")) parts.push(\"罩杯: \" + get(info, \"cup\"));\n  const price = mapPrice(data.price, info);\n  if (price) parts.push(\"价格: ¥\" + price);\n  const service = get(data, \"service\") || get(info, \"service\");\n  if (service) parts.push(\"服务: \" + service);\n  const rating = get(data, \"rating\") || get(info, \"rating\");\n  if (rating) parts.push(\"评分: \" + rating);\n  let desc = parts.join(\" · \");\n  const areaCity = get(obj(data.area), \"city\");\n  if (areaCity && areaCity !== get(info, \"city\")) desc += \"\\n\\n区域: \" + areaCity;\n  if (images.length) desc += \"\\n\\n图集: \" + images.length + \" 张\";\n  const imgEps = images.map((u, i) => ({ id: u, name: \"图\" + (i + 1) }));\n  const lines = [];\n  if (video) {\n    lines.push({ name: \"One直连\", episodes: [{ id: abs(video), name: \"正片\" }] });\n    if (imgEps.length) lines.push({ name: \"One图集\", episodes: imgEps });\n  } else {\n    lines.push({ name: \"One图文\", episodes: imgEps });\n  }\n  return {\n    id: fullId,\n    title: get(info, \"name\"),\n    cover: abs(get(data, \"image\") || get(info, \"image\")),\n    desc: desc,\n    tags: get(info, \"city\") ? [get(info, \"city\")] : [],\n    lines: lines,\n  };\n}\n\nasync function detailTestdrive(id) {\n  const root = await api(\"/grpc/v1/Testdrive\", \"POST\", { id: intValue(id, 0) });\n  const data = obj(root.data);\n  const parts = [];\n  if (get(data, \"location\")) parts.push(\"地点: \" + get(data, \"location\"));\n  if (get(data, \"name\")) parts.push(\"主角: \" + get(data, \"name\"));\n  if (get(data, \"add_time\")) parts.push(\"时间: \" + get(data, \"add_time\"));\n  if (get(data, \"hits\")) parts.push(\"浏览: \" + get(data, \"hits\"));\n  let desc = parts.join(\" · \");\n  const images = [];\n  let video = \"\";\n  const texts = [];\n  for (const c of arr(data.testdrive_contents)) {\n    const co = obj(c);\n    if (get(co, \"content\")) texts.push(get(co, \"content\"));\n    const att = get(co, \"attachment\");\n    if (att) {\n      if (/\\.(mp4|m3u8)$/i.test(att)) { if (!video) video = abs(att); }\n      else images.push(abs(att));\n    }\n  }\n  if (texts.length) desc += (desc ? \"\\n\\n\" : \"\") + texts.join(\"\\n\");\n  const imgEps = images.map((u, i) => ({ id: u, name: \"图\" + (i + 1) }));\n  const lines = [];\n  if (video) {\n    lines.push({ name: \"One直连\", episodes: [{ id: video, name: \"正片\" }].concat(imgEps) });\n  } else {\n    lines.push({ name: \"One图文\", episodes: imgEps });\n  }\n  return {\n    id: \"t_\" + id,\n    title: get(data, \"title\") || get(data, \"name\"),\n    cover: abs(get(data, \"home_image\") || get(data, \"image\")),\n    desc: desc,\n    tags: [],\n    lines: lines,\n  };\n}\n\nexport default {\n  async init() {},\n\n  async home() {\n    await base();\n    const cats = FIXED_CATS.map(([id, name]) => ({ id, name }));\n    const both = await Promise.all([cityClasses(), homeList()]);\n    return { categories: cats.concat(both[0]), items: both[1], hasMore: false };\n  },\n\n  async category({ id, page }) {\n    await base();\n    const p = Math.max(1, intValue(page, 1));\n    const items = [];\n    let total = 0, limit = 20;\n    if (id === \"index\") {\n      const root = await api(\"/grpc/v1/Index?page=\" + p + \"&pageSize=20\", \"GET\", null);\n      total = intValue(obj(obj(root.data).page).total, 0);\n      for (const it of arr(obj(root.data).data)) { const v = indexItem(it); if (v) items.push(v); }\n    } else if (id === \"girl\") {\n      total = await girlPage(p, null, items);\n      limit = 10; // server fixes girlGetList at 10 per page (spider note)\n    } else if (id && id.indexOf(\"city:\") === 0) {\n      total = await girlPage(p, id.substring(5), items);\n      limit = 10;\n    } else if (id === \"testdrive\") {\n      total = await testdrivePage(p, items);\n    } else if (id === \"video\") {\n      total = await videoPage(p, items);\n      limit = Math.max(items.length, 1);\n    } else {\n      throw host.error(\"E_PARSE\", \"未知分类 \" + id);\n    }\n    const hasMore = total > 0 ? p * limit < total : items.length > 0;\n    return { items: items, hasMore: hasMore };\n  },\n\n  async search({ keyword, page }) {\n    await base();\n    const kw = str(keyword).trim().toLowerCase();\n    const items = [];\n    if (!kw) return { items: items, hasMore: false };\n    // Spider parity: no search API; scan girl pages 1..6 (quick mode) and,\n    // for a full search, testdrive pages 1..4, matching name/remarks.\n    for (let pg = 1; pg <= 6 && items.length < 60; pg++) {\n      const batch = [];\n      try { await girlPage(pg, null, batch); } catch (e) { break; }\n      if (!batch.length) break;\n      for (const v of batch) {\n        if (v.title.toLowerCase().indexOf(kw) >= 0 || (v.remarks || \"\").toLowerCase().indexOf(kw) >= 0) items.push(v);\n      }\n    }\n    for (let pg = 1; pg <= 4 && items.length < 60; pg++) {\n      const batch = [];\n      try { await testdrivePage(pg, batch); } catch (e) { break; }\n      if (!batch.length) break;\n      for (const v of batch) {\n        if (v.title.toLowerCase().indexOf(kw) >= 0 || (v.remarks || \"\").toLowerCase().indexOf(kw) >= 0) items.push(v);\n      }\n    }\n    return { items: items, hasMore: false };\n  },\n\n  async detail({ id }) {\n    await base();\n    const sid = str(id);\n    if (sid.indexOf(\"t_\") === 0) return detailTestdrive(sid.substring(2));\n    return detailGirl(sid.indexOf(\"g_\") === 0 ? sid.substring(2) : sid, sid);\n  },\n\n  async play({ id, episodeId }) {\n    await base();\n    const url = str(episodeId || id).trim();\n    if (!url) throw host.error(\"E_PARSE\", \"分集 id 为空\");\n    const stream = { url: url, headers: { \"User-Agent\": UA, \"Referer\": baseHost + \"/\" } };\n    if (/\\.m3u8($|\\?)/i.test(url)) stream.format = \"hls\";\n    else if (/\\.mp4($|\\?)/i.test(url)) stream.format = \"mp4\";\n    return { streams: [stream] };\n  },\n};\n"}}