{"manifest":{"schema":1,"id":"com.idj.ext.missav","name":"MissAV","version":"1.0.0","author":{"name":"CatVod 蜘蛛改写"},"description":"MissAV（missav123.nl）。34 个分类，列表纯 HTML 解析，详情页 packer 解包取 1080p m3u8。由 CatVod 蜘蛛 missav.py v5 改写。2026-11-24 复核。","type":"video","adult":true,"language":["zh"],"minAppVersion":"1.5","entry":"main.js","permissions":{"http":["missav123.nl","www.missav123.nl","thisav.my","www.thisav.my","missav.ws"],"media":["c.surrit.com","surrit.com","*.vcwinford.cc","*.missav.ws"],"cloudflare":false,"storage":false,"login":false},"capabilities":["home","category","search","detail","play"],"settings":[],"update":{"url":"https://raw.githubusercontent.com/hoyittvggfh45/moytv/plugins/missav/missav.idjplugin"},"integrity":"sha256-q96VZID+Vw55+D3fApKj2ypp19S2RLyXDoS6V8OSs0Q="},"files":{"main.js":"// MissAV — idj1 插件（由 TVBox 蜘蛛 missav.py v5 改写，2026-11-22 摸站，2026-11-24 复核）\n// 站点：https://www.missav123.nl（主镜像），备用 https://www.thisav.my\n// 列表：纯 HTML 正则解析；详情页 Dean Edwards packer 解包取 m3u8，三级回退\n// （packer 解包 → 倒序 token 拼 surrit playlist → surrit UUID 拼 playlist →\n// 页面直写 .m3u8）；播放头 Referer/Origin 用 missav.ws（py 实测组合）。\n//\n// 相对原蜘蛛丢掉 / 降级的能力：\n// - 镜像轮询只留 2 个域（主 + thisav.my），超时各 15 秒；missav.ws 只作播放\n//   Referer/Origin，不再当取页域（机房出口 CF 403，手机上弹验证页）。\n// - 翻页 pagecount 不精确（站方不给总数，沿用 py 的 9999 写法，idj 只用\n//   hasMore：有结果即 true）。\n// - 女优/类型/发行商索引（actresses/genres/makers）原来是 CatVod 的\n//   vod_tag:\"folder\" 文件夹语义，idj 无文件夹原语——改成：分类里点开索引项\n//   后进详情页，详情页只有一条线路「作品」（分集即该索引第 1 页作品）；\n//   只取第 1 页，不翻页（与 HQPorner 女优先例同款）。\n// - 标题中文化不做：py 也没有翻译层，标题保留“番号 + 中文标题”原样。\n// - dm 号是镜像当前值：插件每次取列表页时从导航链接里刷新 ROUTES，\n//   静态值只作回退（2026-11-24 复核与 py 的 2026-11-22 值一致，未变）。\n\nconst PRIMARY = \"https://www.missav123.nl\";\nconst FALLBACK = \"https://www.thisav.my\";\nconst UA = \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\";\nconst TIMEOUT = 15000;\nconst PLAY_REFERER = \"https://missav.ws/\";\nconst PLAY_ORIGIN = \"https://missav.ws\";\n\n// MissAV 分类：2026-11-22 py 实测 34 个，2026-11-24 复核 dm 号未变（/dm539/cn/new 当日实取 200）。\n// dm 号是镜像当前值，插件运行时会从列表页导航链接里刷新 ROUTES，静态值只作回退。\nconst CATS = [\n    [\"chinese-subtitle\", \"中文字幕\", \"/dm278/cn/chinese-subtitle\"],\n    [\"new\", \"最近更新\", \"/dm539/cn/new\"],\n    [\"release\", \"新作上市\", \"/dm635/cn/release\"],\n    [\"uncensored-leak\", \"无码流出\", \"/dm817/cn/uncensored-leak\"],\n    [\"actresses\", \"女优一览\", \"/cn/actresses\"],\n    [\"actresses/ranking\", \"女优排行\", \"/cn/actresses/ranking\"],\n    [\"genres\", \"类型\", \"/cn/genres\"],\n    [\"makers\", \"发行商\", \"/cn/makers\"],\n    [\"genres/VR\", \"VR\", \"/cn/genres/VR\"],\n    [\"today-hot\", \"今日热门\", \"/dm301/cn/today-hot\"],\n    [\"weekly-hot\", \"本周热门\", \"/dm170/cn/weekly-hot\"],\n    [\"monthly-hot\", \"本月热门\", \"/dm273/cn/monthly-hot\"],\n    [\"siro\", \"SIRO\", \"/dm36/cn/siro\"],\n    [\"luxu\", \"LUXU\", \"/dm34/cn/luxu\"],\n    [\"gana\", \"GANA\", \"/dm35/cn/gana\"],\n    [\"maan\", \"PRESTIGE PREMIUM\", \"/dm1004/cn/maan\"],\n    [\"scute\", \"S-CUTE\", \"/dm38/cn/scute\"],\n    [\"ara\", \"ARA\", \"/dm34/cn/ara\"],\n    [\"fc2\", \"FC2\", \"/dm597/cn/fc2\"],\n    [\"heyzo\", \"HEYZO\", \"/dm2020563/cn/heyzo\"],\n    [\"tokyohot\", \"东京热\", \"/dm42/cn/tokyohot\"],\n    [\"1pondo\", \"一本道\", \"/dm4551182/cn/1pondo\"],\n    [\"caribbeancom\", \"Caribbeancom\", \"/dm6840813/cn/caribbeancom\"],\n    [\"caribbeancompr\", \"Caribbeancompr\", \"/dm78420/cn/caribbeancompr\"],\n    [\"10musume\", \"10musume\", \"/dm6238706/cn/10musume\"],\n    [\"pacopacomama\", \"pacopacomama\", \"/dm3240472/cn/pacopacomama\"],\n    [\"gachinco\", \"Gachinco\", \"/dm150/cn/gachinco\"],\n    [\"xxxav\", \"XXX-AV\", \"/dm42/cn/xxxav\"],\n    [\"marriedslash\", \"人妻斩\", \"/dm37/cn/marriedslash\"],\n    [\"naughty4610\", \"顽皮4610\", \"/dm33/cn/naughty4610\"],\n    [\"naughty0930\", \"顽皮0930\", \"/dm37/cn/naughty0930\"],\n    [\"madou\", \"麻豆传媒\", \"/dm63/cn/madou\"],\n    [\"twav\", \"TWAV\", \"/dm31/cn/twav\"],\n    [\"furuke\", \"Furuke\", \"/dm15/cn/furuke\"],\n];\n\nconst INDEX_TIDS = {\"actresses\": true, \"actresses/ranking\": true, \"genres\": true, \"makers\": true};\nconst INDEX_PREFIX = {\"actresses\": \"actresses\", \"actresses/ranking\": \"actresses\", \"genres\": \"genres\", \"makers\": \"makers\"};\nconst RESERVED = {\"release\": true, \"new\": true, \"actresses\": true, \"genres\": true, \"makers\": true,\n    \"search\": true, \"chinese-subtitle\": true, \"uncensored-leak\": true, \"login\": true,\n    \"register\": true, \"history\": true, \"playlists\": true, \"tags\": true, \"dm\": true,\n    \"vip\": true, \"saved\": true, \"today-hot\": true, \"weekly-hot\": true,\n    \"monthly-hot\": true, \"ranking\": true};\nconst PLACEHOLDER_HINTS = [\"data:image\", \"placeholder\", \"lazy\", \"loading\", \"blank\",\n    \"spinner\", \"1x1\", \"pixel\", \".svg\", \"noimage\", \"no-image\",\n    \"default.jpg\", \"grey\", \"gray\"];\n\nconst ROUTES = {};\nfor (const row of CATS) ROUTES[row[0]] = row[2];\n\nfunction str(value) {\n    if (value == null) return \"\";\n    return String(value);\n}\n\nfunction absUrl(url, base) {\n    const value = str(url).trim();\n    if (!value) return \"\";\n    if (/^https?:\\/\\//i.test(value)) return value;\n    if (/^\\/\\//.test(value)) return \"https:\" + value;\n    if (/^\\//.test(value)) return base.replace(/\\/+$/, \"\") + value;\n    return base.replace(/\\/+$/, \"\") + \"/\" + value;\n}\n\nfunction cleanText(value) {\n    return str(value)\n        .replace(/<(script|style)[^>]*>[\\s\\S]*?<\\/\\1>/gi, \" \")\n        .replace(/<[^>]*>/g, \" \")\n        .replace(/&#(\\d+);/g, function (m, code) { return String.fromCharCode(parseInt(code, 10)); })\n        .replace(/&#x([0-9a-fA-F]+);/g, function (m, code) { return String.fromCharCode(parseInt(code, 16)); })\n        .replace(/&nbsp;/gi, \" \")\n        .replace(/&amp;/gi, \"&\")\n        .replace(/&quot;/gi, '\"')\n        .replace(/&#39;|&apos;/gi, \"'\")\n        .replace(/&lt;/gi, \"<\")\n        .replace(/&gt;/gi, \">\")\n        .replace(/\\s+/g, \" \")\n        .trim();\n}\n\nfunction firstMatch(text, regex, index) {\n    const match = regex.exec(text || \"\");\n    return match ? str(match[index == null ? 1 : index]) : \"\";\n}\n\nfunction refreshRoutes(html) {\n    // 从列表页导航链接里刷新 dm 号：href=\".../dmNNN/cn/<slug>\"\n    const regex = /href=\"[^\"]*\\/dm(\\d+)\\/cn\\/([a-z0-9\\-\\/]+)\"/gi;\n    let match;\n    while ((match = regex.exec(html || \"\")) !== null) {\n        const slug = match[2].replace(/\\/$/, \"\");\n        if (ROUTES[slug] !== undefined) ROUTES[slug] = \"/dm\" + match[1] + \"/cn/\" + slug;\n    }\n}\n\nasync function fetchText(url, referer) {\n    const headers = {\n        \"User-Agent\": UA,\n        \"Accept\": \"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\",\n        \"Accept-Language\": \"zh-CN,zh;q=0.9,en;q=0.6\",\n        \"Referer\": referer || (PRIMARY + \"/\"),\n    };\n    let lastError = null;\n    for (const base of [PRIMARY, FALLBACK]) {\n        let u = url;\n        if (base !== PRIMARY && u.indexOf(PRIMARY) === 0) u = base + u.slice(PRIMARY.length);\n        try {\n            const resp = await host.http.request({url: u, method: \"GET\", headers: headers, timeout: TIMEOUT});\n            if (resp.status < 200 || resp.status >= 300) throw new Error(\"HTTP \" + resp.status);\n            const body = resp.body == null ? \"\" : String(resp.body);\n            if (body.length < 2000) throw new Error(\"body too small\");\n            if (body.toLowerCase().indexOf(\"just a moment\") >= 0 && body.length < 12000) {\n                throw new Error(\"cloudflare challenge\");\n            }\n            return body;\n        } catch (error) {\n            lastError = error;\n        }\n    }\n    throw lastError || new Error(\"fetch failed\");\n}\n\nfunction pickImage(body) {\n    const cands = [];\n    const imgRegex = /<img[^>]*>/gi;\n    let tagMatch;\n    while ((tagMatch = imgRegex.exec(body || \"\")) !== null) {\n        const tag = tagMatch[0];\n        for (const attr of [\"data-src\", \"data-original\", \"data-lazy-src\", \"data-url\", \"src\"]) {\n            const mm = new RegExp(attr + '\\\\s*=\\\\s*[\"\\']([^\"\\']+)[\"\\']', \"i\").exec(tag);\n            if (mm) {\n                cands.push([(attr.indexOf(\"data-\") === 0 ? 0 : 1), mm[1].trim()]);\n                break;\n            }\n        }\n    }\n    const good = [];\n    for (const pair of cands) {\n        const prio = pair[0];\n        let url = pair[1];\n        if (!url || url.indexOf(\"data:\") === 0) continue;\n        const low = url.toLowerCase();\n        let bad = false;\n        for (const h of PLACEHOLDER_HINTS) {\n            if (low.indexOf(h) >= 0) { bad = true; break; }\n        }\n        if (bad) continue;\n        if (url.indexOf(\"//\") === 0) url = \"https:\" + url;\n        else if (url.indexOf(\"/\") === 0) url = PRIMARY + url;\n        if (url.indexOf(\"http\") !== 0) continue;\n        good.push([prio, url]);\n    }\n    if (!good.length) return \"\";\n    good.sort(function (a, b) { return a[0] - b[0]; });\n    return good[0][1];\n}\n\nfunction fmtDuration(seconds) {\n    let total = 0;\n    try { total = parseInt(seconds, 10); } catch (error) { total = 0; }\n    if (!total || total <= 0) return \"\";\n    const h = Math.floor(total / 3600);\n    const m = Math.floor((total % 3600) / 60);\n    const s = total % 60;\n    function pad(n) { return (n < 10 ? \"0\" : \"\") + n; }\n    if (h) return h + \":\" + pad(m) + \":\" + pad(s);\n    return m + \":\" + pad(s);\n}\n\nfunction base36(n) {\n    const chars = \"0123456789abcdefghijklmnopqrstuvwxyz\";\n    if (n === 0) return \"0\";\n    let res = \"\";\n    while (n > 0) {\n        res = chars[n % 36] + res;\n        n = Math.floor(n / 36);\n    }\n    return res;\n}\n\nfunction unpack(packedJs) {\n    const m = /\\}\\s*\\(\\s*['\"](.*?)['\"]\\s*,\\s*(\\d+)\\s*,\\s*(\\d+)\\s*,\\s*['\"](.*?)['\"]\\s*\\.split\\(['\"]\\|['\"]\\)/.exec(packedJs);\n    if (!m) return \"\";\n    const p = m[1];\n    const a = parseInt(m[2], 10);\n    const c = parseInt(m[3], 10);\n    const k = m[4].split(\"|\");\n    const d = {};\n    for (let i = 0; i < c; i++) {\n        const key = base36(i);\n        d[key] = (i < k.length && k[i]) ? k[i] : key;\n    }\n    return p.replace(/\\b\\w+\\b/g, function (w) {\n        return Object.prototype.hasOwnProperty.call(d, w) ? d[w] : w;\n    });\n}\n\nfunction extractSurritUuid(text) {\n    let m = /hls\\.loadSource\\(['\"]https?:\\/\\/[^\\/]+\\/([a-f0-9-]{36})\\/playlist\\.m3u8['\"]\\)/.exec(text || \"\");\n    if (m) return m[1];\n    m = /urls:\\s*\\[\\s*['\"]([^'\"]+)['\"]/.exec(text || \"\");\n    if (m && m[1].indexOf(\"sample\") < 0) {\n        const u = /([a-f0-9-]{36})/.exec(m[1]);\n        if (u) return u[1];\n    }\n    const uuids = (text || \"\").match(/[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}/g) || [];\n    return uuids.length ? uuids[0] : \"\";\n}\n\nfunction extractM3u8(pageHtml) {\n    const text = pageHtml || \"\";\n    const pack = /(eval\\s*\\(\\s*function\\s*\\(\\s*p\\s*,\\s*a\\s*,\\s*c\\s*.*?\\.split\\(['\"]\\|['\"]\\).*?\\)\\s*\\))/i.exec(text);\n    if (pack) {\n        const unpacked = unpack(pack[1]);\n        const links = [];\n        const seen = {};\n        const linkRegex = /https?:\\/\\/[^\\s'\"<>\\\\;]+\\.m3u8/g;\n        let lm;\n        while ((lm = linkRegex.exec(unpacked.replace(/\\\\\\//g, \"/\"))) !== null) {\n            if (!seen[lm[0]]) { seen[lm[0]] = true; links.push(lm[0]); }\n        }\n        for (const want of [\"1080p\", \"720p\"]) {\n            for (const link of links) {\n                if (link.toLowerCase().indexOf(want) >= 0) return link;\n            }\n        }\n        if (links.length) return links[0];\n    }\n    const rev = /'m3u8(.*?)video/.exec(text);\n    if (rev) {\n        const parts = rev[1].split(\"|\").reverse();\n        if (parts.length >= 9 && parts[2] && parts[3]) {\n            return parts[1] + \"://\" + parts[2] + \".\" + parts[3] + \"/\" +\n                parts[4] + \"-\" + parts[5] + \"-\" + parts[6] + \"-\" + parts[7] + \"-\" + parts[8] +\n                \"/playlist.m3u8\";\n        }\n    }\n    const uuid = extractSurritUuid(text);\n    if (uuid) return \"https://surrit.com/\" + uuid + \"/playlist.m3u8\";\n    const direct = /https?:\\/\\/[^\\s\"']+\\.m3u8[^\\s\"']*/.exec(text);\n    if (direct) return direct[0];\n    return \"\";\n}\n\nfunction parseList(pageHtml) {\n    const cards = {};\n    const order = [];\n    const pat = /<a[^>]+href=[\"']?(https?:\\/\\/[^\"'\\s>]+\\/cn\\/([a-z0-9][a-z0-9\\-]*))[\"']?[^>]*>([\\s\\S]*?)<\\/a>/gi;\n    let m;\n    while ((m = pat.exec(pageHtml || \"\")) !== null) {\n        const code = m[2].toLowerCase();\n        const body = m[3];\n        if (RESERVED[code] || !/-\\d/.test(code)) continue;\n        const url = PRIMARY + \"/cn/\" + code;\n        if (!cards[code]) {\n            cards[code] = {id: url, title: \"\", cover: \"\", remarks: \"\", duration: \"\", tags: []};\n            order.push(code);\n        }\n        const card = cards[code];\n        const pic = pickImage(body);\n        if (pic && !card.cover) card.cover = pic;\n        const dur = /\\b(\\d{1,2}:\\d{2}(?::\\d{2})?)\\b/.exec(body || \"\");\n        if (dur && !card.remarks) {\n            card.remarks = dur[1];\n            card.duration = dur[1];\n        }\n        const cands = [];\n        const altRegex = /alt=[\"']([^\"']+)[\"']/gi;\n        let am;\n        while ((am = altRegex.exec(body)) !== null) cands.push(am[1]);\n        const titleRegex = /title=[\"']([^\"']+)[\"']/gi;\n        let tm;\n        while ((tm = titleRegex.exec(body)) !== null) cands.push(tm[1]);\n        cands.push(cleanText(body));\n        let title = \"\";\n        for (const t of cands) {\n            const s = (t || \"\").trim();\n            if (!s) continue;\n            if (/^\\d{1,2}:\\d{2}(?::\\d{2})?$/.test(s)) continue;\n            if (s.toLowerCase() === code) continue;\n            if (s.length > title.length) title = s;\n        }\n        if (title.length > card.title.length) card.title = title;\n    }\n    const out = [];\n    for (const code of order) {\n        const card = cards[code];\n        if (!card.title) card.title = code.toUpperCase();\n        card.title = card.title.slice(0, 120);\n        out.push(card);\n    }\n    return out;\n}\n\nfunction parseIndex(pageHtml, prefix) {\n    const pat = new RegExp(\n        '<a[^>]+href=[\"\\']?(https?:\\\\/\\\\/[^\"\\'\\\\s>]+\\\\/(?:dm\\\\d+\\\\/)?cn\\\\/' + prefix +\n        '\\\\/([^\"\\'\\\\s>\\\\/]+))[\"\\']?[^>]*>([\\\\s\\\\S]*?)<\\\\/a>', \"gi\");\n    const out = [];\n    const seen = {};\n    let m;\n    while ((m = pat.exec(pageHtml || \"\")) !== null) {\n        const slug = m[2];\n        const body = m[3];\n        if (seen[slug] || slug.toLowerCase() === \"ranking\") continue;\n        seen[slug] = true;\n        let name = \"\";\n        try { name = decodeURIComponent(slug); } catch (error) { name = slug; }\n        const text = cleanText(body);\n        let disp = name;\n        const mm = /^(.+?)\\s*\\d[\\d,]*\\s*条影片/.exec(text);\n        if (mm && mm[1].length <= name.length + 4) disp = mm[1].trim() || name;\n        let remarks = \"\";\n        const cm = /([\\d,]+)\\s*条影片/.exec(text);\n        if (cm) remarks = cm[1] + \" 部\";\n        const ym = /\\b(19|20)\\d{2}\\b/.exec(text);\n        if (prefix === \"actresses\" && ym) {\n            remarks = (remarks ? remarks + \" · \" : \"\") + ym[0] + \" 出道\";\n        }\n        out.push({id: m[1], title: disp, cover: pickImage(body), remarks: remarks, duration: \"\", tags: []});\n    }\n    return out;\n}\n\nfunction allCategories() {\n    const list = [];\n    for (const row of CATS) list.push({id: row[0], name: row[1]});\n    return list;\n}\n\n// ---------- idj1 契约 ----------\n\nasync function home() {\n    let items = [];\n    try {\n        const html = await fetchText(PRIMARY + ROUTES[\"release\"]);\n        refreshRoutes(html);\n        items = parseList(html);\n    } catch (error) {\n        items = [];\n    }\n    return {categories: allCategories(), items: items, hasMore: items.length > 0};\n}\n\nasync function category(arg) {\n    const page = Math.max(1, parseInt((arg && arg.page) || \"1\", 10) || 1);\n    const tid = str(arg && arg.id);\n    let items = [];\n    try {\n        let drill = \"\";\n        const dm = /\\/cn\\/(actresses|genres|makers)\\//.exec(tid);\n        if (tid.indexOf(\"http\") === 0 && dm) {\n            drill = tid;\n        } else if (/^\\/cn\\/(actresses|genres|makers)\\/[^\\/]+$/.test(tid)) {\n            drill = PRIMARY + tid;\n        } else if (/^(actresses|genres|makers)\\/[^\\/]+$/.test(tid)) {\n            drill = PRIMARY + \"/cn/\" + tid;\n        }\n        if (drill) {\n            const sep = drill.indexOf(\"?\") >= 0 ? \"&\" : \"?\";\n            items = parseList(await fetchText(drill + sep + \"page=\" + page));\n            return {items: items, hasMore: items.length > 0};\n        }\n        if (INDEX_TIDS[tid]) {\n            const url = PRIMARY + ROUTES[tid] + \"?page=\" + page;\n            items = parseIndex(await fetchText(url), INDEX_PREFIX[tid]);\n            return {items: items, hasMore: items.length > 0};\n        }\n        const route = ROUTES[tid] || ROUTES[\"new\"];\n        const url = PRIMARY + route + \"?page=\" + page;\n        const html = await fetchText(url);\n        refreshRoutes(html);\n        items = parseList(html);\n    } catch (error) {\n        items = [];\n    }\n    return {items: items, hasMore: items.length > 0};\n}\n\nasync function search(arg) {\n    const page = Math.max(1, parseInt((arg && arg.page) || \"1\", 10) || 1);\n    const keyword = str(arg && arg.keyword).trim().toLowerCase();\n    if (!keyword) return {items: [], hasMore: false};\n    let items = [];\n    try {\n        const url = PRIMARY + \"/dm247/cn/search/\" + encodeURIComponent(keyword) + \"?page=\" + page;\n        items = parseList(await fetchText(url));\n    } catch (error) {\n        items = [];\n    }\n    return {items: items, hasMore: items.length > 0};\n}\n\nasync function detail(arg) {\n    const rawId = str(arg && arg.id);\n    if (!rawId) throw new Error(\"无效的影片 ID\");\n    const url = rawId.indexOf(\"http\") === 0 ? rawId\n        : (rawId.indexOf(\"/\") === 0 ? PRIMARY + rawId : PRIMARY + \"/cn/\" + rawId.replace(/^\\/+/, \"\").toLowerCase());\n    const mm = /\\/cn\\/(actresses|genres|makers)\\/([^/?#]+)$/.exec(url);\n    if (mm) {\n        let works = [];\n        try {\n            works = parseList(await fetchText(url));\n        } catch (error) {\n            works = [];\n        }\n        let name = \"\";\n        try { name = decodeURIComponent(mm[2]); } catch (error) { name = mm[2]; }\n        return {\n            id: rawId,\n            title: name,\n            cover: works.length ? works[0].cover : \"\",\n            desc: \"共 \" + works.length + \" 部作品（第一页）\",\n            tags: [],\n            lines: [{\n                name: \"作品\",\n                episodes: works.map(function (w) { return {id: w.id, name: w.title}; }),\n            }],\n        };\n    }\n    let html = \"\";\n    try {\n        html = await fetchText(url);\n    } catch (error) {\n        html = \"\";\n    }\n    let title = firstMatch(html, /property=\"og:title\"\\s+content=\"([^\"]+)\"/i);\n    if (title) title = title.replace(/\\s*-\\s*MissAV.*$/, \"\").trim();\n    if (!title) title = cleanText(firstMatch(html, /<h1[^>]*>([\\s\\S]*?)<\\/h1>/i));\n    const code = url.replace(/\\/+$/, \"\").split(\"/\").pop();\n    let actor = \"\";\n    const parts = (title || \"\").split(\" - \").map(function (p) { return p.trim(); }).filter(Boolean);\n    if (parts.length >= 2) actor = parts[parts.length - 1];\n    const pic = firstMatch(html, /property=\"og:image\"\\s+content=\"([^\"]+)\"/i);\n    const tags = firstMatch(html, /name=\"keywords\"\\s+content=\"([^\"]+)\"/i);\n    if (!actor && tags) actor = tags.split(\",\")[0].trim();\n    let year = \"\";\n    const rel = firstMatch(html, /property=\"og:video:release_date\"\\s+content=\"([^\"]+)\"/i);\n    if (rel) year = rel.slice(0, 4);\n    if (!year) {\n        const ym = /\\b(19|20)\\d{2}\\b/.exec(tags || \"\");\n        if (ym) year = ym[0];\n    }\n    const durRaw = firstMatch(html, /property=\"og:video:duration\"\\s+content=\"([^\"]+)\"/i);\n    const remarks = fmtDuration(durRaw);\n    const play = extractM3u8(html);\n    const playId = play || url;\n    const desc = [tags, actor ? \"女优：\" + actor : \"\", year ? year + \" 年\" : \"\"].filter(Boolean).join(\"\\n\");\n    return {\n        id: rawId,\n        title: title || code.toUpperCase(),\n        cover: pic,\n        desc: desc,\n        duration: remarks,\n        tags: tags ? tags.split(\",\").map(function (t) { return t.trim(); }).filter(Boolean) : [],\n        lines: [{name: \"MissAV\", episodes: [{id: playId, name: \"正片\"}]}],\n    };\n}\n\nasync function play(arg) {\n    const raw = str((arg && arg.id) || (arg && arg.episodeId));\n    if (!raw) throw new Error(\"无效的播放地址\");\n    let url = raw;\n    if (url.toLowerCase().indexOf(\".m3u8\") < 0) {\n        const html = await fetchText(url);\n        const found = extractM3u8(html);\n        if (!found) throw new Error(\"未找到可用播放地址\");\n        url = found;\n    }\n    return {\n        streams: [{\n            url: url,\n            format: \"hls\",\n            headers: {\n                \"User-Agent\": UA,\n                \"Referer\": PLAY_REFERER,\n                \"Origin\": PLAY_ORIGIN,\n                \"Accept\": \"*/*\",\n            },\n            name: \"MissAV\",\n        }],\n    };\n}\n\nexport default {home: home, category: category, search: search, detail: detail, play: play};\n"}}