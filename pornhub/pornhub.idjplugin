   [1951, \"passionate-lesbian\"],\n    [1961, \"pillow-princess-lesbian\"],\n    [211, \"pissing\"],\n    [1971, \"pissing-lesbian\"],\n    [891, \"podcast\"],\n    [1981, \"podcast-lesbian\"],\n    [73, \"popular-with-women\"],\n    [30, \"pornstar\"],\n    [60, \"pornstar-gay\"],\n    [41, \"pov\"],\n    [372, \"pov-gay\"],\n    [702, \"pov-1\"],\n    [1991, \"pov-lesbian\"],\n    [24, \"public\"],\n    [84, \"public-gay\"],\n    [131, \"pussy-licking\"],\n    [2011, \"pussy-licking-lesbian\"],\n    [2401, \"queer\"],\n    [921, \"reaction\"],\n    [931, \"reaction-gay\"],\n    [2021, \"reaction-lesbian\"],\n    [2391, \"real-couples\"],\n    [31, \"reality\"],\n    [85, \"reality-gay\"],\n    [2031, \"reality-lesbian\"],\n    [42, \"red-head\"],\n    [81, \"role-play\"],\n    [2051, \"role-play-lesbian\"],\n    [522, \"romantic\"],\n    [2061, \"romantic-lesbian\"],\n    [67, \"rough-sex\"],\n    [312, \"rough-sex-gay\"],\n    [99, \"russian\"],\n    [1351, \"sapphic\"],\n    [88, \"school-18\"],\n    [532, \"scissoring\"],\n    [2091, \"scissoring-lesbian\"],\n    [221, \"sfw\"],\n    [2101, \"sfw-lesbian\"],\n    [2111, \"shaved-pussy-lesbian\"],\n    [59, \"small-tits\"],\n    [2121, \"small-tits-lesbian\"],\n    [91, \"smoking\"],\n    [492, \"solo-female\"],\n    [2141, \"solo-female-lesbian\"],\n    [54, \"solo-male-gay\"],\n    [92, \"solo-male\"],\n    [69, \"squirt\"],\n    [2151, \"squirt-lesbian\"],\n    [444, \"step-fantasy\"],\n    [82, \"straight-guys-gay\"],\n    [542, \"strap-on\"],\n    [2161, \"strap-on-lesbian\"],\n    [33, \"striptease\"],\n    [2171, \"stud-lesbian\"],\n    [552, \"tattooed-men-gay\"],\n    [562, \"tattooed-women\"],\n    [65, \"threesome\"],\n    [2191, \"threesome-lesbian\"],\n    [23, \"toys\"],\n    [2201, \"toys-lesbian\"],\n    [2211, \"trans-lesbian-lesbian\"],\n    [602, \"trans-male\"],\n    [572, \"trans-with-girl\"],\n    [582, \"trans-with-guy\"],\n    [83, \"transgender\"],\n    [2221, \"transgender-lesbian\"],\n    [2231, \"tribbing-lesbian\"],\n    [49, \"twink-18\"],\n    [712, \"uncensored\"],\n    [722, \"uncensored-1\"],\n    [272, \"uncut-gay\"],\n    [138, \"verified-amateurs\"],\n    [731, \"verified-amateurs-gay\"],\n    [482, \"verified-couples\"],\n    [139, \"verified-models\"],\n    [43, \"vintage\"],\n    [77, \"vintage-gay\"],\n    [104, \"vr\"],\n    [106, \"virtual-reality-1\"],\n    [2241, \"virtual-reality-lesbian\"],\n    [61, \"webcam\"],\n    [342, \"webcam-gay\"],\n    [2251, \"webcam-lesbian\"],\n    [2361, \"wet-pussy\"],\n    [2261, \"wlw-women-love-women-lesbian\"],\n];\n\nfunction str(value) {\n    if (value == null) return \"\";\n    return String(value);\n}\n\nfunction cleanText(value) {\n    return str(value)\n        .replace(/<[^>]*>/g, \" \")\n        .replace(/&#(\\d+);/g, function (m, code) { return String.fromCharCode(parseInt(code, 10)); })\n        .replace(/&#x([0-9a-fA-F]+);/g, function (m, code) { return String.fromCharCode(parseInt(code, 16)); })\n        .replace(/&nbsp;/gi, \" \")\n        .replace(/&amp;/gi, \"&\")\n        .replace(/&quot;/gi, '\"')\n        .replace(/&#39;|&apos;/gi, \"'\")\n        .replace(/&lt;/gi, \"<\")\n        .replace(/&gt;/gi, \">\")\n        .replace(/\\\\u([0-9a-fA-F]{4})/g, function (m, code) { return String.fromCharCode(parseInt(code, 16)); })\n        .replace(/\\s+/g, \" \")\n        .trim();\n}\n\nfunction firstMatch(text, regex, index) {\n    const match = regex.exec(text || \"\");\n    return match ? str(match[index == null ? 1 : index]) : \"\";\n}\n\nfunction unescapeJsonUrl(value) {\n    return str(value).replace(/\\\\\\//g, \"/\").replace(/\\\\\\\\/g, \"\\\\\").replace(/\\\\u0026/gi, \"&\");\n}\n\nasync function fetchJson(path) {\n    const url = path.indexOf(\"http\") === 0 ? path : SITE + path;\n    const resp = await host.http.request({\n        url: url,\n        method: \"GET\",\n        headers: {\"User-Agent\": UA, \"Accept\": \"application/json, */*\", \"Referer\": SITE + \"/\"},\n        timeout: TIMEOUT,\n    });\n    if (resp.status < 200 || resp.status >= 300) throw new Error(\"HTTP \" + resp.status);\n    const body = resp.body == null ? \"\" : String(resp.body);\n    return JSON.parse(body);\n}\n\nasync function fetchText(url) {\n    const resp = await host.http.request({\n        url: url,\n        method: \"GET\",\n        headers: {\n            \"User-Agent\": UA,\n            \"Accept\": \"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\",\n            \"Accept-Language\": \"zh-CN,zh;q=0.9,en;q=0.6\",\n            \"Referer\": SITE + \"/\",\n        },\n        timeout: TIMEOUT,\n    });\n    if (resp.status < 200 || resp.status >= 300) throw new Error(\"HTTP \" + resp.status);\n    const body = resp.body == null ? \"\" : String(resp.body);\n    if (body.length < 2000) throw new Error(\"body too small\");\n    if (body.toLowerCase().indexOf(\"just a moment\") >= 0 && body.length < 12000) {\n        throw new Error(\"cloudflare challenge\");\n    }\n    return body;\n}\n\nfunction apiVideoCard(v) {\n    const tags = [];\n    const tagList = v.tags || [];\n    for (const t of tagList) {\n        if (t && t.tag_name) tags.push(t.tag_name);\n    }\n    const catList = v.categories || [];\n    for (const c of catList) {\n        if (c && c.category) tags.push(c.category);\n    }\n    const stars = v.pornstars || [];\n    for (const s of stars) {\n        if (s && s.pornstar_name) tags.push(s.pornstar_name);\n    }\n    return {\n        id: str(v.video_id || \"\"),\n        title: v.title || str(v.video_id || \"\"),\n        cover: v.default_thumb || v.thumb || \"\",\n        remarks: v.duration || \"\",\n        duration: v.duration || \"\",\n        tags: tags,\n    };\n}\n\nfunction apiItems(data) {\n    const out = [];\n    const videos = (data && data.videos) || [];\n    for (const v of videos) {\n        if (v && v.video_id) out.push(apiVideoCard(v));\n    }\n    return out;\n}\n\nasync function searchApi(params, page) {\n    const data = await fetchJson(\"/webmasters/search?\" + params + \"&page=\" + page);\n    if (data && data.code && String(data.code) !== \"2000\") {\n        // 站方错误体 {\"code\":\"2000\",\"message\":\"Category does not exist!\"}\n        if (data.message) throw new Error(String(data.message));\n    }\n    return apiItems(data);\n}\n\nfunction parseMediaDefinitions(html) {\n    const defs = [];\n    const regex = /\"format\"\\s*:\\s*\"(hls|mp4)\"\\s*,\\s*\"videoUrl\"\\s*:\\s*\"((?:[^\"\\\\]|\\\\.)*)\"\\s*,\\s*\"quality\"\\s*:\\s*\"(\\d+)\"/gi;\n    let m;\n    while ((m = regex.exec(html || \"\")) !== null) {\n        const url = unescapeJsonUrl(m[2]);\n        if (!url) continue;\n        let quality = 0;\n        try { quality = parseInt(m[3], 10) || 0; } catch (error) { quality = 0; }\n        defs.push({format: m[1].toLowerCase(), url: url, quality: quality});\n    }\n    // defaultQuality 标记：页内另有 \"defaultQuality\":true 的条目，优先它\n    const defRegex = /\"defaultQuality\"\\s*:\\s*(true|false)\\s*,\\s*\"format\"\\s*:\\s*\"(hls|mp4)\"\\s*,\\s*\"videoUrl\"\\s*:\\s*\"((?:[^\"\\\\]|\\\\.)*)\"\\s*,\\s*\"quality\"\\s*:\\s*\"(\\d+)\"/gi;\n    while ((m = defRegex.exec(html || \"\")) !== null) {\n        if (m[1] === \"true\") {\n            const url = unescapeJsonUrl(m[3]);\n            for (const d of defs) {\n                if (d.url === url) d.isDefault = true;\n            }\n        }\n    }\n    defs.sort(function (a, b) {\n        if ((a.isDefault ? 1 : 0) !== (b.isDefault ? 1 : 0)) return (b.isDefault ? 1 : 0) - (a.isDefault ? 1 : 0);\n        return b.quality - a.quality;\n    });\n    return defs;\n}\n\nfunction allCategories() {\n    const list = [];\n    for (const row of FIXED) list.push({id: row[0], name: row[1]});\n    for (const row of CATS) list.push({id: \"cat@@\" + row[0], name: row[1]});\n    return list;\n}\n\n// ---------- idj1 契约 ----------\n\nasync function home() {\n    let items = [];\n    try {\n        items = await searchApi(\"sea