{"manifest":{"schema":1,"id":"com.idj.ext.hgdjv","name":"黄果短剧视频","version":"1.0.0","author":{"name":"py 蜘蛛改写"},"description":"黄果短剧视频（内置 jar 站 ZakaHgdjV 改写）。接口域名走 crks.json 分发加 /api/sys/live 探活（回退线路域名随机子域），游客登录走 jar 同款 AES-ECB 加密契约，接口 encData 用令牌片段 AES-CBC 解密（插件内自带 AES 实现）；分类照 /api/video/classifyList 全量 11 个（短剧精选/魔改短剧/小编推荐/伦理之爱/国产精选/动漫/网黄精选/新番AV/原创传媒/欧美精选/禁区），不删减不合并；列表 /api/video/getVideoList、搜索 /api/search/keyWord、详情 /api/video/getVideoById（serialVideos 为分集）；播放走 jar 的签名网关 /api/v2/m3u8/play（HMAC-SHA256 签名加 authKey），主清单在 play 内预解析到子清单。封面照 jar 走 hgimg.ystv.top 图片代理（图床原图为加密块、代理还原，图床域名轮换）。","type":"video","adult":true,"language":["zh"],"minAppVersion":"1.5","entry":"main.js","permissions":{"http":["d15beepu2m390g.cloudfront.net","tc-jp-alijs-1375272368.cos.ap-tokyo.myqcloud.com","*.qcj2o8pi.work","*.833x5qay.work","*.uackh75z.work","*.t5jrp0ov.work","*.t9ds6oaj.work","*.lv6gj9b1.work","*.qg74b2wp.work","*.iumigc.com","*.kgjci.com","*.eldtbz.com","hgimg.ystv.top"],"media":["*.qcj2o8pi.work","*.833x5qay.work","*.uackh75z.work","*.t5jrp0ov.work","*.t9ds6oaj.work","*.lv6gj9b1.work","*.qg74b2wp.work","*.iumigc.com","*.kgjci.com","*.eldtbz.com","hgimg.ystv.top"],"cloudflare":false,"storage":true,"login":false},"capabilities":["home","category","search","detail","play"],"settings":[],"update":{"url":"https://raw.githubusercontent.com/hoyittvggfh45/moytv/plugins/hgdjv/hgdjv.idjplugin"},"integrity":"sha256-QmdqRFWezw6V/ditvRZSYu6/BM47mjoztgf/mZcoz70="},"files":{"main.js":"// Huangguo short-drama video — idj1 plugin (ported from the builtin jar\n// spider com.github.catvod.spider.ZakaHgdjVAmns, ext is empty).\n// API base is discovered like the jar: GET the two crks.json distribution\n// files, probe each candidate with /api/sys/live; fall back to the jar's\n// four line domains with a random subdomain, then to the last known good\n// bases from the distribution file. Every API call carries the jar's\n// device headers (t = millis, s = md5 of t[3..8]) and, after the guest\n// login, the token in the \"aut\" header. Guest login: POST\n// /api/user/traveler/{key}/login with an AES-128-ECB encrypted body; the\n// key is the reversed 16-char slice of the path key, exactly as the jar.\n// API answers may carry encData: AES-128-CBC, key = iv = token[2..18].\n// The sandbox harness only implements CBC, so ECB (and CBC, for\n// uniformity) runs on the small built-in AES below, verified byte-exact\n// against the platform cipher. Categories come from\n// /api/video/classifyList with no additions or removals. Lists from\n// /api/video/getVideoList, search from /api/search/keyWord, detail from\n// /api/video/getVideoById (serialVideos become the episodes). Play: the\n// jar builds a signed gateway URL /api/v2/m3u8/play?path=..&token=..\n// &ts=..&nonce=..&sign=HMAC-SHA256(videoUrl + token + ts + nonce, signKey)\n// with signKey from /api/v2/m3u8/play/signKey and server time from\n// /api/v2/m3u8/play/time; the videoUrl/authKey come from\n// /api/video/can/watch, falling back to the detail payload and to\n// /api/m3u8/decode/by/id. The gateway answers a media playlist; a master\n// playlist is pre-resolved to its first variant inside play().\n\nconst DEVICE_ID = \"8ff2fabf0895c3bc6a54f66b05e2b3ba\";\nconst APP_VERSION = \"1.5.8\";\nconst API_UA = \"okhttp/4.9.0\";\nconst PLAY_UA = \"Mozilla/5.0 (Linux; Android 13; Pixel 7) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Mobile Safari/537.36\";\nconst TIMEOUT = 58000;\nconst PAGE_SIZE = 30;\nconst CRKS_URLS = [\n    \"https://d15beepu2m390g.cloudfront.net/crks.json\",\n    \"https://tc-jp-alijs-1375272368.cos.ap-tokyo.myqcloud.com/crks.json\",\n];\nconst LINE_DOMAINS = [\"t5jrp0ov.work\", \"t9ds6oaj.work\", \"lv6gj9b1.work\", \"qg74b2wp.work\"];\nconst KNOWN_BASES = [\n    \"https://xBNie95.qcj2o8pi.work\",\n    \"https://qoIkFE7.833x5qay.work\",\n    \"https://RA9T7xv.uackh75z.work\",\n];\n\n// ---------- minimal AES-128 (ECB/CBC, PKCS7), verified against Node ----------\n\nconst AES = (function () {\n    const EXP = new Uint8Array(512), LOG = new Uint8Array(256);\n    let x = 1;\n    for (let i = 0; i < 255; i++) {\n        EXP[i] = x; LOG[x] = i;\n        let v = x << 1; if (v & 0x100) v ^= 0x11b; x ^= v & 0xff;\n    }\n    for (let i = 255; i < 512; i++) EXP[i] = EXP[i - 255];\n    function mul(a, b) { return (a && b) ? EXP[LOG[a] + LOG[b]] : 0; }\n    const SBOX = new Uint8Array(256), INV = new Uint8Array(256);\n    for (let i = 0; i < 256; i++) {\n        const inv = i ? EXP[255 - LOG[i]] : 0;\n        let s = inv;\n        s ^= ((inv << 1) | (inv >> 7)) & 0xff;\n        s ^= ((inv << 2) | (inv >> 6)) & 0xff;\n        s ^= ((inv << 3) | (inv >> 5)) & 0xff;\n        s ^= ((inv << 4) | (inv >> 4)) & 0xff;\n        SBOX[i] = (s ^ 0x63) & 0xff;\n        INV[SBOX[i]] = i;\n    }\n    const RCON = [1, 2, 4, 8, 16, 32, 64, 128, 27, 54];\n    function expandKey(key) {\n        const w = new Uint8Array(176);\n        w.set(key);\n        for (let i = 16; i < 176; i += 4) {\n            let t0 = w[i - 4], t1 = w[i - 3], t2 = w[i - 2], t3 = w[i - 1];\n            if (i % 16 === 0) {\n                const r = RCON[i / 16 - 1];\n                const n0 = SBOX[t1] ^ r, n1 = SBOX[t2], n2 = SBOX[t3], n3 = SBOX[t0];\n                t0 = n0; t1 = n1; t2 = n2; t3 = n3;\n            }\n            w[i] = w[i - 16] ^ t0; w[i + 1] = w[i - 15] ^ t1; w[i + 2] = w[i - 14] ^ t2; w[i + 3] = w[i - 13] ^ t3;\n        }\n        return w;\n    }\n    function addKey(s, w, off) { for (let i = 0; i < 16; i++) s[i] ^= w[off + i]; }\n    function shiftRows(s) {\n        const t = Uint8Array.from(s);\n        for (let r = 0; r < 4; r++) for (let c = 0; c < 4; c++) s[c * 4 + r] = t[((c + r) % 4) * 4 + r];\n    }\n    function invShiftRows(s) {\n        const t = Uint8Array.from(s);\n        for (let r = 0; r < 4; r++) for (let c = 0; c < 4; c++) s[c * 4 + r] = t[((c - r + 4) % 4) * 4 + r];\n    }\n    function mixCols(s) {\n        for (let c = 0; c < 4; c++) {\n            const i = c * 4, a0 = s[i], a1 = s[i + 1], a2 = s[i + 2], a3 = s[i + 3];\n            s[i] = mul(a0, 2) ^ mul(a1, 3) ^ a2 ^ a3;\n            s[i + 1] = a0 ^ mul(a1, 2) ^ mul(a2, 3) ^ a3;\n            s[i + 2] = a0 ^ a1 ^ mul(a2, 2) ^ mul(a3, 3);\n            s[i + 3] = mul(a0, 3) ^ a1 ^ a2 ^ mul(a3, 2);\n        }\n    }\n    function invMixCols(s) {\n        for (let c = 0; c < 4; c++) {\n            const i = c * 4, a0 = s[i], a1 = s[i + 1], a2 = s[i + 2], a3 = s[i + 3];\n            s[i] = mul(a0, 14) ^ mul(a1, 11) ^ mul(a2, 13) ^ mul(a3, 9);\n            s[i + 1] = mul(a0, 9) ^ mul(a1, 14) ^ mul(a2, 11) ^ mul(a3, 13);\n            s[i + 2] = mul(a0, 13) ^ mul(a1, 9) ^ mul(a2, 14) ^ mul(a3, 11);\n            s[i + 3] = mul(a0, 11) ^ mul(a1, 13) ^ mul(a2, 9) ^ mul(a3, 14);\n        }\n    }\n    function encBlock(w, input, off) {\n        const s = new Uint8Array(16);\n        for (let i = 0; i < 16; i++) s[i] = input[off + i];\n        addKey(s, w, 0);\n        for (let round = 1; round < 10; round++) {\n            for (let i = 0; i < 16; i++) s[i] = SBOX[s[i]];\n            shiftRows(s); mixCols(s); addKey(s, w, round * 16);\n        }\n        for (let i = 0; i < 16; i++) s[i] = SBOX[s[i]];\n        shiftRows(s); addKey(s, w, 160);\n        return s;\n    }\n    function decBlock(w, input, off) {\n        const s = new Uint8Array(16);\n        for (let i = 0; i < 16; i++) s[i] = input[off + i];\n        addKey(s, w, 160);\n        for (let round = 9; round >= 1; round--) {\n            invShiftRows(s);\n            for (let i = 0; i < 16; i++) s[i] = INV[s[i]];\n            addKey(s, w, round * 16); invMixCols(s);\n        }\n        invShiftRows(s);\n        for (let i = 0; i < 16; i++) s[i] = INV[s[i]];\n        addKey(s, w, 0);\n        return s;\n    }\n    function encryptEcb(data, key) {\n        const w = expandKey(key);\n        const pad = 16 - (data.length % 16);\n        const buf = new Uint8Array(data.length + pad);\n        buf.set(data); for (let i = data.length; i < buf.length; i++) buf[i] = pad;\n        const out = new Uint8Array(buf.length);\n        for (let off = 0; off < buf.length; off += 16) out.set(encBlock(w, buf, off), off);\n        return out;\n    }\n    function decryptEcb(data, key) {\n        const w = expandKey(key);\n        const out = new Uint8Array(data.length);\n        for (let off = 0; off < data.length; off += 16) out.set(decBlock(w, data, off), off);\n        const pad = out.length ? out[out.length - 1] : 0;\n        if (pad > 0 && pad <= 16) return out.slice(0, out.length - pad);\n        return out;\n    }\n    function decryptCbc(data, key, iv) {\n        const w = expandKey(key);\n        const out = new Uint8Array(data.length);\n        let prev = iv;\n        for (let off = 0; off < data.length; off += 16) {\n            const blk = decBlock(w, data, off);\n            for (let i = 0; i < 16; i++) out[off + i] = blk[i] ^ prev[i];\n            prev = data.slice(off, off + 16);\n        }\n        const pad = out.length ? out[out.length - 1] : 0;\n        if (pad > 0 && pad <= 16) return out.slice(0, out.length - pad);\n        return out;\n    }\n    return {encryptEcb: encryptEcb, decryptEcb: decryptEcb, decryptCbc: decryptCbc};\n})();\n\n// ---------- byte helpers ----------\n\nfunction utf8Bytes(s) {\n    const out = [];\n    for (let i = 0; i < s.length; i++) {\n        let cp = s.charCodeAt(i);\n        if (cp < 0x80) { out.push(cp); continue; }\n        if (cp < 0x800) { out.push(0xc0 | (cp >> 6), 0x80 | (cp & 0x3f)); continue; }\n        if (cp >= 0xd800 && cp <= 0xdbff && i + 1 < s.length) {\n            const lo = s.charCodeAt(i + 1);\n            if (lo >= 0xdc00 && lo <= 0xdfff) {\n                cp = 0x10000 + ((cp - 0xd800) * 0x400) + (lo - 0xdc00);\n                i++;\n                out.push(0xf0 | (cp >> 18), 0x80 | ((cp >> 12) & 0x3f), 0x80 | ((cp >> 6) & 0x3f), 0x80 | (cp & 0x3f));\n                continue;\n            }\n        }\n        out.push(0xe0 | (cp >> 12), 0x80 | ((cp >> 6) & 0x3f), 0x80 | (cp & 0x3f));\n    }\n    return new Uint8Array(out);\n}\n\nfunction bytesToUtf8(bytes) {\n    let out = \"\";\n    let i = 0;\n    while (i < bytes.length) {\n        const b = bytes[i];\n        if (b < 0x80) { out += String.fromCharCode(b); i += 1; continue; }\n        if (b >= 0xc2 && b < 0xe0) { out += String.fromCharCode(((b & 0x1f) << 6) | (bytes[i + 1] & 0x3f)); i += 2; continue; }\n        if (b >= 0xe0 && b < 0xf0) { out += String.fromCharCode(((b & 0x0f) << 12) | ((bytes[i + 1] & 0x3f) << 6) | (bytes[i + 2] & 0x3f)); i += 3; continue; }\n        if (b >= 0xf0 && b < 0xf5) {\n            let cp = ((b & 0x07) << 18) | ((bytes[i + 1] & 0x3f) << 12) | ((bytes[i + 2] & 0x3f) << 6) | (bytes[i + 3] & 0x3f);\n            cp -= 0x10000;\n            out += String.fromCharCode(0xd800 + (cp >> 10), 0xdc00 + (cp & 0x3ff));\n            i += 4; continue;\n        }\n        out += \"?\"; i += 1;\n    }\n    return out;\n}\n\nfunction b64EncodeBytes(bytes) {\n    return host.codec.convert(bytesToLatin1(bytes), \"latin1\", \"base64\");\n}\n\nfunction b64DecodeBytes(text) {\n    const s = host.codec.convert(String(text || \"\"), \"base64\", \"latin1\");\n    const out = new Uint8Array(s.length);\n    for (let i = 0; i < s.length; i++) out[i] = s.charCodeAt(i) & 0xff;\n    return out;\n}\n\nfunction bytesToLatin1(bytes) {\n    let s = \"\";\n    for (let i = 0; i < bytes.length; i++) s += String.fromCharCode(bytes[i]);\n    return s;\n}\n\nfunction str(value) {\n    if (value == null) return \"\";\n    return String(value).trim();\n}\n\nfunction toInt(value, dflt) {\n    const n = parseInt(value, 10);\n    return isFinite(n) ? n : dflt;\n}\n\nfunction parseJson(text) {\n    try {\n        const v = JSON.parse(text);\n        return (v && typeof v === \"object\") ? v : {};\n    } catch (e) {\n        return {};\n    }\n}\n\n// ---------- session state (storage-backed, like the jar's fields) ----------\n\nfunction storeGet(k) { try { return host.storage.get(k) || \"\"; } catch (e) { return \"\"; } }\nfunction storeSet(k, v) { try { host.storage.set(k, v || \"\"); } catch (e) { /* ignore */ } }\n\nlet base = \"\";\nlet token = \"\";\nlet imgDomain = \"\";\nlet signKey = \"\";\nlet signKeyAt = 0;\nlet catsCache = null;\nconst detailCache = {};\n\nfunction loadState() {\n    if (base) return;\n    base = storeGet(\"base\");\n    token = storeGet(\"token\");\n    imgDomain = storeGet(\"imgDomain\");\n}\n\nfunction saveState() {\n    storeSet(\"base\", base);\n    storeSet(\"token\", token);\n    storeSet(\"imgDomain\", imgDomain);\n}\n\nfunction apiHeaders() {\n    const t = String(Date.now());\n    const s = host.crypto.md5(t.substring(3, 8), {in: \"utf8\", out: \"hex\"});\n    const h = {\n        \"Content-Type\": \"application/json\",\n        \"Accept\": \"application/json\",\n        \"deviceId\": DEVICE_ID,\n        \"appVersion\": APP_VERSION,\n        \"device\": \"Android\",\n        \"systemName\": \"Android\",\n        \"deviceBrand\": \"google\",\n        \"deviceModel\": \"Pixel 3\",\n        \"systemVersion\": \"13\",\n        \"t\": t,\n        \"s\": s,\n        \"User-Agent\": API_UA,\n    };\n    if (token) h[\"aut\"] = token;\n    return h;\n}\n\n// One raw request with retries; returns {status, body} and never throws on\n// HTTP status (the jar reads the error stream the same way).\nasync function rawRequest(method, url, body, timeout, tries) {\n    let lastError = null;\n    const n = tries || 3;\n    for (let attempt = 0; attempt < n; attempt++) {\n        try {\n            let resp;\n            if (method === \"POST\") {\n                resp = await host.http.post(url, body || \"\", {headers: apiHeaders(), timeout: timeout || TIMEOUT});\n            } else {\n                resp = await host.http.get(url, {headers: apiHeaders(), timeout: timeout || TIMEOUT});\n            }\n            return {status: resp.status, body: resp.body || \"\"};\n        } catch (error) {\n            lastError = error;\n        }\n    }\n    throw host.error(\"E_NETWORK\", \"request failed \" + url + \": \" + (lastError && lastError.message));\n}\n\nfunction unwrap(j) {\n    if (!j || typeof j !== \"object\") return {};\n    const enc = str(j.encData);\n    if (enc && token && token.length >= 18) {\n        try {\n            const key = utf8Bytes(token.substring(2, 18));\n            const plain = AES.decryptCbc(b64DecodeBytes(enc), key, key);\n            const v = JSON.parse(bytesToUtf8(plain));\n            return (v && typeof v === \"object\") ? v : {};\n        } catch (e) {\n            return {};\n        }\n    }\n    if (j.data && typeof j.data === \"object\") return j.data;\n    return {};\n}\n\nasync function apiCall(method, path, body, allowRelogin) {\n    const r = await rawRequest(method, base + path, body);\n    let j = parseJson(r.body);\n    if (allowRelogin !== false && (toInt(j.code, 0) === 1001 || toInt(j.code, 0) === 1003)) {\n        await login();\n        const r2 = await rawRequest(method, base + path, body);\n        j = parseJson(r2.body);\n    }\n    return j;\n}\n\nasync function apiGet(path) {\n    return apiCall(\"GET\", path, null, true);\n}\n\n// ---------- discovery + guest login (jar discover/login) ----------\n\nasync function probeBase(candidate) {\n    try {\n        const r = await rawRequest(\"GET\", candidate + \"/api/sys/live\", null, 45000, 2);\n        return toInt(parseJson(r.body).code, 0) === 200;\n    } catch (e) {\n        return false;\n    }\n}\n\nasync function discover() {\n    // Fast path first: the bases the distribution file handed out most\n    // recently (probing them costs one /api/sys/live each); the jar's own\n    // order (distribution file, then line domains) is the fallback.\n    for (const kb of KNOWN_BASES) {\n        if (await probeBase(kb)) return kb;\n    }\n    const candidates = [];\n    for (const u of CRKS_URLS) {\n        try {\n            const resp = await host.http.get(u, {headers: {\"User-Agent\": API_UA}, timeout: TIMEOUT});\n            if (resp.status === 200) {\n                const arr = JSON.parse(resp.body || \"[]\");\n                if (Array.isArray(arr)) for (const v of arr) if (str(v)) candidates.push(str(v));\n            }\n        } catch (e) { /* next distribution file */ }\n        if (candidates.length) break;\n    }\n    for (let cand of candidates) {\n        while (cand.endsWith(\"/\")) cand = cand.slice(0, -1);\n        if (cand.indexOf(\"https://\") !== 0) continue;\n        if (KNOWN_BASES.indexOf(cand) >= 0) continue;\n        if (await probeBase(cand)) return cand;\n    }\n    const chars = \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\";\n    for (const domain of LINE_DOMAINS) {\n        const hex = host.crypto.randomHex(8);\n        let sub = \"\";\n        const n = 4 + (parseInt(hex.slice(0, 2), 16) % 4);\n        for (let i = 0; i < n; i++) sub += chars.charAt(parseInt(hex.slice(2 + i * 2, 4 + i * 2), 16) % 62);\n        const cand = \"https://\" + sub + \".\" + domain;\n        if (await probeBase(cand)) return cand;\n    }\n    return \"\";\n}\n\nasync function login() {\n    const sec = Math.floor(Date.now() / 1000);\n    let hexSec = sec.toString(16);\n    hexSec = hexSec.length >= 8 ? hexSec.substring(0, 8) : (\"00000000\" + hexSec).slice(-8);\n    const pathKey = hexSec + host.crypto.randomHex(8);\n    const i = sec % 8;\n    const keyStr = pathKey.substring(i, i + 16).split(\"\").reverse().join(\"\");\n    const chars = \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\";\n    const ttb = chars.charAt(parseInt(host.crypto.randomHex(1), 16) % 62);\n    const plain = JSON.stringify({deviceId: DEVICE_ID, ttb: ttb});\n    const encStr = b64EncodeBytes(AES.encryptEcb(utf8Bytes(plain), utf8Bytes(keyStr)));\n    const r = await rawRequest(\"POST\", base + \"/api/user/traveler/\" + pathKey + \"/login\", JSON.stringify({encStr: encStr}));\n    const j = parseJson(r.body);\n    if (toInt(j.code, 0) === 200 && typeof j.data === \"string\") {\n        try {\n            const dec = JSON.parse(bytesToUtf8(AES.decryptEcb(b64DecodeBytes(j.data), utf8Bytes(keyStr))));\n            token = str(dec.token);\n            imgDomain = str(dec.imgDomain);\n            signKey = \"\";\n            signKeyAt = 0;\n            saveState();\n        } catch (e) { /* token stays empty; callers surface the failure */ }\n    }\n}\n\nlet sessionReady = false;\n\nasync function ensureSession() {\n    loadState();\n    if (sessionReady && base && token) return;\n    if (!base) {\n        base = await discover();\n        if (!base) throw host.error(\"E_NETWORK\", \"no reachable API base (discovery failed)\");\n        storeSet(\"base\", base);\n    }\n    if (!token) {\n        await login();\n        if (!token) {\n            // The stored base may have rotated away; rediscover once.\n            base = await discover();\n            if (base) {\n                storeSet(\"base\", base);\n                await login();\n            }\n        }\n        if (!token) throw host.error(\"E_NETWORK\", \"guest login failed on \" + base);\n    }\n    sessionReady = true;\n}\n\n// ---------- covers / cards (jar cover/card) ----------\n\nfunction coverOf(obj, domain) {\n    if (!obj || typeof obj !== \"object\") return \"\";\n    const arrays = [obj.authCoverImg, obj.authVerticalImg, obj.coverImg, obj.verticalImg];\n    let raw = \"\";\n    for (const a of arrays) {\n        if (Array.isArray(a) && a.length && str(a[0])) { raw = str(a[0]); break; }\n    }\n    if (!raw) return \"\";\n    let abs = raw;\n    if (abs.indexOf(\"http://\") !== 0 && abs.indexOf(\"https://\") !== 0) {\n        let dom = str(domain) || imgDomain;\n        if (!dom) return raw;\n        while (dom.endsWith(\"/\")) dom = dom.slice(0, -1);\n        while (abs.charAt(0) === \"/\") abs = abs.slice(1);\n        abs = dom + \"/\" + abs;\n    }\n    // The jar wraps every cover in the hgimg image proxy: the raw bytes on\n    // the image CDN are an encrypted blob and the proxy returns the plain\n    // image. Kept exactly as the jar does it.\n    return \"https://hgimg.ystv.top/?u=\" + encodeURIComponent(abs);\n}\n\nfunction cardOf(obj, domain) {\n    if (!obj || typeof obj !== \"object\") return null;\n    const id = str(obj.videoId);\n    const title = str(obj.title);\n    if (!id || !title) return null;\n    let remarks = \"\";\n    if (obj.shortDrama) remarks = \"短剧\";\n    else if (Array.isArray(obj.tagTitles) && obj.tagTitles.length) remarks = str(obj.tagTitles[0]);\n    const item = {id: id, title: title, remarks: remarks, tags: []};\n    const cov = coverOf(obj, domain);\n    if (cov) item.cover = cov;\n    return item;\n}\n\nfunction cardsOf(list, domain) {\n    const out = [];\n    for (const v of list || []) {\n        const c = cardOf(v, domain);\n        if (c) out.push(c);\n    }\n    return out;\n}\n\n// ---------- categories (jar cats: classifyList, 1:1, no edits) ----------\n\nasync function categories() {\n    if (catsCache) return catsCache;\n    await ensureSession();\n    const u = unwrap(await apiGet(\"/api/video/classifyList\"));\n    const list = Array.isArray(u.data) ? u.data : [];\n    const cats = [];\n    for (const item of list) {\n        if (!item || typeof item !== \"object\") continue;\n        const cid = str(item.classifyId);\n        const name = str(item.classifyTitle);\n        if (cid && name) cats.push({id: cid, name: name});\n    }\n    if (!cats.length) throw host.error(\"E_PARSE\", \"classifyList returned no categories\");\n    catsCache = cats;\n    return cats;\n}\n\n// ---------- contract ----------\n\nasync function home() {\n    const cats = await categories();\n    const first = await category({id: cats[0].id, page: 1});\n    return {categories: cats, items: first.items, hasMore: first.hasMore};\n}\n\nasync function category(arg) {\n    await ensureSession();\n    let pg = toInt(arg && arg.page, 1);\n    if (pg < 1) pg = 1;\n    const tid = str(arg && arg.id);\n    const path = \"/api/video/getVideoList?pageSize=\" + PAGE_SIZE + \"&page=\" + pg +\n        \"&classifyId=\" + encodeURIComponent(tid) + \"&sortType=1\";\n    const u = unwrap(await apiGet(path));\n    const items = cardsOf(Array.isArray(u.data) ? u.data : [], str(u.domain));\n    const total = toInt(u.total, 0);\n    const hasMore = total > 0 ? (pg * PAGE_SIZE < total) : (items.length >= PAGE_SIZE);\n    return {items: items, hasMore: hasMore};\n}\n\nasync function search(arg) {\n    await ensureSession();\n    let pg = toInt(arg && arg.page, 1);\n    if (pg < 1) pg = 1;\n    const keyword = str(arg && arg.keyword);\n    const path = \"/api/search/keyWord?pageSize=20&page=\" + pg +\n        \"&searchWord=\" + encodeURIComponent(keyword) + \"&searchType=3&shortDrama=true\";\n    const u = unwrap(await apiGet(path));\n    const items = cardsOf(Array.isArray(u.videoList) ? u.videoList : [], str(u.domain));\n    return {items: items, hasMore: items.length >= 20};\n}\n\nasync function detail(arg) {\n    await ensureSession();\n    const vid = str(arg && arg.id);\n    if (!vid) throw host.error(\"E_PARSE\", \"missing id\");\n    const u = unwrap(await apiGet(\"/api/video/getVideoById?videoId=\" + encodeURIComponent(vid)));\n    const title = str(u.title);\n    if (!title) throw host.error(\"E_PARSE\", \"detail has no title for id \" + vid);\n    detailCache[vid] = u;\n    const episodes = [];\n    const serial = Array.isArray(u.serialVideos) ? u.serialVideos : [];\n    if (serial.length) {\n        for (let i = 0; i < serial.length; i++) {\n            const ep = serial[i];\n            if (!ep || typeof ep !== \"object\") continue;\n            const eid = str(ep.videoId);\n            if (!eid) continue;\n            episodes.push({id: eid, name: str(ep.title) || (\"第\" + (i + 1) + \"集\")});\n        }\n    }\n    if (!episodes.length) episodes.push({id: vid, name: \"正片\"});\n    const tags = Array.isArray(u.tagTitles) ? u.tagTitles.map(t => str(t)).filter(t => t) : [];\n    const out = {\n        id: vid,\n        title: title,\n        desc: tags.join(\" \"),\n        tags: tags,\n        remarks: u.shortDrama ? \"短剧\" : \"\",\n        lines: [{name: \"黄果短剧\", episodes: episodes}],\n    };\n    const cov = coverOf(u, \"\");\n    if (cov) out.cover = cov;\n    return out;\n}\n\nasync function getSignKey() {\n    if (signKey && (Date.now() - signKeyAt) < 3600000) return signKey;\n    const u = unwrap(await apiGet(\"/api/v2/m3u8/play/signKey\"));\n    const k = str(u.signKey);\n    if (k) { signKey = k; signKeyAt = Date.now(); }\n    return k;\n}\n\nasync function resolveMaster(url, streamHeaders) {\n    try {\n        const resp = await host.http.get(url, {headers: streamHeaders, timeout: TIMEOUT});\n        if (resp.status !== 200 && resp.status !== 206) return url;\n        const text = resp.body || \"\";\n        if (text.indexOf(\"#EXT-X-STREAM-INF\") < 0) return url;\n        const lines = text.split(/\\r?\\n/).map(s => s.trim());\n        for (const line of lines) {\n            if (line && line.charAt(0) !== \"#\") return host.url.resolve(url, line);\n        }\n        return url;\n    } catch (error) {\n        host.log(\"hgdjv resolveMaster failed\", url, String(error && error.message));\n        return url;\n    }\n}\n\nasync function play(arg) {\n    await ensureSession();\n    const vid = str((arg && arg.episodeId) || (arg && arg.id));\n    if (!vid) throw host.error(\"E_PARSE\", \"missing episode id\");\n    let videoUrl = \"\";\n    let authKey = \"\";\n    const can = unwrap(await apiGet(\"/api/video/can/watch?videoId=\" + encodeURIComponent(vid)));\n    videoUrl = str(can.videoUrl);\n    authKey = str(can.authKey);\n    if (!videoUrl && detailCache[vid]) {\n        videoUrl = str(detailCache[vid].videoUrl);\n        if (!authKey) authKey = str(detailCache[vid].authKey);\n    }\n    if (!videoUrl) {\n        const dec = unwrap(await apiGet(\"/api/m3u8/decode/by/id?videoId=\" + encodeURIComponent(vid)));\n        videoUrl = str(dec.videoUrl) || str(dec.path) || str(dec.url);\n        if (!authKey) authKey = str(dec.authKey);\n    }\n    if (!videoUrl) throw host.error(\"E_PARSE\", \"no videoUrl for episode \" + vid);\n    if (!token) throw host.error(\"E_NETWORK\", \"no guest token for play\");\n    const key = await getSignKey();\n    const timeU = unwrap(await apiGet(\"/api/v2/m3u8/play/time\"));\n    const srv = toInt(timeU.unixMilliseconds, 0);\n    const ts = srv > 0 ? Math.floor(srv / 1000) : Math.floor(Date.now() / 1000);\n    const nonce = host.crypto.randomHex(16).replace(/(.{8})(.{4})(.{4})(.{4})(.{12})/, \"$1-$2-$3-$4-$5\");\n    let sign = \"\";\n    if (key) {\n        sign = host.crypto.hmac(\"sha256\", key, videoUrl + token + ts + nonce, {keyEncoding: \"utf8\", in: \"utf8\", out: \"hex\"});\n    }\n    let url = base + \"/api/v2/m3u8/play?path=\" + encodeURIComponent(videoUrl) +\n        \"&token=\" + encodeURIComponent(token) + \"&ts=\" + ts + \"&nonce=\" + nonce + \"&sign=\" + sign;\n    if (authKey) url += \"&authKey=\" + encodeURIComponent(authKey);\n    if (url.indexOf(\"https://\") !== 0) throw host.error(\"E_PARSE\", \"stream is not https: \" + url.slice(0, 80));\n    const streamHeaders = {\"User-Agent\": PLAY_UA};\n    const resolved = await resolveMaster(url, streamHeaders);\n    return {streams: [{url: resolved, format: \"hls\", headers: streamHeaders, name: \"黄果短剧\"}]};\n}\n\nexport default {home: home, category: category, search: search, detail: detail, play: play};\n"}}